@page "/xe"
@model HieuNga.Web.Pages.Xe.IndexModel

<section class="catalog-hero bg-honda-dark text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm text-white/50 mb-5" aria-label="Breadcrumb">
            <a href="/" class="hover:text-white transition focus-ring rounded">Trang chủ</a>
            <span class="mx-2" aria-hidden="true">/</span>
            <span class="text-white font-medium">Mua xe</span>
        </nav>
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight">Danh mục xe máy</h1>
        <p class="text-gray-400 mt-3 max-w-xl text-sm md:text-base">Chọn dòng xe Honda tại showroom Xe Máy Hiếu Nga Đà Nẵng</p>
    </div>
</section>

<section class="page-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative min-h-[280px]">
        <div id="catalog-skeleton" class="htmx-indicator absolute inset-0 z-10 bg-white/90 backdrop-blur-sm rounded-2xl p-4 md:p-6">
            <partial name="_SkeletonMotorcycleGrid" />
        </div>
        <div id="catalog-browse" class="transition-opacity duration-300">
            <partial name="_CatalogBrowse" model="Model" />
        </div>
    </div>
</section>
