@model (string Name, string MainImage, IReadOnlyList<string> Gallery)
@using System.Text.Json
@{
    var images = new List<string>();
    if (!string.IsNullOrEmpty(Model.MainImage)) images.Add(Model.MainImage);
    foreach (var u in Model.Gallery)
        if (!string.IsNullOrEmpty(u) && !images.Contains(u)) images.Add(u);
    if (images.Count == 0)
        images.Add("/images/motorcycles/default.svg");
    images = images.Distinct().Take(8).ToList();
    var imagesJson = JsonSerializer.Serialize(images);
}
<div x-data="detailGallery(@Html.Raw(imagesJson))"
     class="detail-gallery select-none"
     @@keydown.arrow-right.window="next()"
     @@keydown.arrow-left.window="prev()">
    <div class="gallery-main relative aspect-[4/3] md:aspect-[5/4] rounded-xl md:rounded-2xl overflow-hidden bg-gray-100 border border-gray-100 group"
         @@touchstart="onTouchStart($event)"
         @@touchend="onTouchEnd($event)">
        <template x-for="(img, i) in images" :key="i">
            <img x-show="active === i"
                 x-transition:enter="transition ease-out duration-[450ms]"
                 x-transition:enter-start="opacity-0 scale-[1.03]"
                 x-transition:enter-end="opacity-100 scale-100"
                 :src="img" alt="@Model.Name"
                 class="img-media absolute inset-0 w-full h-full object-cover"
                 :class="active === i && 'is-active'"
                 decoding="async" />
        </template>
        <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent pointer-events-none"></div>

        <button type="button" @@click="prev()" class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 md:w-10 md:h-10 rounded-full bg-white/90 text-honda-dark hover:bg-white transition hidden sm:flex items-center justify-center shadow-sm" aria-label="Ảnh trước">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button type="button" @@click="next()" class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 md:w-10 md:h-10 rounded-full bg-white/90 text-honda-dark hover:bg-white transition hidden sm:flex items-center justify-center shadow-sm" aria-label="Ảnh sau">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>

        <div class="absolute top-3 left-3 z-10">
            <span class="px-2.5 py-1 bg-honda-red text-white text-[10px] font-bold uppercase rounded-md">HEAD</span>
        </div>
        <div class="absolute bottom-3 right-3 z-10 px-2.5 py-0.5 bg-black/40 rounded-md text-white text-[10px] font-medium">
            <span x-text="active + 1"></span> / <span x-text="images.length"></span>
        </div>
    </div>

    <div class="flex gap-2 md:gap-3 mt-3 overflow-x-auto pb-2 snap-x scrollbar-hide -mx-1 px-1">
        <template x-for="(img, i) in images" :key="'thumb-' + i">
            <button type="button" @@click="go(i)"
                    class="flex-shrink-0 w-20 h-20 md:w-28 md:h-28 rounded-xl overflow-hidden border-2 transition-all duration-200 snap-start"
                    :class="active === i ? 'border-honda-red ring-2 ring-honda-red/40 opacity-100' : 'border-transparent opacity-55 hover:opacity-90'">
                <img :src="img" alt="" class="w-full h-full object-cover" loading="lazy" />
            </button>
        </template>
    </div>
    <p class="text-xs text-gray-400 mt-2 md:hidden text-center">Vuốt ảnh để xem góc khác</p>
</div>
