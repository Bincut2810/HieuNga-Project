@page "/xe/{slug}"
@model HieuNga.Web.Pages.Xe.ChiTietModel
@using System.Text.Json
@{
    var m = Model.Motorcycle!;
    var galleryImages = m.GalleryUrls.Where(u => !string.IsNullOrEmpty(u)).Distinct().ToList();
    if (galleryImages.Count == 0 && !string.IsNullOrEmpty(m.ThumbnailUrl))
        galleryImages = [m.ThumbnailUrl];
    var mainGalleryImage = m.ThumbnailUrl ?? galleryImages.FirstOrDefault() ?? string.Empty;
    var activePrice = m.Variants.FirstOrDefault()?.Price ?? m.BasePrice;
    var defaultDown = Math.Round(activePrice * 0.2m / 500_000) * 500_000;
    var monthlyEstimate = Model.InitialFinance?.MonthlyPayment ?? (activePrice - defaultDown) / 12;
    var keySpecs = m.Specifications.Take(6).ToList();
    var topHighlights = m.Highlights.Take(3).ToList();
    var relatedBikes = Model.Related.Take(2).ToList();
    var consultUrl = $"/lien-he?intent=mua-xe&xe={Uri.EscapeDataString(m.Slug)}";
    var testRideUrl = $"/lien-he?intent=lai-thu&xe={Uri.EscapeDataString(m.Slug)}";
    var financeBoot = new
    {
        bikeName = m.Name,
        motorcycleId = m.Id,
        basePrice = m.BasePrice,
        down = (double)defaultDown,
        variants = m.Variants.Select(v => new { id = v.Id.ToString().ToLowerInvariant(), name = v.Name, price = (double)v.Price, available = v.IsAvailable }),
        banks = Model.FinanceBanks.Select(b => new
        {
            id = b.Id,
            name = b.Name,
            initials = b.Initials,
            monthlyRate = (double)b.MonthlyRate,
            ratePercent = (double)b.RatePercent,
            rateLabel = b.RateLabel,
            trust = b.Trust,
            color = b.Color
        })
    };
    var financeBootJson = JsonSerializer.Serialize(financeBoot);
}

<div class="detail-page bg-white" x-data>
    <script type="application/json" id="motorcycle-finance-config">@Html.Raw(financeBootJson)</script>
    <script>
        (function () {
            var el = document.getElementById('motorcycle-finance-config');
            if (!el || !window.bootMotorcycleFinance) return;
            try { window.bootMotorcycleFinance(JSON.parse(el.textContent)); } catch (e) { console.warn('Finance init:', e); }
        })();
    </script>

    @* ─── 1. Top purchase section ─── *@
    <section class="border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 md:py-8">
            <nav class="text-sm text-gray-400 mb-5">
                <a href="/" class="hover:text-honda-red transition">Trang chủ</a>
                <span class="mx-2">/</span>
                <a href="/xe" class="hover:text-honda-red transition">Mua xe</a>
                <span class="mx-2">/</span>
                <span class="text-honda-dark font-medium">@m.Name</span>
            </nav>

            <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-start">
                <div class="lg:col-span-7">
                    <partial name="Xe/Shared/_DetailGallery" model="(m.Name, mainGalleryImage, (IReadOnlyList<string>)galleryImages)" />
                </div>

                <div class="lg:col-span-5 space-y-5">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                            @m.Category · Còn hàng showroom
                        </p>
                        <h1 class="text-2xl sm:text-3xl font-bold text-honda-dark mt-2 leading-tight tracking-tight">@m.Name</h1>
                        @if (!string.IsNullOrEmpty(m.ShortDescription))
                        {
                            <p class="text-gray-600 mt-3 text-sm sm:text-base leading-relaxed">@m.ShortDescription</p>
                        }
                    </div>

                    <div class="rounded-xl border border-gray-100 bg-white p-5">
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Giá niêm yết</p>
                        <p class="text-2xl sm:text-3xl font-bold text-honda-red mt-1 tabular-nums"
                           x-text="$store.motorcycleDetail ? $store.motorcycleDetail.formatVnd($store.motorcycleDetail.price) : '@activePrice.ToVnd()'"></p>
                        <p class="text-xs text-gray-500 mt-1" x-show="$store.motorcycleDetail?.variantName" x-text="$store.motorcycleDetail?.variantName"></p>
                        <p class="text-sm text-gray-600 mt-2">
                            Trả góp từ ~
                            <span class="font-semibold text-honda-red tabular-nums"
                                  x-text="$store.motorcycleDetail ? new Intl.NumberFormat('vi-VN').format($store.motorcycleDetail.monthly) : '@((long)monthlyEstimate)'"></span> ₫/tháng
                        </p>
                    </div>

                    @if (keySpecs.Any())
                    {
                        <div class="grid grid-cols-2 gap-2 sm:gap-3">
                            @foreach (var spec in keySpecs)
                            {
                                <div class="rounded-lg border border-gray-100 bg-gray-50 px-3 py-2.5">
                                    <p class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 leading-snug">@spec.Label</p>
                                    <p class="text-sm font-semibold text-honda-dark mt-0.5">@spec.Value</p>
                                </div>
                            }
                        </div>
                    }

                    <div class="flex flex-col sm:flex-row flex-wrap gap-2.5 pt-1">
                        <a href="@consultUrl" class="btn-primary flex-1 min-w-[140px] py-3.5 text-center justify-center text-sm sm:text-base">Tư vấn mua xe</a>
                        <a href="@testRideUrl" class="btn-secondary flex-1 min-w-[140px] py-3.5 text-center justify-center text-sm sm:text-base">Đặt lịch lái thử</a>
                        <a href="#financing" class="inline-flex items-center justify-center px-4 py-3 text-sm font-semibold text-honda-dark border border-gray-200 rounded-lg hover:border-honda-red hover:text-honda-red transition sm:w-full lg:w-auto">
                            Tính trả góp
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ─── 2. Installment calculator ─── *@
    <partial name="Shared/_DetailFinanceCalculator" model="@((Motorcycle: m, MotorcycleId: m.Id, DefaultDown: defaultDown))" />

    @* ─── 3. Vehicle information (merged) ─── *@
    <section class="py-10 md:py-14 bg-gray-50 border-y border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
            <div>
                <h2 class="text-xl md:text-2xl font-bold text-honda-dark tracking-tight">Tổng quan</h2>
                @if (!string.IsNullOrEmpty(m.ShortDescription))
                {
                    <p class="mt-3 text-gray-600 leading-relaxed max-w-3xl">@m.ShortDescription</p>
                }
                @if (topHighlights.Any())
                {
                    <ul class="mt-4 space-y-2 max-w-3xl">
                        @foreach (var highlight in topHighlights)
                        {
                            <li class="flex gap-2 text-sm text-gray-700">
                                <span class="text-honda-red font-bold shrink-0">✓</span>
                                <span>@highlight</span>
                            </li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(m.Description))
                {
                    <div class="prose prose-sm md:prose-base prose-gray max-w-3xl mt-6 prose-headings:text-honda-dark prose-a:text-honda-red">
                        @Html.Raw(m.Description)
                    </div>
                }
            </div>

            @if (m.Specifications.Any())
            {
                <div>
                    <h2 class="text-xl md:text-2xl font-bold text-honda-dark tracking-tight">Thông số chính</h2>
                    <div class="mt-4 rounded-xl border border-gray-100 bg-white overflow-hidden">
                        <dl class="divide-y divide-gray-100">
                            @foreach (var spec in m.Specifications.Take(8))
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-1 sm:gap-4 px-4 py-3 sm:py-3.5">
                                    <dt class="text-sm text-gray-500">@spec.Label</dt>
                                    <dd class="text-sm font-semibold text-honda-dark sm:text-right">@spec.Value</dd>
                                </div>
                            }
                        </dl>
                    </div>
                </div>
            }

            @if (m.Variants.Any() || m.Colors.Any())
            {
                <div>
                    <h2 class="text-xl md:text-2xl font-bold text-honda-dark tracking-tight">Phiên bản &amp; màu sắc</h2>
                    <div class="mt-4 space-y-5">
                        @if (m.Variants.Any())
                        {
                            <div class="grid sm:grid-cols-2 gap-3">
                                @foreach (var v in m.Variants)
                                {
                                    <button type="button"
                                            @@click="$store.motorcycleDetail && $store.motorcycleDetail.selectVariant('@v.Id.ToString().ToLowerInvariant()')"
                                            class="flex justify-between items-center gap-3 px-4 py-3 rounded-xl border text-left w-full transition"
                                            :class="$store.motorcycleDetail && $store.motorcycleDetail.isVariantSelected('@v.Id.ToString().ToLowerInvariant()') ? 'border-honda-red bg-red-50/50' : 'border-gray-100 bg-white hover:border-gray-300'">
                                        <div>
                                            <p class="font-semibold text-sm">@v.Name</p>
                                            <p class="text-xs mt-0.5 @(v.IsAvailable ? "text-green-600" : "text-gray-400")">
                                                @(v.IsAvailable ? $"Còn {v.StockQuantity} xe" : "Liên hệ")
                                            </p>
                                        </div>
                                        <p class="font-bold text-honda-red text-sm tabular-nums shrink-0">@v.Price.ToVnd()</p>
                                    </button>
                                }
                            </div>
                        }
                        @if (m.Colors.Any())
                        {
                            <div x-data="{ selected: '@m.Colors.First().Id' }">
                                <p class="text-sm font-medium text-gray-600 mb-2">Màu sắc</p>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var color in m.Colors)
                                    {
                                        <button type="button" @@click="selected = '@color.Id'"
                                                class="flex items-center gap-2 px-3 py-2 rounded-lg border text-sm transition"
                                                :class="selected === '@color.Id' ? 'border-honda-red bg-red-50/40' : 'border-gray-100 bg-white hover:border-gray-300'">
                                            <span class="w-5 h-5 rounded-full border border-gray-200" style="background:@color.HexCode"></span>
                                            <span class="font-medium">@color.Name</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div>
                <h2 class="text-xl md:text-2xl font-bold text-honda-dark tracking-tight">Hỗ trợ tại Xe Máy Hiếu Nga</h2>
                <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
                    @{
                        var supportItems = new[]
                        {
                            ("Tư vấn rõ ràng", "Báo giá minh bạch, hỗ trợ chọn xe phù hợp."),
                            ("Hỗ trợ trả góp", "Thủ tục tại showroom, nhiều ngân hàng liên kết."),
                            ("Bảo hành HEAD", "Xe và dịch vụ theo tiêu chuẩn Honda Việt Nam."),
                            ("Phụ tùng chính hãng", "Linh kiện Honda 100% khi bảo dưỡng tại xưởng.")
                        };
                    }
                    @foreach (var (title, desc) in supportItems)
                    {
                        <div class="rounded-xl border border-gray-100 bg-white p-4">
                            <h3 class="font-bold text-sm text-honda-dark">@title</h3>
                            <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">@desc</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    @* ─── 4. Related motorcycles ─── *@
    @if (relatedBikes.Any())
    {
        <section class="py-10 md:py-14 border-b border-gray-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
                    <h2 class="text-xl md:text-2xl font-bold text-honda-dark tracking-tight">Xe tương tự</h2>
                    <a href="/xe" class="text-sm font-semibold text-honda-red hover:underline">Xem thêm xe khác →</a>
                </div>
                <div class="grid sm:grid-cols-2 gap-5 md:gap-6 max-w-4xl">
                    @foreach (var bike in relatedBikes)
                    {
                        <partial name="_MotorcycleCard" model="bike" />
                    }
                </div>
            </div>
        </section>
    }

    @* ─── 5. Bottom conversion CTA ─── *@
    <section class="py-10 md:py-14">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="rounded-2xl border border-gray-100 bg-white p-6 md:p-8 text-center md:text-left">
                <h2 class="text-lg md:text-xl font-bold text-honda-dark">Cần tư vấn mẫu xe này?</h2>
                <p class="mt-2 text-sm text-gray-500">Đội ngũ Xe Máy Hiếu Nga sẵn sàng hỗ trợ mua xe và trả góp tại Đà Nẵng.</p>
                <div class="mt-5 flex flex-col sm:flex-row flex-wrap gap-3 justify-center md:justify-start">
                    <a href="tel:0905123456" class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold border border-gray-200 rounded-lg hover:border-honda-red hover:text-honda-red transition">
                        Gọi ngay
                    </a>
                    <a href="@consultUrl" class="btn-primary justify-center text-sm">Tư vấn mua xe</a>
                    <a href="@testRideUrl" class="btn-secondary justify-center text-sm">Đặt lịch lái thử</a>
                </div>
            </div>
        </div>
    </section>
</div>

@* Mobile sticky bar (detail-only; global _MobileCta hidden via PageModel) *@
<div class="detail-sticky-bar fixed bottom-0 inset-x-0 z-[60] lg:hidden bg-white/95 backdrop-blur-md border-t border-gray-200">
    <div class="grid grid-cols-3 divide-x divide-gray-100 px-1">
        <a href="tel:0905123456" class="touch-press flex flex-col items-center justify-center py-3 text-[10px] font-medium text-honda-charcoal hover:bg-gray-50">
            <svg class="w-5 h-5 mb-0.5 text-honda-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Gọi
        </a>
        <a href="@consultUrl" class="touch-press flex flex-col items-center justify-center py-3 text-[10px] font-semibold text-honda-charcoal hover:bg-gray-50">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            Tư vấn
        </a>
        <a href="#financing" class="touch-press flex flex-col items-center justify-center py-3 text-[10px] font-semibold text-honda-charcoal border-l border-gray-100 hover:bg-gray-50">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            Tính góp
        </a>
    </div>
</div>

<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "Product",
    "name": "@m.Name",
    "brand": { "@@type": "Brand", "name": "Honda" },
    "offers": {
        "@@type": "Offer",
        "price": "@m.BasePrice",
        "priceCurrency": "VND",
        "availability": "https://schema.org/InStock"
    }
}
</script>
