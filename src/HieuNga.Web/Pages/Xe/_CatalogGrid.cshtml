@model PagedResultDto<MotorcycleListItemDto>

@if (!Model.Items.Any())
{
    <p class="text-center text-gray-500 py-16">Không tìm thấy xe phù hợp.</p>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 htmx-settling">
        @foreach (var bike in Model.Items)
        {
            <partial name="_MotorcycleCard" model="bike" />
        }
    </div>
    @if (Model.Total > Model.PageSize)
    {
        <p class="text-center text-sm text-gray-400 mt-8">Hiển thị @Model.Items.Count / @Model.Total xe</p>
    }
}
