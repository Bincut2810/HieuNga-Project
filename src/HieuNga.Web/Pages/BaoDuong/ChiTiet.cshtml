@page "/bao-duong/{slug}"
@model HieuNga.Web.Pages.BaoDuong.ChiTietModel
@{
    var s = Model.Service!;
    var bookUrl = $"/bao-duong?service={s.Slug}#booking";
}

<section class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
        <nav class="text-sm text-gray-500 mb-6">
            <a href="/bao-duong" class="hover:text-honda-red transition">Dịch vụ</a>
            <span class="mx-2">/</span>
            <span class="text-honda-dark font-medium">@s.Name</span>
        </nav>

        <div class="flex flex-col sm:flex-row sm:items-start gap-5">
            <partial name="BaoDuong/Shared/_ServiceIcon" model="s.IconKey" />
            <div class="flex-1 min-w-0">
                <span class="inline-flex px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide rounded-md bg-white border border-gray-200 text-gray-600">
                    @s.Category
                </span>
                <h1 class="mt-3 text-2xl md:text-3xl font-bold text-honda-dark">@s.Name</h1>
                <p class="mt-3 text-gray-600 leading-relaxed">@s.ShortDescription</p>

                @if (!string.IsNullOrWhiteSpace(s.EstimatedDuration))
                {
                    <p class="mt-5 text-sm text-gray-600">
                        <span class="text-gray-500">Thời gian dự kiến:</span>
                        <span class="font-medium text-honda-dark ml-1">@s.EstimatedDuration</span>
                    </p>
                }

                <p class="mt-3 text-sm font-medium text-gray-700">Liên hệ để được tư vấn</p>

                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="@bookUrl" class="btn-primary">Đặt lịch dịch vụ này</a>
                    <a href="tel:0905123456" hx-boost="false" class="btn-secondary">Gọi ngay</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <h2 class="text-xl font-bold text-honda-dark">Dịch vụ này bao gồm gì?</h2>
    <ul class="mt-5 space-y-3">
        @foreach (var item in s.Includes)
        {
            <li class="flex gap-3 text-gray-700">
                <span class="flex items-center justify-center w-5 h-5 rounded-full bg-red-50 text-honda-red text-xs font-bold shrink-0 mt-0.5">✓</span>
                <span>@item</span>
            </li>
        }
    </ul>
</section>

<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-honda-dark">Báo giá sau khi kiểm tra</h2>
        <ul class="mt-5 grid sm:grid-cols-2 gap-3">
            @foreach (var item in new[] { "Kiểm tra tình trạng xe.", "Tư vấn hạng mục cần làm.", "Báo giá rõ ràng trước khi thực hiện.", "Chỉ sửa/thay khi khách hàng đồng ý." })
            {
                <li class="flex gap-3 text-sm text-gray-700">
                    <span class="text-honda-red font-bold shrink-0">✓</span>
                    <span>@item</span>
                </li>
            }
        </ul>
        <p class="mt-6 text-sm text-gray-500 border-l-4 border-honda-red pl-4 leading-relaxed">
            @Model.PricingDisclaimer
        </p>
    </div>
</section>

@if (Model.RelatedServices.Count > 0)
{
    <section class="bg-gray-50 border-t border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <h2 class="text-lg font-bold text-honda-dark">Dịch vụ liên quan</h2>
            <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var related in Model.RelatedServices)
                {
                    <a href="/bao-duong/@related.Slug" class="service-card-compact group flex items-center gap-4 bg-white border border-gray-200 rounded-xl p-4 hover:border-honda-red/30 transition-colors">
                        <partial name="BaoDuong/Shared/_ServiceIcon" model="related.IconKey" />
                        <div class="min-w-0">
                            <p class="font-semibold text-honda-dark group-hover:text-honda-red transition-colors line-clamp-2">@related.Name</p>
                            <p class="text-sm text-gray-600 mt-1">Liên hệ để được tư vấn</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}
else
{
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 text-center">
        <a href="/bao-duong" class="inline-flex items-center gap-2 text-sm font-semibold text-honda-red hover:underline">
            Xem tất cả dịch vụ →
        </a>
    </section>
}
