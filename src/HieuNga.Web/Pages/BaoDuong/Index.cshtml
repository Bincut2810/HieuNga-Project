@page "/bao-duong"
@model HieuNga.Web.Pages.BaoDuong.IndexModel
@using HieuNga.Web.Filters
@{
    var site = SiteSettingsViewData.Get(ViewData);
    var telHref = SiteSettingsViewData.TelHref(site);
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<section class="book-page">
    <div class="book-shell">
        @if (Model.Success)
        {
            <div class="book-success" role="status">
                <h1 class="book-success-title">Đã nhận lịch hẹn</h1>
                <p class="book-success-text">Xe Máy Hiếu Nga sẽ gọi xác nhận trong giờ hành chính.</p>
                <div class="book-success-actions">
                    <a href="@telHref" hx-boost="false" class="btn-primary touch-press">Gọi @site.Hotline</a>
                    <a href="/dich-vu" class="btn-secondary touch-press">Xem dịch vụ</a>
                </div>
            </div>
        }
        else
        {
            <header class="book-header">
                <p class="section-eyebrow">Đặt lịch</p>
                <h1 class="book-title">Đặt lịch bảo dưỡng</h1>
                <p class="book-sub">Chỉ mất khoảng 30 giây — chúng tôi sẽ gọi lại xác nhận.</p>
            </header>

            <form id="booking" method="post" class="book-form scroll-mt-24">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="book-error"></div>

                <div class="book-field">
                    <label asp-for="CustomerName">Họ tên *</label>
                    <input asp-for="CustomerName" class="book-input" autocomplete="name" required />
                    <span asp-validation-for="CustomerName" class="book-field-error"></span>
                </div>

                <div class="book-field">
                    <label asp-for="Phone">Số điện thoại *</label>
                    <input asp-for="Phone" class="book-input" autocomplete="tel" inputmode="tel" required />
                    <span asp-validation-for="Phone" class="book-field-error"></span>
                </div>

                <div class="book-field">
                    <label asp-for="MotorcycleModel">Dòng xe *</label>
                    <input asp-for="MotorcycleModel" class="book-input" placeholder="VD: Vision, Wave, SH" required />
                    <span asp-validation-for="MotorcycleModel" class="book-field-error"></span>
                </div>

                <div class="book-field">
                    <label asp-for="ServiceType">Dịch vụ *</label>
                    <select asp-for="ServiceType" class="book-input" required>
                        @foreach (var option in Model.BookingServiceOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <span asp-validation-for="ServiceType" class="book-field-error"></span>
                </div>

                <div class="book-row">
                    <div class="book-field">
                        <label asp-for="PreferredDate">Ngày *</label>
                        <input asp-for="PreferredDate" type="date" class="book-input" min="@minDate" required />
                        <span asp-validation-for="PreferredDate" class="book-field-error"></span>
                    </div>
                    <div class="book-field">
                        <label asp-for="PreferredTime">Giờ *</label>
                        <select asp-for="PreferredTime" class="book-input" required>
                            @foreach (var slot in Model.TimeSlots)
                            {
                                <option value="@slot">@slot</option>
                            }
                        </select>
                        <span asp-validation-for="PreferredTime" class="book-field-error"></span>
                    </div>
                </div>

                <div class="book-field">
                    <label asp-for="Notes">Ghi chú (tuỳ chọn)</label>
                    <input asp-for="Notes" class="book-input" maxlength="500" placeholder="Ví dụ: xe rung khi tăng tốc" />
                </div>

                <button type="submit" class="btn-primary book-submit touch-press">Gửi lịch hẹn</button>
                <p class="book-footnote">
                    Hoặc gọi ngay <a href="@telHref" hx-boost="false">@site.Hotline</a>
                </p>
            </form>
        }
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
