@page "/bao-duong"
@model HieuNga.Web.Pages.BaoDuong.IndexModel

<partial name="_PageHero" model='("Bảo dưỡng chính hãng", "Kỹ thuật HEAD — Phụ tùng Honda, quy trình chuẩn", "Service")' />

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-3 gap-6 mb-16">
        @{
            var services = new[] {
                ("🔧", "Bảo dưỡng định kỳ", "Thay nhớt, kiểm tra tổng thể theo km"),
                ("⚙️", "Sửa chữa chung", "Động cơ, phanh, điện — linh kiện chính hãng"),
                ("✨", "Làm đẹp xe", "Rửa xe, đánh bóng, bảo dưỡng ngoại thất")
            };
        }
        @foreach (var (icon, title, desc) in services)
        {
            <div class="bg-white border rounded-2xl p-8 hover:shadow-lg hover:border-honda-red/30 transition">
                <span class="text-3xl">@icon</span>
                <h3 class="font-bold mt-4">@title</h3>
                <p class="text-sm text-gray-500 mt-2">@desc</p>
            </div>
        }
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div class="bg-honda-dark text-white rounded-3xl p-10">
            <h2 class="text-2xl font-bold">Tại sao chọn HEAD?</h2>
            <ul class="mt-6 space-y-4 text-gray-300 text-sm">
                <li class="flex gap-3"><span class="text-honda-red">✓</span> Kỹ thuật viên đào tạo bài bản Honda Việt Nam</li>
                <li class="flex gap-3"><span class="text-honda-red">✓</span> Phụ tùng, nhớt chính hãng 100%</li>
                <li class="flex gap-3"><span class="text-honda-red">✓</span> Minh bạch báo giá trước khi sửa</li>
                <li class="flex gap-3"><span class="text-honda-red">✓</span> Không gian chờ cao cấp, wifi miễn phí</li>
            </ul>
            <a href="tel:0905123456" class="btn-primary mt-8 inline-flex">Gọi xưởng dịch vụ</a>
        </div>

        <div>
            @if (Model.Success)
            {
                <div class="bg-green-50 border border-green-200 rounded-2xl p-8">
                    <p class="font-bold text-green-800 text-lg">Đặt lịch bảo dưỡng thành công!</p>
                    <p class="text-green-600 text-sm mt-2">Xưởng dịch vụ sẽ xác nhận lịch hẹn qua điện thoại.</p>
                </div>
            }
            else
            {
                <form method="post" class="bg-white border rounded-2xl p-8 space-y-5 shadow-sm">
                    <h2 class="text-xl font-bold">Đặt lịch hẹn</h2>
                    <div asp-validation-summary="All" class="text-red-600 text-sm"></div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Họ tên *</label>
                        <input asp-for="CustomerName" class="w-full px-4 py-3 border rounded-lg" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Số điện thoại *</label>
                        <input asp-for="Phone" class="w-full px-4 py-3 border rounded-lg" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Dòng xe</label>
                        <input asp-for="MotorcycleModel" placeholder="VD: Vision 2025" class="w-full px-4 py-3 border rounded-lg" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Biển số</label>
                        <input asp-for="LicensePlate" class="w-full px-4 py-3 border rounded-lg" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Loại dịch vụ</label>
                        <select asp-for="ServiceType" class="w-full px-4 py-3 border rounded-lg">
                            <option>Bảo dưỡng định kỳ</option>
                            <option>Sửa chữa chung</option>
                            <option>Làm đẹp xe</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Ngày hẹn *</label>
                        <input asp-for="PreferredDate" type="date" class="w-full px-4 py-3 border rounded-lg" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Ghi chú</label>
                        <textarea asp-for="Notes" rows="2" class="w-full px-4 py-3 border rounded-lg"></textarea>
                    </div>
                    <button type="submit" class="btn-primary w-full">Đặt lịch</button>
                </form>
            }
        </div>
    </div>
</section>
