@page "/lien-he"
@model HieuNga.Web.Pages.LienHe.IndexModel
@using HieuNga.Web.ViewModels.TestRide
@{
    ViewData["CtaIntent"] = Model.Intent;
    ViewData["CtaXe"] = Model.SelectedMotorcycle?.Slug;
    ViewData["CtaXeId"] = Model.SelectedMotorcycle?.Id.ToString();
    ViewData["CtaService"] = Model.ServiceSlug;
    ViewData["CtaSource"] = Model.LeadSource;
    ViewData["CtaShow"] = "call,zalo,testride,messenger";
    ViewData["CtaLayout"] = "row";
    ViewData["VehicleChangeUrl"] = $"/xe?from=lien-he&intent={Uri.EscapeDataString(Model.Intent)}";
    ViewData["BranchBookUrl"] = Model.Intent == "bao-duong"
        ? "/bao-duong#booking"
        : (Model.SelectedMotorcycle is null
            ? "/dat-lich-lai-thu?source=ContactPage"
            : $"/dat-lich-lai-thu?xeId={Model.SelectedMotorcycle.Id}&source=ContactPage");
    ViewData["BranchBookLabel"] = Model.Intent == "bao-duong" ? "Đặt lịch dịch vụ" : "Đặt lịch xem xe";
}

@section Head {
    <link rel="stylesheet" href="~/css/test-ride.css" asp-append-version="true" />
}
<link rel="stylesheet" href="~/css/test-ride.css" asp-append-version="true" data-tr-css />

<section class="lead-page">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 md:pt-10 pb-4">
        <nav class="text-sm text-gray-400 mb-4" aria-label="Breadcrumb">
            <a href="/" class="hover:text-honda-red transition focus-ring rounded">Trang chủ</a>
            <span class="mx-2" aria-hidden="true">/</span>
            <span class="text-honda-dark font-medium">Liên hệ</span>
        </nav>
        <p class="section-eyebrow">Chăm sóc khách hàng</p>
        <h1 class="section-title">@Model.PageHeading</h1>
        <p class="section-subtitle max-w-2xl">@Model.PageSubheading</p>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
        <partial name="_UniversalCta" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14 md:pb-16">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-10">
            @* Mobile: form first. Desktop (lg+): form right via order-2, showroom left via order-1. *@
            <div class="lg:col-span-7 lg:order-2">
                @if (Model.Intent == "bao-duong")
                {
                    <div class="lead-form-card mb-4">
                        <h2 class="text-xl font-bold text-honda-dark">Đặt lịch bảo dưỡng</h2>
                        <p class="text-sm text-gray-500 mt-1">Dịch vụ bảo dưỡng dùng form chuyên dụng.</p>
                        <a href="/bao-duong#booking" class="btn-primary touch-press mt-4 inline-flex">Đặt lịch bảo dưỡng</a>
                    </div>
                }

                <div class="lead-form-card tr-embed" data-tr-page>
                    <h2 class="text-xl font-bold text-honda-dark">Đặt lịch xem xe</h2>
                    <p class="text-sm text-gray-500 mt-1">Chỉ mất khoảng 30 giây — cùng hệ thống đặt lịch Hiếu Nga.</p>
                    <div class="mt-6">
                        <partial name="_TestRideBookingForm" model="Model.BookingForm" />
                    </div>
                </div>
            </div>

            <div class="lg:col-span-5 lg:order-1 space-y-6">
                @if (Model.SelectedMotorcycle is not null)
                {
                    <partial name="_LeadVehicleCard" model="Model.SelectedMotorcycle" />
                }

                <partial name="_LeadTrust" />

                <partial name="_BranchCards" model="Model.Branches" />
            </div>
        </div>
    </div>
</section>

<partial name="_TestRideBookingModals" />

@section Scripts {
    <script src="~/js/test-ride.js" asp-append-version="true"></script>
}
