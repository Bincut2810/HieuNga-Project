@page "/lien-he"
@model HieuNga.Web.Pages.LienHe.IndexModel

<partial name="_PageHero" model='("Liên hệ", "Showroom HEAD — Tư vấn tận tâm, phản hồi nhanh", "Contact")' />

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid lg:grid-cols-3 gap-6 mb-16">
        <a href="tel:0905123456" class="bg-white border rounded-2xl p-8 hover:shadow-lg hover:border-honda-red transition text-center group">
            <div class="w-14 h-14 mx-auto bg-red-50 rounded-xl flex items-center justify-center text-honda-red text-2xl group-hover:scale-110 transition">📞</div>
            <h3 class="font-bold mt-4">Hotline</h3>
            <p class="text-honda-red text-xl font-bold mt-2">0905 123 456</p>
            <p class="text-xs text-gray-400 mt-2">Hỗ trợ 8:00 — 18:00</p>
        </a>
        <a href="https://zalo.me/0905123456" target="_blank" rel="noopener" class="bg-white border rounded-2xl p-8 hover:shadow-lg hover:border-honda-red transition text-center group">
            <div class="w-14 h-14 mx-auto bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 text-2xl font-bold group-hover:scale-110 transition">Zalo</div>
            <h3 class="font-bold mt-4">Chat Zalo</h3>
            <p class="text-gray-600 mt-2 text-sm">Nhắn tin nhanh — tư vấn trả góp</p>
        </a>
        <a href="/dat-lich-lai-thu" class="bg-honda-dark text-white rounded-2xl p-8 hover:shadow-lg transition text-center group">
            <div class="w-14 h-14 mx-auto bg-white/10 rounded-xl flex items-center justify-center text-2xl group-hover:scale-110 transition">🏍</div>
            <h3 class="font-bold mt-4">Đặt lái thử</h3>
            <p class="text-gray-400 mt-2 text-sm">Miễn phí tại showroom</p>
        </a>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
        <div class="space-y-8">
            @foreach (var branch in Model.Branches)
            {
                <div class="bg-white border rounded-2xl p-8">
                    @if (branch.IsHeadOffice) { <span class="text-xs font-bold text-honda-red">HEAD OFFICE</span> }
                    <h3 class="text-xl font-bold mt-1">@branch.Name</h3>
                    <p class="text-gray-600 mt-2">@branch.Address</p>
                    @if (!string.IsNullOrEmpty(branch.OpeningHours))
                    {
                        <p class="text-sm text-gray-500 mt-3">🕐 @branch.OpeningHours</p>
                    }
                    <div class="flex flex-wrap gap-4 mt-4">
                        @if (!string.IsNullOrEmpty(branch.Hotline))
                        {
                            <a href="tel:@branch.Hotline" class="text-honda-red font-semibold">@branch.Hotline</a>
                        }
                        @if (!string.IsNullOrEmpty(branch.Email))
                        {
                            <a href="mailto:@branch.Email" class="text-sm text-gray-500 hover:text-honda-red">@branch.Email</a>
                        }
                    </div>
                </div>
            }

            <div class="rounded-2xl overflow-hidden border aspect-video bg-gray-100">
                <iframe title="Bản đồ showroom"
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3835.5897499999997!2d108.2208!3d16.0544!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTbCsDAzJzE1LjgiTiAxMDjCsDEzJzE0LjkiRQ!5e0!3m2!1svi!2s!4v1"
                        class="w-full h-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>

        <div>
            @if (Model.Success)
            {
                <div class="bg-green-50 border border-green-200 rounded-2xl p-8">
                    <p class="text-green-800 font-bold text-lg">Đã gửi yêu cầu tư vấn!</p>
                    <p class="text-green-600 text-sm mt-2">Chúng tôi sẽ liên hệ trong vòng 30 phút (giờ hành chính).</p>
                </div>
            }
            else
            {
                <div class="bg-white border rounded-2xl p-8 shadow-sm">
                    <h2 class="text-2xl font-bold">Gửi yêu cầu tư vấn</h2>
                    <p class="text-gray-500 text-sm mt-2">Để lại thông tin — tư vấn viên HEAD sẽ gọi lại</p>
                    <form method="post" class="mt-8 space-y-5">
                        <div asp-validation-summary="All" class="text-red-600 text-sm"></div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Họ tên *</label>
                            <input asp-for="CustomerName" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-honda-red outline-none" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Số điện thoại *</label>
                            <input asp-for="Phone" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-honda-red outline-none" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Email</label>
                            <input asp-for="Email" type="email" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-honda-red outline-none" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Chủ đề</label>
                            <input asp-for="Subject" placeholder="VD: Tư vấn trả góp SH 160i" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-honda-red outline-none" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Nội dung</label>
                            <textarea asp-for="Message" rows="4" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-honda-red outline-none"></textarea>
                        </div>
                        <button type="submit" class="btn-primary w-full">Gửi yêu cầu</button>
                    </form>
                </div>
            }
        </div>
    </div>
</section>
