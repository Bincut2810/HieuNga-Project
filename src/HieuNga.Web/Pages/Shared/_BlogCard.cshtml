@model BlogPostListItemDto
<a href="/tin-tuc/@Model.Slug" class="card-premium group block reveal">
    <div class="img-wrap aspect-[16/10] overflow-hidden bg-gray-100">
        <img src="@(Model.ThumbnailUrl ?? "https://images.unsplash.com/photo-1558980664-769d9df238f8?w=800&q=80")" alt="@Model.Title"
             class="img-media w-full h-full object-cover transition-transform duration-[650ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]"
             loading="lazy" decoding="async" width="640" height="400" />
    </div>
    <div class="p-6">
        @if (Model.PublishedAt.HasValue)
        {
            <time class="text-xs text-gray-400">@Model.PublishedAt.Value.ToString("dd/MM/yyyy")</time>
        }
        <h3 class="text-lg font-bold mt-2 group-hover:text-honda-red transition-colors duration-300 line-clamp-2">@Model.Title</h3>
        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <p class="text-sm text-gray-500 mt-2 line-clamp-2">@Model.Summary</p>
        }
        <span class="inline-block mt-4 text-sm font-semibold group-hover:text-honda-red transition-colors">Đọc tiếp →</span>
    </div>
</a>
