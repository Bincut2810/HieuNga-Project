@model HieuNga.Web.ViewModels.MotorcycleDetailMediaViewModel

<div class="detail-lightbox"
     data-media-lightbox
     hidden
     role="dialog"
     aria-modal="true"
     aria-label="Thư viện ảnh @Model.Name">
    <div class="detail-lightbox-backdrop" data-media-lightbox-close aria-hidden="true"></div>
    <div class="detail-lightbox-panel">
        <button type="button" class="detail-lightbox-close" data-media-lightbox-close aria-label="Đóng">×</button>
        <button type="button" class="detail-lightbox-nav detail-lightbox-prev" data-media-lightbox-prev aria-label="Ảnh trước">‹</button>
        <div class="detail-lightbox-stage">
            <img data-media-lightbox-img src="@Model.HeroImage" alt="@Model.Name"
                 class="detail-lightbox-img" decoding="async" />
        </div>
        <button type="button" class="detail-lightbox-nav detail-lightbox-next" data-media-lightbox-next aria-label="Ảnh sau">›</button>
        <p class="detail-lightbox-counter tabular-nums" data-media-lightbox-counter></p>
    </div>
</div>
