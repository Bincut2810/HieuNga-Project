@using HieuNga.Application.DTOs
@model HomepageHeroDto
@{
    var hero = Model;
    var slides = hero.Slides ?? Array.Empty<HeroSlideDto>();
    if (!hero.Enabled || slides.Count == 0) { return; }
    var multi = slides.Count > 1;
    var alt = string.IsNullOrWhiteSpace(hero.Title) ? "Banner trang chủ Xe Máy Hiếu Nga" : hero.Title;
}

<section class="home-hero"
         aria-roledescription="carousel"
         aria-label="@alt"
         data-home-hero
         data-interval="5000"
         tabindex="-1">

    <div class="home-hero-track" data-hero-track>
        @{ var si = 0; }
        @foreach (var slide in slides)
        {
            var isFirst = si == 0;
            <article class="home-hero-slide @(isFirst ? "is-active" : null)"
                     data-hero-slide
                     id="home-hero-slide-@si"
                     role="group"
                     aria-roledescription="slide"
                     aria-label="Ảnh @(si + 1) / @slides.Count"
                     aria-current="@(isFirst ? "true" : null)">
                <div class="home-hero-media">
                    <img src="@slide.ImageUrl"
                         alt="@alt"
                         class="home-hero-img"
                         width="1920" height="720"
                         fetchpriority="@(isFirst ? "high" : "low")"
                         loading="@(isFirst ? "eager" : "lazy")"
                         decoding="async" />
                    <div class="home-hero-shade" aria-hidden="true"></div>
                </div>
            </article>
            si++;
        }

        @if (multi)
        {
            <div class="home-hero-arrows" aria-hidden="true">
                <button type="button" class="home-hero-nav" data-hero-prev aria-label="Ảnh trước">&#8249;</button>
                <button type="button" class="home-hero-nav" data-hero-next aria-label="Ảnh sau">&#8250;</button>
            </div>
        }
    </div>

    @if (multi)
    {
        <div class="home-hero-controls" role="tablist" aria-label="Chọn ảnh" data-hero-dots></div>
        <div class="sr-only" aria-live="polite" aria-atomic="true" data-hero-live></div>
    }
</section>
