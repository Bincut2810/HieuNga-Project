@model (MotorcycleDetailDto Motorcycle, Guid MotorcycleId, decimal DefaultDown)
@{
    var m = Model.Motorcycle;
    var consultUrl = $"/lien-he?intent=mua-xe&xe={Uri.EscapeDataString(m.Slug)}&source=detail";
    var testRideUrl = $"/dat-lich-lai-thu?xeId={Model.MotorcycleId}&source=detail";
    var financeConsultUrl = $"/lien-he?intent=tra-gop&xe={Uri.EscapeDataString(m.Slug)}&source=detail";
}

<section id="financing" class="py-10 md:py-14 bg-white scroll-mt-[5.5rem]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-6 md:mb-8">
            <h2 class="text-xl md:text-2xl font-bold text-honda-dark tracking-tight">Tính trả góp — @m.Name</h2>
            <p class="mt-2 text-sm text-gray-500">Ước tính khoản trả hàng tháng theo phiên bản, trả trước và kỳ hạn</p>
        </div>

        <template x-if="$store.motorcycleDetail">
            <div>
                <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 rounded-xl border border-gray-100 bg-gray-50 text-honda-dark">
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-gray-400">Giá đang tính</p>
                        <p class="text-xl md:text-2xl font-bold mt-0.5 tabular-nums" x-text="$store.motorcycleDetail.formatVnd($store.motorcycleDetail.price)"></p>
                        <p class="text-xs text-gray-500 mt-0.5" x-show="$store.motorcycleDetail.variantName" x-text="$store.motorcycleDetail.variantName"></p>
                    </div>
                    <div class="sm:text-right">
                        <p class="text-[10px] uppercase tracking-widest text-gray-400">Vốn vay</p>
                        <p class="text-lg font-bold mt-0.5 tabular-nums" x-text="$store.motorcycleDetail.formatVnd($store.motorcycleDetail.result.principal)"></p>
                    </div>
                </div>

                <div class="detail-finance-panel rounded-2xl border border-gray-100 overflow-hidden text-honda-dark shadow-sm">
                    <div class="grid lg:grid-cols-5 gap-0">
                        <div class="lg:col-span-3 p-5 md:p-8 space-y-6 border-b lg:border-b-0 lg:border-r border-gray-100 bg-white">
                            <template x-if="$store.motorcycleDetail.hasVariants">
                                <div>
                                    <p class="text-sm font-semibold text-honda-dark mb-2">Phiên bản xe</p>
                                    <div class="grid sm:grid-cols-2 gap-2">
                                        <template x-for="v in $store.motorcycleDetail.variants" :key="v.id">
                                            <button type="button"
                                                    @@click="$store.motorcycleDetail.selectVariant(v.id)"
                                                    class="finance-variant-card text-left p-3 rounded-xl border transition-all"
                                                    :class="$store.motorcycleDetail.isVariantSelected(v.id) ? 'border-honda-red bg-red-50/60' : 'border-gray-100 hover:border-gray-300'">
                                                <p class="font-semibold text-sm" x-text="v.name"></p>
                                                <p class="text-honda-red font-bold text-sm mt-0.5 tabular-nums" x-text="$store.motorcycleDetail.formatVnd(v.price)"></p>
                                            </button>
                                        </template>
                                    </div>
                                </div>
                            </template>

                            <div>
                                <p class="text-xs font-medium text-gray-500 mb-2">Ngân hàng (tham khảo)</p>
                                <div class="grid grid-cols-2 gap-2">
                                    <template x-for="b in $store.motorcycleDetail.banks" :key="b.id">
                                        <button type="button"
                                                @@click="$store.motorcycleDetail.selectBank(b.id)"
                                                class="finance-bank-card text-left p-2.5 rounded-lg border border-gray-100 text-xs"
                                                :class="{ 'is-selected': $store.motorcycleDetail.isBankSelected(b.id) }">
                                            <p class="font-semibold truncate" x-text="b.name"></p>
                                            <p class="text-honda-red font-medium mt-0.5" x-text="b.rateLabel"></p>
                                        </button>
                                    </template>
                                </div>
                            </div>

                            <div>
                                <div class="flex justify-between items-baseline mb-2 gap-2">
                                    <p class="text-sm font-semibold">Trả trước</p>
                                    <p class="text-sm font-bold text-honda-red tabular-nums" x-text="$store.motorcycleDetail.formatVnd($store.motorcycleDetail.down)"></p>
                                </div>
                                <div class="grid grid-cols-4 gap-2 mb-3">
                                    <template x-for="pct in [20, 30, 40, 50]" :key="pct">
                                        <button type="button"
                                                @@click="$store.motorcycleDetail.setDownPercent(pct)"
                                                class="finance-segment py-2 rounded-lg text-xs font-bold border"
                                                :class="$store.motorcycleDetail.isDownPercentSelected(pct) ? 'border-honda-red bg-honda-red text-white' : 'border-gray-200 hover:border-gray-300'"
                                                x-text="pct + '%'"></button>
                                    </template>
                                </div>
                                <input type="range" class="detail-range w-full touch-manipulation"
                                       x-model.number="$store.motorcycleDetail.down"
                                       min="0" :max="$store.motorcycleDetail.maxDown" step="500000"
                                       @@input="$store.motorcycleDetail.onDownSlider()"
                                       aria-label="Trả trước" />
                                <div class="mt-3">
                                    <label class="text-xs text-gray-500 block mb-1.5">Nhập số tiền trả trước</label>
                                    <input type="text" inputmode="numeric"
                                           class="w-full px-3 py-2.5 rounded-lg border border-gray-200 focus:border-honda-red focus:ring-2 focus:ring-honda-red/20 outline-none text-sm font-semibold tabular-nums"
                                           x-model="$store.motorcycleDetail.downInput"
                                           @@focus="$store.motorcycleDetail.onDownInputFocus()"
                                           @@blur="$store.motorcycleDetail.commitDownInput()"
                                           @@keydown.enter.prevent="$store.motorcycleDetail.commitDownInput()" />
                                </div>
                            </div>

                            <div>
                                <p class="text-sm font-semibold mb-2">Thời hạn vay</p>
                                <div class="grid grid-cols-4 gap-2">
                                    <template x-for="t in [6, 12, 24, 36]" :key="t">
                                        <button type="button"
                                                @@click="$store.motorcycleDetail.setTerm(t)"
                                                class="finance-segment py-2.5 rounded-lg text-sm font-bold border"
                                                :class="$store.motorcycleDetail.isTermSelected(t) ? 'border-honda-dark bg-honda-dark text-white' : 'border-gray-200 hover:border-gray-300'"
                                                x-text="t + 'T'"></button>
                                    </template>
                                </div>
                            </div>
                        </div>

                        <div class="lg:col-span-2 p-5 md:p-8 bg-gray-50 flex flex-col">
                            <p class="text-xs text-gray-500">
                                <span x-text="$store.motorcycleDetail.selectedBank.name"></span>
                                · <span x-text="$store.motorcycleDetail.selectedBank.rateLabel"></span>
                            </p>
                            <div class="flex-1 flex flex-col justify-center py-4">
                                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Trả hàng tháng ước tính</p>
                                <p class="finance-monthly-hero text-3xl sm:text-4xl md:text-5xl font-bold text-honda-red mt-2 tracking-tight tabular-nums"
                                   :class="{ 'is-updating': $store.motorcycleDetail.monthlyAnim }"
                                   x-text="$store.motorcycleDetail.formatVnd($store.motorcycleDetail.result.monthly)"></p>
                                <p class="text-sm text-gray-500 mt-3">
                                    <span x-text="$store.motorcycleDetail.months"></span> kỳ · Trả trước
                                    <strong x-text="$store.motorcycleDetail.formatVnd($store.motorcycleDetail.down)"></strong>
                                </p>
                                <div class="grid gap-2 mt-6 text-sm">
                                    <div class="finance-stat-pill flex justify-between items-center">
                                        <span class="label">Vốn vay</span>
                                        <span class="value tabular-nums" x-text="$store.motorcycleDetail.formatVnd($store.motorcycleDetail.result.principal)"></span>
                                    </div>
                                    <div class="finance-stat-pill flex justify-between items-center">
                                        <span class="label">Tổng thanh toán</span>
                                        <span class="value tabular-nums" x-text="$store.motorcycleDetail.formatVnd($store.motorcycleDetail.result.total)"></span>
                                    </div>
                                    <div class="finance-stat-pill flex justify-between items-center border-honda-red/15 bg-red-50/40">
                                        <span class="label">Lãi ước tính</span>
                                        <span class="value text-honda-red tabular-nums" x-text="$store.motorcycleDetail.formatVnd($store.motorcycleDetail.result.interest)"></span>
                                    </div>
                                </div>
                            </div>
                            <p class="text-[10px] text-gray-400 leading-relaxed">
                                * Kết quả tham khảo. Lãi thực tế theo hồ sơ ngân hàng tại HEAD Đà Nẵng.
                            </p>
                        </div>
                    </div>

                    <div class="p-4 md:p-5 border-t border-gray-100 bg-white grid sm:grid-cols-3 gap-2">
                        <a href="@financeConsultUrl"
                           class="touch-press flex items-center justify-center px-4 py-3 bg-honda-red text-white font-semibold rounded-lg hover:bg-red-700 transition text-sm text-center">
                            Tư vấn trả góp
                        </a>
                        <a href="@consultUrl"
                           class="touch-press flex items-center justify-center px-4 py-3 border border-gray-200 font-semibold rounded-lg hover:border-honda-red hover:text-honda-red transition text-sm text-center">
                            Liên hệ showroom
                        </a>
                        <a href="@testRideUrl"
                           class="touch-press flex items-center justify-center px-4 py-3 border border-honda-dark text-honda-dark font-semibold rounded-lg hover:bg-honda-dark hover:text-white transition text-sm text-center">
                            Đặt lái thử
                        </a>
                    </div>
                </div>
            </div>
        </template>
    </div>
</section>
