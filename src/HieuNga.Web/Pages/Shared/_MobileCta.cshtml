@if (ViewData["HideDefaultMobileCta"] as bool? == true) { return; }
@using HieuNga.Web.Filters
@{
    var site = SiteSettingsViewData.Get(ViewData);
    var telHref = SiteSettingsViewData.TelHref(site);
    var zaloUrl = SiteSettingsViewData.ZaloHref(site);
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant().TrimEnd('/');
    if (string.IsNullOrEmpty(path)) path = "/";

    // Smart primary CTA by context
    string primaryHref;
    string primaryLabel;
    string secondaryHref;
    string secondaryLabel;

    if (path.StartsWith("/xe/") && path.Length > 4)
    {
        primaryHref = "#financing";
        primaryLabel = "Trả góp";
        secondaryHref = $"/lien-he?intent=mua-xe&source=detail";
        // Prefer slug from path for intent
        var slug = path["/xe/".Length..];
        if (!string.IsNullOrWhiteSpace(slug) && !slug.Contains('/'))
            secondaryHref = $"/lien-he?intent=mua-xe&xe={Uri.EscapeDataString(slug)}&source=detail";
        secondaryLabel = "Tư vấn";
    }
    else if (path == "/xe" || path.StartsWith("/xe?"))
    {
        primaryHref = "/xe";
        primaryLabel = "Xem xe";
        secondaryHref = "/lien-he?intent=mua-xe&source=listing";
        secondaryLabel = "Tư vấn";
    }
    else if (path.StartsWith("/bao-duong") || path.StartsWith("/dich-vu"))
    {
        primaryHref = "/bao-duong#booking";
        primaryLabel = "Đặt lịch";
        secondaryHref = path.StartsWith("/dich-vu/") ? "/dich-vu" : "/lien-he?intent=bao-duong&source=service";
        secondaryLabel = path.StartsWith("/dich-vu/") ? "Tất cả" : "Tư vấn";
    }
    else if (path.StartsWith("/khuyen-mai"))
    {
        primaryHref = "/lien-he?intent=khuyen-mai&source=promotion";
        primaryLabel = "Nhận ưu đãi";
        secondaryHref = "/tra-gop?source=promotion";
        secondaryLabel = "Trả góp";
    }
    else if (path.StartsWith("/tra-gop"))
    {
        primaryHref = "#inquiry";
        primaryLabel = "Đăng ký";
        secondaryHref = "/lien-he?intent=tra-gop&source=finance";
        secondaryLabel = "Tư vấn";
    }
    else if (path.StartsWith("/tin-tuc"))
    {
        primaryHref = "/lien-he?intent=mua-xe&source=news";
        primaryLabel = "Tư vấn";
        secondaryHref = "/xe";
        secondaryLabel = "Xem xe";
    }
    else
    {
        // Homepage & default
        primaryHref = "/lien-he?intent=mua-xe&source=homepage";
        primaryLabel = "Tư vấn";
        secondaryHref = "/bao-duong#booking";
        secondaryLabel = "Dịch vụ";
    }
}
<div class="mobile-cta-bar fixed bottom-0 inset-x-0 z-40 lg:hidden bg-white/95 backdrop-blur-md border-t border-gray-200" role="navigation" aria-label="Thao tác nhanh">
    <div class="grid grid-cols-4 divide-x divide-gray-100" style="padding-bottom: env(safe-area-inset-bottom, 0);">
        <a href="@telHref" hx-boost="false" class="touch-press flex flex-col items-center justify-center py-2.5 px-1 text-[10px] font-medium text-honda-charcoal hover:bg-gray-50 transition-colors focus-ring">
            <svg class="w-5 h-5 mb-0.5 text-honda-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Gọi
        </a>
        <a href="@zaloUrl" target="_blank" rel="noopener noreferrer" hx-boost="false" class="touch-press flex flex-col items-center justify-center py-2.5 px-1 text-[10px] font-medium text-honda-charcoal hover:bg-gray-50 transition-colors focus-ring">
            <svg class="w-5 h-5 mb-0.5 text-blue-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 5.82 2 10.5c0 2.64 1.45 5.01 3.73 6.63L5 22l4.2-2.1c.9.25 1.86.38 2.8.38 5.52 0 10-3.82 10-8.5S17.52 2 12 2z"/></svg>
            Zalo
        </a>
        <a href="@secondaryHref" class="touch-press flex flex-col items-center justify-center py-2.5 px-1 text-[10px] font-medium text-honda-charcoal hover:bg-gray-50 transition-colors focus-ring">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            @secondaryLabel
        </a>
        <a href="@primaryHref" class="touch-press flex flex-col items-center justify-center py-2.5 px-1 text-[10px] font-bold text-white bg-honda-red hover:bg-red-700 transition-colors focus-ring">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            @primaryLabel
        </a>
    </div>
</div>
