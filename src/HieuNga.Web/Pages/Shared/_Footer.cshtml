@using HieuNga.Application.DTOs
@using HieuNga.Web.Filters
@{
    var site = SiteSettingsViewData.Get(ViewData);
    var branches = SiteSettingsViewData.GetBranches(ViewData);
    var telHref = SiteSettingsViewData.TelHref(site);
    var zaloUrl = string.IsNullOrWhiteSpace(site.ZaloUrl) ? null : site.ZaloUrl;
    var facebookUrl = string.IsNullOrWhiteSpace(site.FacebookUrl) ? null : site.FacebookUrl;
}
<footer class="site-footer bg-honda-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-16">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
            <div class="sm:col-span-2 lg:col-span-4">
                <p class="text-xl font-bold tracking-tight">Xe Máy Hiếu Nga</p>
                <p class="text-gray-400 text-sm leading-relaxed mt-3 max-w-sm">
                    @(site.FooterText ?? "Đại lý Honda HEAD chính hãng tại Đà Nẵng — mua xe, trả góp và dịch vụ bảo dưỡng chuyên nghiệp.")
                </p>
                <div class="mt-5 space-y-2 text-sm">
                    <p>
                        <a href="@telHref" hx-boost="false" class="font-semibold text-white hover:text-honda-red transition focus-ring rounded">@site.Hotline</a>
                    </p>
                    @if (branches.Count > 0)
                    {
                        <div class="footer-branch-list">
                            @foreach (var b in branches.Take(2))
                            {
                                var phone = SiteSettingsViewData.DisplayPhone(b);
                                <div class="footer-branch-item">
                                    <strong>@b.Name</strong>
                                    <span>@b.Address</span><br />
                                    <a href="@SiteSettingsViewData.TelHref(b)" hx-boost="false">@phone</a>
                                    @if (!string.IsNullOrWhiteSpace(b.OpeningHours))
                                    {
                                        <span> · @b.OpeningHours</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(site.Address))
                    {
                        <p class="text-gray-400">@site.Address</p>
                        @if (!string.IsNullOrWhiteSpace(site.OpeningHours))
                        {
                            <p class="text-gray-500 text-xs">@site.OpeningHours</p>
                        }
                    }
                </div>
                <div class="mt-6 flex flex-wrap gap-3" aria-label="Mạng xã hội">
                    @if (!string.IsNullOrWhiteSpace(zaloUrl))
                    {
                        <a href="@zaloUrl" target="_blank" rel="noopener noreferrer" hx-boost="false" class="home-social-link focus-ring">Zalo</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(facebookUrl))
                    {
                        <a href="@facebookUrl" target="_blank" rel="noopener noreferrer" hx-boost="false" class="home-social-link focus-ring">Facebook</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(site.Email))
                    {
                        <a href="mailto:@site.Email" hx-boost="false" class="home-social-link focus-ring">Email</a>
                    }
                </div>
            </div>

            <div class="lg:col-span-2">
                <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Xe máy</h4>
                <ul class="space-y-2.5 text-sm text-gray-400">
                    <li><a href="/xe" class="hover:text-white transition">Danh mục xe</a></li>
                    <li><a href="/xe" class="hover:text-white transition">Danh mục xe</a></li>
                    <li><a href="/xe?category=0" class="hover:text-white transition">Scooter</a></li>
                    <li><a href="/so-sanh" class="hover:text-white transition">So sánh xe</a></li>
                </ul>
            </div>

            <div class="lg:col-span-2">
                <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Dịch vụ</h4>
                <ul class="space-y-2.5 text-sm text-gray-400">
                    <li><a href="/dich-vu" class="hover:text-white transition">Bảo dưỡng</a></li>
                    <li><a href="/bao-duong#booking" class="hover:text-white transition">Đặt lịch dịch vụ</a></li>
                    <li><a href="/dat-lich-lai-thu" class="hover:text-white transition">Đặt lịch xem xe</a></li>
                    <li><a href="/lien-he" class="hover:text-white transition">Tư vấn &amp; liên hệ</a></li>
                </ul>
            </div>

            <div class="lg:col-span-2">
                <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Tài chính</h4>
                <ul class="space-y-2.5 text-sm text-gray-400">
                    <li><a href="/tra-gop" class="hover:text-white transition">Tính trả góp</a></li>
                    <li><a href="/khuyen-mai" class="hover:text-white transition">Khuyến mãi</a></li>
                    <li><a href="/tin-tuc" class="hover:text-white transition">Tin tức</a></li>
                    <li><a href="/lien-he?intent=tra-gop" class="hover:text-white transition">Tư vấn trả góp</a></li>
                </ul>
            </div>

            <div class="lg:col-span-2">
                <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Liên hệ</h4>
                <ul class="space-y-2.5 text-sm text-gray-400">
                    <li><a href="/lien-he" class="hover:text-white transition">Form liên hệ</a></li>
                    <li><a href="@telHref" hx-boost="false" class="hover:text-white transition">Gọi hotline</a></li>
                    @if (!string.IsNullOrWhiteSpace(zaloUrl))
                    {
                        <li><a href="@zaloUrl" target="_blank" rel="noopener noreferrer" hx-boost="false" class="hover:text-white transition">Chat Zalo</a></li>
                    }
                </ul>
                <form class="home-newsletter mt-5" action="#" method="post" onsubmit="return false;" aria-label="Đăng ký nhận tin (sắp có)">
                    <label for="home-newsletter-email" class="sr-only">Email nhận tin</label>
                    <div class="home-newsletter-row">
                        <input id="home-newsletter-email" type="email" name="email" autocomplete="email"
                               placeholder="Email nhận ưu đãi"
                               class="home-newsletter-input"
                               disabled
                               aria-disabled="true" />
                        <button type="button" class="home-newsletter-btn" disabled title="Sắp ra mắt">Đăng ký</button>
                    </div>
                    <p class="text-[11px] text-gray-500 mt-2">Newsletter sắp ra mắt — giữ chỗ email của bạn.</p>
                </form>
            </div>
        </div>

        <div class="border-t border-white/10 mt-12 pt-8 flex flex-col sm:flex-row justify-between gap-4 text-sm text-gray-500">
            <p>&copy; @DateTime.Now.Year Xe Máy Hiếu Nga. All rights reserved.</p>
            <p>HEAD Dealer · Honda Việt Nam · Đà Nẵng</p>
        </div>
    </div>
</footer>
