@using HieuNga.Web.Filters
@{
    var site = SiteSettingsViewData.Get(ViewData);
    var telHref = SiteSettingsViewData.TelHref(site);
    var intent = ViewData["CtaIntent"] as string ?? "mua-xe";
    var xe = ViewData["CtaXe"] as string;
    var source = ViewData["CtaSource"] as string ?? "banner";
    var consultQs = new List<string> { $"intent={Uri.EscapeDataString(intent)}", $"source={Uri.EscapeDataString(source)}" };
    if (!string.IsNullOrWhiteSpace(xe)) consultQs.Add($"xe={Uri.EscapeDataString(xe)}");
    var consultUrl = "/lien-he?" + string.Join("&", consultQs);
}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="relative rounded-3xl overflow-hidden bg-honda-dark">
        <div class="absolute inset-0 bg-gradient-to-r from-honda-dark via-honda-dark/95 to-[#3f0a12]/90" aria-hidden="true"></div>
        <div class="relative p-10 md:p-16 flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="text-white">
                <h2 class="text-2xl md:text-3xl font-bold">Cần tư vấn ngay?</h2>
                <p class="text-gray-300 mt-2">Đội ngũ @site.SiteName sẵn sàng hỗ trợ — @site.OpeningHours</p>
            </div>
            <div class="flex flex-wrap gap-4">
                <a href="@telHref" hx-boost="false" class="btn-primary touch-press">Gọi @site.Hotline</a>
                <a href="@consultUrl" class="btn-secondary !border-white !text-white hover:!bg-white hover:!text-honda-dark touch-press">Liên hệ</a>
            </div>
        </div>
    </div>
</section>
