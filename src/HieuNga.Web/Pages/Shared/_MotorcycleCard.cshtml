@model MotorcycleListItemDto
@using HieuNga.Application.Mappings
@using HieuNga.Domain
@{
    var imageUrl = MotorcycleImageCatalog.ResolveThumbnail(Model.Slug, Model.ThumbnailUrl);
    var fallbackUrl = MotorcycleImageCatalog.GetThumbnail(Model.Slug);
}
<a href="/xe/@Model.Slug" class="card-motorcycle group block relative reveal @(Model.IsAvailable ? "" : "opacity-90")">
    <div class="img-wrap relative aspect-[4/3] bg-gradient-to-br from-gray-100 to-gray-50 overflow-hidden">
        <img src="@imageUrl"
             data-fallback="@fallbackUrl"
             alt="@Model.Name"
             class="img-motorcycle img-media w-full h-full object-cover transition-transform duration-[650ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
             loading="lazy"
             decoding="async"
             width="640"
             height="480"
             onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-loaded');var w=this.closest('.img-wrap');if(w)w.classList.add('is-loaded')}" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="absolute top-3 left-3 flex flex-wrap gap-2 z-10">
            @if (Model.IsFeatured)
            {
                <span class="px-2.5 py-1 bg-honda-red text-white text-[10px] font-bold uppercase tracking-wide rounded-md shadow-lg">Nổi bật</span>
            }
            <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide rounded-md shadow-sm @(Model.IsAvailable ? "bg-emerald-600 text-white" : "bg-gray-700 text-white")">
                @Model.AvailabilityLabel
            </span>
        </div>
    </div>
    <div class="p-5 md:p-6">
        <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">@Model.Category.ToDisplayName()</span>
        <h3 class="text-lg md:text-xl font-bold mt-1 text-honda-dark group-hover:text-honda-red transition-colors duration-300 line-clamp-1">@Model.Name</h3>
        @if (!string.IsNullOrEmpty(Model.ShortDescription))
        {
            <p class="text-sm text-gray-500 mt-1.5 line-clamp-2 leading-relaxed">@Model.ShortDescription</p>
        }
        <div class="mt-4 pt-4 border-t border-gray-100 flex items-end justify-between gap-3">
            <div>
                <p class="text-honda-red font-bold text-xl tracking-tight">@Model.BasePrice.ToVnd()</p>
                <p class="text-xs text-gray-500 mt-0.5">Từ <span class="font-semibold text-honda-dark">@Model.BasePrice.ToEstimatedMonthly()</span>/tháng</p>
            </div>
            <span class="card-cta-reveal shrink-0 w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-honda-red group-hover:bg-honda-red group-hover:text-white transition-all duration-300 group-hover:shadow-lg group-hover:shadow-red-500/25 md:opacity-100">
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
        </div>
    </div>
</a>
