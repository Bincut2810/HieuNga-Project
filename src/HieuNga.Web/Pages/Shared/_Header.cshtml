@using HieuNga.Web.Filters
@{
    var site = SiteSettingsViewData.Get(ViewData);
    var telHref = SiteSettingsViewData.TelHref(site);
}
<header id="site-header" class="site-header sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100"
        x-data="{ open: false }"
        @@click.outside="open = false"
        @@htmx:afterSwap.window="open = false"
        @@htmx:historyRestore.window="open = false">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="site-header-inner flex items-center justify-between">
            <a href="/" data-nav class="flex items-center gap-3 group">
                <div class="site-logo-mark w-10 h-10 bg-honda-red rounded-lg flex items-center justify-center shadow-sm group-hover:shadow-md transition-shadow">
                    <span class="text-white font-bold text-sm">HN</span>
                </div>
                <div class="hidden sm:block">
                    <p class="font-bold text-honda-dark leading-tight group-hover:text-honda-red transition-colors">Xe Máy Hiếu Nga</p>
                    <p class="text-xs text-gray-500">HEAD Đà Nẵng</p>
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-8 text-sm font-medium">
                <a href="/xe" data-nav class="nav-link hover:text-honda-red">Mua xe</a>
                <a href="/dich-vu" data-nav class="nav-link hover:text-honda-red">Dịch vụ</a>
                <a href="/lien-he" data-nav class="nav-link hover:text-honda-red">Liên hệ</a>
            </nav>

            <div class="hidden lg:flex items-center gap-3">
                <a href="@telHref" hx-boost="false" class="text-sm font-semibold text-honda-dark hover:text-honda-red transition-colors">@site.Hotline</a>
                <a href="/lien-he" class="btn-primary">Tư vấn ngay</a>
                <a href="/admin" hx-boost="false" class="text-xs font-medium text-gray-500 border border-gray-200 rounded-lg px-3 py-2 hover:border-gray-300 hover:text-honda-dark transition-colors">Quản trị</a>
            </div>

            <button @@click="open = !open" class="lg:hidden p-2 rounded-lg hover:bg-gray-50 transition-colors touch-press" aria-label="Menu" :aria-expanded="open">
                <svg class="w-6 h-6 transition-transform duration-300" :class="open && 'rotate-90'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path x-show="!open" stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    <path x-show="open" stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    </div>

    <div x-show="open"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 -translate-y-2"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-2"
         class="mobile-nav-panel lg:hidden border-t bg-white/98 backdrop-blur-lg px-4 py-4 space-y-1 shadow-lg"
         x-cloak>
        <a href="/xe" data-nav class="block py-3 px-3 rounded-xl font-medium hover:bg-gray-50 transition">Mua xe</a>
        <a href="/dich-vu" data-nav class="block py-3 px-3 rounded-xl font-medium hover:bg-gray-50 transition">Dịch vụ</a>
        <a href="/lien-he" data-nav class="block py-3 px-3 rounded-xl font-medium hover:bg-gray-50 transition">Liên hệ</a>
        <a href="/lien-he" class="block py-3 px-3 rounded-xl font-semibold text-center text-white bg-honda-red hover:bg-red-700 transition mt-2">Tư vấn ngay</a>
        <a href="@telHref" hx-boost="false" class="block py-3 px-3 text-center font-semibold border border-gray-200 rounded-xl mt-1 touch-press">Gọi @site.Hotline</a>
        <a href="/admin" hx-boost="false" class="block py-2.5 px-3 text-center text-xs font-medium text-gray-500 hover:text-honda-dark transition mt-1">Quản trị</a>
    </div>
</header>
<style>
[x-cloak] { display: none !important; }
.mobile-nav-panel a[data-nav].nav-link-active {
    color: var(--honda-red, #E40521);
    background: rgba(228, 5, 33, 0.06);
    font-weight: 600;
}
</style>
