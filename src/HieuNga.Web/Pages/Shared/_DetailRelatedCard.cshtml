@model MotorcycleListItemDto
@using HieuNga.Application.Mappings
@using HieuNga.Domain
@{
    var imageUrl = Model.ThumbnailUrl;
}
<article class="detail-related-card group detail-lift">
    <a href="/xe/@Model.Slug" class="block">
        <div class="img-wrap relative aspect-[16/11] bg-gradient-to-br from-gray-100 to-gray-50 overflow-hidden">
            @if (!string.IsNullOrWhiteSpace(imageUrl))
            {
                <img src="@imageUrl"
                     data-fallback="@MotorcycleImageCatalog.Default"
                     alt="@Model.Name"
                     class="img-motorcycle img-media w-full h-full object-cover detail-related-img"
                     loading="lazy"
                     decoding="async"
                     width="800"
                     height="550"
                     onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-loaded');var w=this.closest('.img-wrap');if(w)w.classList.add('is-loaded')}" />
            }
            else
            {
                <div class="absolute inset-0 flex items-center justify-center text-3xl font-bold text-gray-300" aria-hidden="true">@Model.Name.Substring(0, 1)</div>
            }
            <div class="absolute top-3 left-3 flex flex-wrap gap-2 z-10">
                @if (Model.IsFeatured)
                {
                    <span class="detail-badge detail-badge-featured">Nổi bật</span>
                }
            </div>
        </div>
        <div class="p-5">
            <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">@Model.Category.ToDisplayName()</span>
            <h3 class="text-lg font-bold mt-1 text-honda-dark group-hover:text-honda-red transition-colors line-clamp-1">@Model.Name</h3>
            <p class="text-honda-red font-bold text-xl mt-3 tracking-tight">@Model.BasePrice.ToVnd()</p>
        </div>
    </a>
    <div class="px-5 pb-5 flex flex-wrap gap-2">
        <a href="/xe/@Model.Slug" class="btn-primary flex-1 min-w-[6.5rem] py-2.5 text-sm justify-center touch-press">Xem chi tiết</a>
    </div>
</article>
