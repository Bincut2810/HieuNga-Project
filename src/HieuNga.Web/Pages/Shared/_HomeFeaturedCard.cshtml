@model MotorcycleListItemDto
@using HieuNga.Application.Mappings
@using HieuNga.Domain
@{
    var imageUrl = Model.ThumbnailUrl;
}
<article class="home-featured-card group reveal">
    <div class="img-wrap relative aspect-[16/11] bg-gradient-to-br from-gray-100 to-gray-50 overflow-hidden">
        <a href="/xe/@Model.Slug" class="block absolute inset-0" tabindex="-1" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(imageUrl))
            {
                <img src="@imageUrl"
                     data-fallback="@MotorcycleImageCatalog.Default"
                     alt=""
                     class="img-motorcycle img-media w-full h-full object-cover home-featured-img"
                     loading="lazy"
                     decoding="async"
                     width="800"
                     height="550"
                     onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-loaded');var w=this.closest('.img-wrap');if(w)w.classList.add('is-loaded')}" />
            }
            else
            {
                <div class="absolute inset-0 flex items-center justify-center text-4xl font-bold text-gray-300">@Model.Name.Substring(0, 1)</div>
            }
        </a>
        <div class="absolute top-3 left-3 flex flex-wrap gap-2 z-10 pointer-events-none">
            @if (Model.IsFeatured)
            {
                <span class="px-2.5 py-1 bg-honda-red text-white text-[10px] font-bold uppercase tracking-wide rounded-md shadow-lg">Nổi bật</span>
            }
            <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide rounded-md shadow-sm @(Model.IsAvailable ? "bg-emerald-600 text-white" : "bg-gray-700 text-white")">
                @Model.AvailabilityLabel
            </span>
        </div>
        <div class="home-featured-quick" role="group" aria-label="Thao tác nhanh">
            <button type="button" class="home-featured-icon-btn" disabled title="Yêu thích (sắp có)" aria-label="Yêu thích (sắp có)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            </button>
            <a href="/so-sanh?handler=Add&amp;id=@Model.Id"
               hx-get="/so-sanh?handler=Add&amp;id=@Model.Id"
               hx-target="#compare-toast"
               hx-swap="innerHTML"
               hx-push-url="false"
               hx-boost="false"
               class="home-featured-icon-btn"
               title="So sánh"
               aria-label="Thêm vào so sánh">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M8 7h12M4 12h16M8 17h12"/></svg>
            </a>
        </div>
    </div>
    <div class="p-5 md:p-6">
        <a href="/xe/@Model.Slug" class="block">
            <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">@Model.Category.ToDisplayName()</span>
            <h3 class="text-xl font-bold mt-1 text-honda-dark group-hover:text-honda-red transition-colors line-clamp-1">@Model.Name</h3>
            @if (!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <p class="text-sm text-gray-500 mt-1.5 line-clamp-2 leading-relaxed">@Model.ShortDescription</p>
            }
            <div class="mt-4 pt-4 border-t border-gray-100">
                <p class="text-honda-red font-bold text-2xl tracking-tight">@Model.BasePrice.ToVnd()</p>
                <p class="text-xs text-gray-500 mt-0.5">Trả góp từ <span class="font-semibold text-honda-dark">@Model.BasePrice.ToEstimatedMonthly()</span>/tháng</p>
            </div>
        </a>
    </div>
    <div class="px-5 md:px-6 pb-5 md:pb-6 flex flex-wrap gap-2">
        <a href="/xe/@Model.Slug" class="btn-primary flex-1 min-w-[7rem] py-2.5 text-sm justify-center touch-press">Xem chi tiết</a>
        <a href="/tra-gop" class="btn-secondary flex-1 min-w-[7rem] py-2.5 text-sm justify-center touch-press">Tính góp</a>
        <a href="/lien-he?intent=mua-xe&amp;xe=@Uri.EscapeDataString(Model.Slug)&amp;source=homepage" class="inline-flex flex-1 min-w-[7rem] items-center justify-center px-3 py-2.5 text-sm font-semibold border border-gray-200 rounded-lg hover:border-honda-red hover:text-honda-red transition touch-press focus-ring">Tư vấn</a>
    </div>
</article>
