@model (string Title, string? Subtitle, string? Badge)
<section class="relative bg-honda-dark text-white overflow-hidden reveal is-visible">
    <div class="absolute inset-0 bg-gradient-to-br from-honda-dark via-honda-charcoal to-honda-red/20"></div>
    <div class="absolute -right-20 -top-20 w-96 h-96 bg-honda-red/10 rounded-full blur-3xl"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        @if (!string.IsNullOrEmpty(Model.Badge))
        {
            <span class="inline-block px-3 py-1 bg-honda-red text-xs font-bold uppercase tracking-wider rounded mb-4">@Model.Badge</span>
        }
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight max-w-3xl">@Model.Title</h1>
        @if (!string.IsNullOrEmpty(Model.Subtitle))
        {
            <p class="mt-4 text-lg text-gray-400 max-w-2xl">@Model.Subtitle</p>
        }
    </div>
</section>
