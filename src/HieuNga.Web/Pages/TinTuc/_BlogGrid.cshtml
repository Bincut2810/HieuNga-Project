@model PagedResultDto<BlogPostListItemDto>

@if (!Model.Items.Any())
{
    <p class="text-center text-gray-500 py-16">Chưa có bài viết trong danh mục này.</p>
}
else
{
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 htmx-settling">
        @foreach (var post in Model.Items)
        {
            <partial name="_BlogCard" model="post" />
        }
    </div>
}
