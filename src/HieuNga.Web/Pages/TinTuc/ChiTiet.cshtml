@page "/tin-tuc/{slug}"
@model HieuNga.Web.Pages.TinTuc.ChiTietModel
@{
    var post = Model.Post!;
}

<article>
    <section class="relative bg-honda-dark text-white py-20 md:py-28 overflow-hidden">
        <img src="@post.ThumbnailUrl" alt="" class="absolute inset-0 w-full h-full object-cover opacity-25" />
        <div class="relative max-w-3xl mx-auto px-4 text-center">
            @if (!string.IsNullOrEmpty(post.CategoryName))
            {
                <span class="text-xs font-bold text-honda-red uppercase">@post.CategoryName</span>
            }
            <h1 class="text-3xl md:text-5xl font-bold mt-4 leading-tight">@post.Title</h1>
            <p class="text-gray-400 mt-4 text-sm">
                @(post.AuthorName ?? "Honda Hiếu Nga")
                @if (post.PublishedAt.HasValue) { <span> · @post.PublishedAt.Value.ToString("dd/MM/yyyy")</span> }
            </p>
        </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
        <nav class="text-sm text-gray-400 mb-8">
            <a href="/tin-tuc" class="hover:text-honda-red">Tin tức</a> / <span>@post.Title</span>
        </nav>
        <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
            @Html.Raw(post.Content)
        </div>
        <div class="mt-12 pt-8 border-t flex flex-wrap gap-4">
            <a href="/xe" class="btn-primary">Xem xe Honda</a>
            <a href="/lien-he" class="btn-secondary">Liên hệ tư vấn</a>
        </div>
    </section>
</article>
