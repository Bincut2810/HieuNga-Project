@page "/tin-tuc"
@model HieuNga.Web.Pages.TinTuc.IndexModel

<partial name="_PageHero" model='("Tin tức Honda", "Cập nhật xe mới, mẹo bảo dưỡng và tư vấn chọn xe", "Blog")' />

@if (Model.Featured is not null)
{
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-12 relative z-10 pb-8">
        <a href="/tin-tuc/@Model.Featured.Slug" class="group block rounded-3xl overflow-hidden shadow-2xl bg-honda-dark">
            <div class="grid md:grid-cols-2">
                <div class="aspect-[16/10] md:aspect-auto overflow-hidden">
                    <img src="@Model.Featured.ThumbnailUrl" alt="@Model.Featured.Title" class="w-full h-full object-cover group-hover:scale-105 transition duration-700 min-h-[240px]" />
                </div>
                <div class="p-8 md:p-12 flex flex-col justify-center text-white">
                    <span class="text-xs font-bold text-honda-red uppercase">Nổi bật</span>
                    <h2 class="text-2xl md:text-3xl font-bold mt-3 group-hover:text-red-200 transition">@Model.Featured.Title</h2>
                    <p class="text-gray-400 mt-3 line-clamp-2">@Model.Featured.Summary</p>
                    <span class="mt-6 font-semibold">Đọc bài viết →</span>
                </div>
            </div>
        </a>
    </section>
}

<section class="page-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 reveal is-visible">
    <form hx-get="/tin-tuc?handler=Filter" hx-target="#blog-grid" hx-swap="innerHTML transition:true" hx-indicator="#blog-skeleton"
          hx-trigger="submit" class="flex flex-wrap gap-3 mb-10">
        <button type="submit" name="CategoryId" value=""
                class="px-4 py-2 rounded-full text-sm font-medium border transition @(Model.CategoryId is null ? "bg-honda-dark text-white border-honda-dark" : "hover:border-honda-red")">
            Tất cả
        </button>
        @foreach (var cat in Model.Categories)
        {
            <button type="submit" name="CategoryId" value="@cat.Id"
                    class="px-4 py-2 rounded-full text-sm font-medium border transition @(Model.CategoryId == cat.Id ? "bg-honda-dark text-white border-honda-dark" : "hover:border-honda-red")">
                @cat.Name
            </button>
        }
    </form>

    <div class="relative min-h-[320px]">
        <div id="blog-skeleton" class="htmx-indicator absolute inset-0 z-10 bg-white/90 backdrop-blur-sm rounded-2xl p-4 md:p-6">
            <partial name="_SkeletonBlogGrid" />
        </div>
        <div id="blog-grid" class="transition-opacity duration-300">
            <partial name="_BlogGrid" model="Model.Posts" />
        </div>
    </div>
</section>

<partial name="_CtaBanner" />
