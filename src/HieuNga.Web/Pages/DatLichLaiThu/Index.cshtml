@page "/dat-lich-lai-thu"
@model HieuNga.Web.Pages.DatLichLaiThu.IndexModel

<section class="max-w-xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-center">Đặt lịch lái thử</h1>
    <p class="text-gray-500 text-center mt-2 mb-10">Trải nghiệm xe Honda — miễn phí</p>

    @if (Model.Success)
    {
        <div class="bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
            <p class="text-green-800 font-semibold text-lg">Đặt lịch thành công!</p>
            <p class="text-green-600 text-sm mt-2">Chúng tôi sẽ liên hệ xác nhận trong thời gian sớm nhất.</p>
        </div>
    }
    else
    {
        <form method="post" class="space-y-5">
            <div asp-validation-summary="All" class="text-red-600 text-sm"></div>
            <div>
                <label class="block text-sm font-medium mb-1">Họ tên *</label>
                <input asp-for="CustomerName" class="w-full px-4 py-3 border rounded-lg" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Số điện thoại *</label>
                <input asp-for="Phone" class="w-full px-4 py-3 border rounded-lg" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Email</label>
                <input asp-for="Email" type="email" class="w-full px-4 py-3 border rounded-lg" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Ngày mong muốn *</label>
                <input asp-for="PreferredDate" type="date" class="w-full px-4 py-3 border rounded-lg" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Ghi chú</label>
                <textarea asp-for="Notes" rows="3" class="w-full px-4 py-3 border rounded-lg"></textarea>
            </div>
            <input type="hidden" asp-for="MotorcycleId" />
            <button type="submit" class="btn-primary w-full">Gửi yêu cầu</button>
        </form>
    }
</section>
