@page "/dat-lich-lai-thu"
@model HieuNga.Web.Pages.DatLichLaiThu.IndexModel
@using HieuNga.Web.Filters
@{
    var site = SiteSettingsViewData.Get(ViewData);
    var telHref = SiteSettingsViewData.TelHref(site);
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var selectedId = Model.MotorcycleId;
    var selectedSlug = Model.SelectedMotorcycle?.Slug ?? "";
    var backUrl = string.IsNullOrEmpty(selectedSlug) ? "/xe" : $"/xe/{selectedSlug}";
    if (Model.Success && !string.IsNullOrWhiteSpace(Model.SuccessMotorcycleUrl))
        backUrl = Model.SuccessMotorcycleUrl;
}

<section class="book-page" data-trb-page
         data-hotline="@site.Hotline"
         data-tel="@telHref"
         data-back-url="@backUrl">
    <div class="book-shell">
        @if (Model.Success)
        {
            <div class="trb-success-static" role="status" aria-live="polite">
                <div class="trb-modal-mark trb-modal-mark-ok" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h1 class="trb-modal-title">Đặt lịch thành công!</h1>
                <p class="trb-received" data-trb-received>
                    Đã ghi nhận lúc<br />
                    <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong><br />
                    <strong>@DateTime.Now.ToString("HH:mm")</strong>
                </p>
                <p class="trb-modal-text">
                    @(Model.IsDuplicate
                        ? HieuNga.Web.Pages.DatLichLaiThu.IndexModel.DuplicateMessage
                        : "Cảm ơn bạn đã đăng ký lịch xem xe. Nhân viên Xe máy Hiếu Nga sẽ liên hệ với bạn trong thời gian sớm nhất để xác nhận lịch hẹn.")
                </p>
                <div class="trb-modal-actions">
                    <a href="@telHref" hx-boost="false" class="btn-primary touch-press">Gọi ngay</a>
                    <a href="@backUrl" class="btn-secondary touch-press">Quay về trang xe</a>
                </div>
            </div>
        }
        else
        {
            <header class="book-header">
                <p class="section-eyebrow">Đặt lịch</p>
                <h1 class="book-title">Đặt lịch xem xe</h1>
                <p class="book-sub">Chỉ mất khoảng 30 giây — showroom sẽ gọi xác nhận.</p>
            </header>

            <form id="trb-form" class="book-form" method="post" novalidate
                  action="/dat-lich-lai-thu"
                  hx-boost="false"
                  data-trb-form
                  data-handler="/dat-lich-lai-thu?handler=Book">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SourceField" value="@Model.LeadSource" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="book-error" role="alert">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@err.ErrorMessage</p>
                        }
                    </div>
                }

                <div class="book-field">
                    <label for="CustomerName">Họ tên *</label>
                    <input id="CustomerName" name="CustomerName" class="book-input" autocomplete="name"
                           value="@Model.CustomerName" required maxlength="100" />
                </div>

                <div class="book-field">
                    <label for="Phone">Số điện thoại *</label>
                    <input id="Phone" name="Phone" class="book-input" autocomplete="tel" inputmode="tel"
                           value="@Model.Phone" required placeholder="09…" />
                </div>

                <div class="book-field">
                    <label for="MotorcycleId">Xe muốn xem *</label>
                    <select id="MotorcycleId" name="MotorcycleId" class="book-input" data-trb-moto required>
                        <option value="">— Chọn mẫu xe —</option>
                        @foreach (var bike in Model.MotorcycleOptions)
                        {
                            if (selectedId == bike.Id)
                            {
                                <option value="@bike.Id" data-slug="@bike.Slug" selected>@bike.Name</option>
                            }
                            else
                            {
                                <option value="@bike.Id" data-slug="@bike.Slug">@bike.Name</option>
                            }
                        }
                    </select>
                    @if (Model.SelectedMotorcycle is not null)
                    {
                        <p class="book-footnote" style="text-align:left;margin-top:0.4rem;" data-trb-moto-hint>
                            Đang chọn: <strong data-trb-moto-name>@Model.SelectedMotorcycle.Name</strong>
                            · <a href="/xe/@Model.SelectedMotorcycle.Slug" data-trb-moto-link>Xem chi tiết</a>
                        </p>
                    }
                    else
                    {
                        <p class="book-footnote" style="text-align:left;margin-top:0.4rem;" data-trb-moto-hint hidden>
                            Đang chọn: <strong data-trb-moto-name></strong>
                            · <a href="#" data-trb-moto-link>Xem chi tiết</a>
                        </p>
                    }
                </div>

                <div class="book-row">
                    <div class="book-field">
                        <label for="PreferredDate">Ngày *</label>
                        <input id="PreferredDate" name="PreferredDate" type="date" class="book-input"
                               value="@Model.PreferredDate.ToString("yyyy-MM-dd")" min="@minDate" required />
                    </div>
                    <div class="book-field">
                        <label for="PreferredTime">Khung giờ *</label>
                        <select id="PreferredTime" name="PreferredTime" class="book-input" required>
                            @foreach (var slot in Model.TimeSlots)
                            {
                                if (slot == Model.PreferredTime)
                                {
                                    <option value="@slot" selected>@slot</option>
                                }
                                else
                                {
                                    <option value="@slot">@slot</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="book-field">
                    <label for="Notes">Ghi chú (tuỳ chọn)</label>
                    <input id="Notes" name="Notes" class="book-input" maxlength="500"
                           value="@Model.Notes" placeholder="VD: Muốn xem màu đỏ" />
                </div>

                <button type="submit" class="btn-primary book-submit touch-press" data-trb-submit>
                    <span data-trb-submit-label>Gửi lịch hẹn</span>
                    <span class="trb-spinner" data-trb-spinner hidden aria-hidden="true"></span>
                </button>

                <p class="book-footnote">
                    Hoặc gọi ngay <a href="@telHref" hx-boost="false">@site.Hotline</a>
                </p>
            </form>
        }
    </div>

    @* AJAX dialogs — bootstrapped by polish.js, never @section Scripts *@
    <div class="trb-modal" data-trb-modal="success" hidden>
        <div class="trb-modal-backdrop" data-trb-modal-close tabindex="-1"></div>
        <div class="trb-modal-card" role="dialog" aria-modal="true"
             aria-labelledby="trb-success-title" aria-describedby="trb-success-desc"
             data-trb-dialog tabindex="-1">
            <div class="trb-modal-mark trb-modal-mark-ok trb-modal-mark-anim" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path class="trb-check-path" d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h2 id="trb-success-title" class="trb-modal-title">Đặt lịch thành công!</h2>
            <p class="trb-received" data-trb-received hidden>
                Đã ghi nhận lúc<br />
                <strong data-trb-received-date></strong><br />
                <strong data-trb-received-time></strong>
            </p>
            <p id="trb-success-desc" class="trb-modal-text" data-trb-success-desc>
                Cảm ơn bạn đã đăng ký lịch xem xe.<br />
                Nhân viên Xe máy Hiếu Nga sẽ liên hệ với bạn trong thời gian sớm nhất để xác nhận lịch hẹn.
            </p>
            <div class="trb-modal-actions">
                <a href="@telHref" hx-boost="false" class="btn-primary touch-press" data-trb-call>Gọi ngay</a>
                <a href="@backUrl" class="btn-secondary touch-press" data-trb-back>Quay về trang xe</a>
            </div>
            <button type="button" class="trb-modal-x" data-trb-modal-close aria-label="Đóng">×</button>
        </div>
    </div>

    <div class="trb-modal" data-trb-modal="error" hidden>
        <div class="trb-modal-backdrop" data-trb-modal-close tabindex="-1"></div>
        <div class="trb-modal-card" role="dialog" aria-modal="true"
             aria-labelledby="trb-error-title" aria-describedby="trb-error-desc"
             data-trb-dialog tabindex="-1">
            <div class="trb-modal-mark trb-modal-mark-err" aria-hidden="true">!</div>
            <h2 id="trb-error-title" class="trb-modal-title">Không gửi được lịch</h2>
            <div id="trb-error-desc" class="trb-modal-text" data-trb-error-body>
                Vui lòng kiểm tra lại thông tin và thử lại.
            </div>
            <div class="trb-modal-actions">
                <button type="button" class="btn-primary touch-press" data-trb-modal-close>Thử lại</button>
            </div>
            <button type="button" class="trb-modal-x" data-trb-modal-close aria-label="Đóng">×</button>
        </div>
    </div>
</section>
