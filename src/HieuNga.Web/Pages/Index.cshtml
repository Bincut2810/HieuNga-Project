@page
@model HieuNga.Web.Pages.IndexModel
@{
    var d = Model.Data;
    var hero = d.HeroBanners.FirstOrDefault();
    var heroImage = hero?.ImageUrl ?? "https://images.unsplash.com/photo-1558980664-769d9df238f8?w=1920&q=85";
    var heroTitle = hero?.Title ?? "Khám phá Honda tại Đà Nẵng";
    var heroSubtitle = hero?.Subtitle ?? "Đại lý HEAD chính hãng — Trả góp linh hoạt, lái thử miễn phí";
}

<div class="homepage overflow-x-hidden">
    @* ═══ HERO ═══ *@
    <section class="home-hero relative min-h-[92vh] md:min-h-[88vh] flex items-end overflow-hidden bg-honda-dark">
        <div class="absolute inset-0 home-hero-zoom">
            <img src="@heroImage" alt="@heroTitle" class="img-media is-loaded w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-r from-honda-dark via-honda-dark/80 to-honda-dark/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-honda-dark via-transparent to-honda-dark/30"></div>

        <div class="home-hero-orb home-hero-orb-1"></div>
        <div class="home-hero-orb home-hero-orb-2"></div>

        <div class="absolute top-24 right-4 md:right-12 z-20 hidden sm:block animate-fade-in" style="animation-delay: 0.4s">
            <div class="home-float-badge bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl px-5 py-4 text-white shadow-2xl">
                <p class="text-[10px] uppercase tracking-widest text-gray-300">Trả góp từ</p>
                <p class="text-2xl font-bold text-honda-red mt-1">2.9 triệu<span class="text-sm font-medium text-white/80">/tháng</span></p>
                <a href="/tra-gop" class="text-xs font-semibold mt-2 inline-flex items-center gap-1 hover:text-honda-red transition">Tính ngay →</a>
            </div>
        </div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 md:pb-32 pt-32">
            <div class="max-w-3xl home-hero-content">
                <div class="flex flex-wrap items-center gap-3 mb-6">
                    <span class="px-3 py-1.5 bg-honda-red text-white text-xs font-bold uppercase tracking-wider rounded-full shadow-lg shadow-red-500/30">Honda HEAD</span>
                    <span class="px-3 py-1.5 bg-white/10 backdrop-blur text-white text-xs font-medium rounded-full border border-white/20">Đà Nẵng</span>
                </div>
                <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.05] tracking-tight">
                    @heroTitle
                </h1>
                <p class="mt-5 md:mt-6 text-lg md:text-xl text-gray-300 max-w-xl leading-relaxed">
                    @heroSubtitle
                </p>
                <div class="mt-8 md:mt-10 flex flex-col sm:flex-row flex-wrap gap-3 md:gap-4">
                    <a href="@(hero?.CtaUrl ?? "/xe")" class="btn-primary px-8 py-4 text-base shadow-xl shadow-red-500/25 text-center justify-center">
                        @(hero?.CtaText ?? "Khám phá xe Honda")
                    </a>
                    <a href="/tra-gop" class="home-btn-glass px-8 py-4 text-base font-semibold text-center rounded-lg transition">
                        Tính trả góp
                    </a>
                    <a href="/dat-lich-lai-thu" class="home-btn-outline px-8 py-4 text-base font-semibold text-center rounded-lg transition">
                        Đặt lái thử
                    </a>
                </div>
                <div class="mt-10 flex flex-wrap gap-6 text-sm text-gray-400">
                    <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Xe chính hãng 100%</span>
                    <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Bảo hành Honda VN</span>
                    <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Hỗ trợ trả góp</span>
                </div>
            </div>
        </div>

        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 hidden md:flex flex-col items-center gap-2 text-white/40">
            <span class="text-[10px] uppercase tracking-widest">Cuộn xuống</span>
            <div class="w-px h-8 bg-gradient-to-b from-white/50 to-transparent home-scroll-line"></div>
        </div>
    </section>

    @* ═══ TRUST BAR ═══ *@
    <section class="relative z-20 -mt-6 md:-mt-10 mx-4 sm:mx-6 lg:mx-auto max-w-7xl">
        <div class="home-trust-bar reveal is-visible bg-white rounded-2xl md:rounded-3xl shadow-xl shadow-black/5 border border-gray-100 p-6 md:p-8 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
            @foreach (var stat in new[] { ("15+", "Năm kinh nghiệm"), ("10K+", "Khách hàng tin tưởng"), ("100%", "Xe chính hãng"), ("HEAD", "Dealer cao cấp") })
            {
                <div class="text-center md:text-left md:pl-6 md:border-l md:first:border-0 md:first:pl-0 border-gray-100">
                    <p class="text-2xl md:text-3xl font-bold text-honda-red tracking-tight">@stat.Item1</p>
                    <p class="text-xs md:text-sm text-gray-500 mt-1">@stat.Item2</p>
                </div>
            }
        </div>
    </section>

    @* ═══ FEATURED BIKES ═══ *@
    <section class="home-section page-section py-20 md:py-28 reveal">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16 reveal-delay-1">
                <div>
                    <span class="text-xs font-bold uppercase tracking-[0.2em] text-honda-red">Showroom</span>
                    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-honda-dark mt-2 tracking-tight">Xe nổi bật</h2>
                    <p class="text-gray-500 mt-3 text-base md:text-lg max-w-lg">Dòng xe Honda được ưa chuộng nhất tại Hiếu Nga Đà Nẵng</p>
                </div>
                <a href="/xe" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-honda-dark rounded-xl font-semibold text-sm hover:bg-honda-dark hover:text-white transition shrink-0">
                    Xem toàn bộ xe
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                @foreach (var bike in d.FeaturedMotorcycles)
                {
                    <partial name="_MotorcycleCard" model="bike" />
                }
            </div>
        </div>
    </section>

    @* ═══ PROMOTIONS ═══ *@
    @if (d.Promotions.Any())
    {
        <section class="home-section page-section py-20 md:py-28 bg-gradient-to-b from-gray-50 to-white reveal">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
                    <span class="text-xs font-bold uppercase tracking-[0.2em] text-honda-red">Ưu đãi</span>
                    <h2 class="text-3xl md:text-4xl font-bold text-honda-dark mt-2 tracking-tight">Chương trình hot</h2>
                    <p class="text-gray-500 mt-3">Cập nhật khuyến mãi tháng tại HEAD Đà Nẵng</p>
                </div>
                <div class="grid md:grid-cols-2 gap-6 md:gap-8">
                    @foreach (var promo in d.Promotions)
                    {
                        <a href="/khuyen-mai/@promo.Slug"
                           class="home-promo-card group relative overflow-hidden rounded-3xl bg-white border border-gray-100 p-8 md:p-10 hover:shadow-2xl hover:shadow-black/5 transition-all duration-500">
                            <div class="absolute top-0 right-0 w-40 h-40 bg-honda-red/5 rounded-full blur-3xl group-hover:bg-honda-red/10 transition"></div>
                            <span class="relative text-[10px] font-bold uppercase tracking-widest text-honda-red">@promo.Type</span>
                            <h3 class="relative text-xl md:text-2xl font-bold mt-3 text-honda-dark group-hover:text-honda-red transition line-clamp-2">@promo.Title</h3>
                            <p class="relative text-gray-500 mt-3 text-sm leading-relaxed line-clamp-2">@promo.Summary</p>
                            <span class="relative inline-flex items-center gap-2 mt-6 text-sm font-bold text-honda-dark group-hover:text-honda-red transition">
                                Xem chi tiết
                                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                            </span>
                        </a>
                    }
                </div>
                <div class="text-center mt-10">
                    <a href="/khuyen-mai" class="text-honda-red font-semibold hover:underline">Xem tất cả khuyến mãi →</a>
                </div>
            </div>
        </section>
    }

    @* ═══ FINANCING ═══ *@
    <section class="home-section page-section py-20 md:py-28 reveal">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="home-finance-block relative overflow-hidden rounded-3xl md:rounded-[2rem]">
                <div class="absolute inset-0 bg-gradient-to-br from-honda-dark via-[#2a1518] to-honda-red/90"></div>
                <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1200&q=80" alt=""
                     class="absolute inset-0 w-full h-full object-cover opacity-20 mix-blend-overlay" />
                <div class="absolute -right-20 -top-20 w-80 h-80 bg-honda-red/30 rounded-full blur-3xl"></div>

                <div class="relative grid lg:grid-cols-2 gap-10 lg:gap-16 p-8 md:p-14 lg:p-20 items-center">
                    <div class="text-white">
                        <span class="text-xs font-bold uppercase tracking-[0.25em] text-red-300">Trả góp 0% · Nhiều ngân hàng</span>
                        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mt-4 tracking-tight leading-tight">
                            Sở hữu xe Honda<br class="hidden sm:block" /> dễ hơn bạn nghĩ
                        </h2>
                        <p class="text-gray-300 mt-5 text-base md:text-lg max-w-md leading-relaxed">
                            Tính khoản trả hàng tháng trong 30 giây. Duyệt hồ sơ nhanh — thủ tục gọn tại showroom.
                        </p>
                        <div class="flex flex-wrap gap-3 mt-8">
                            @foreach (var bank in new[] { "VPBank", "Techcombank", "Vietcombank", "ACB" })
                            {
                                <span class="px-4 py-2 bg-white/10 backdrop-blur rounded-lg text-sm font-medium border border-white/10">@bank</span>
                            }
                        </div>
                    </div>
                    <div class="bg-white/95 backdrop-blur rounded-2xl p-8 md:p-10 shadow-2xl text-honda-dark">
                        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">Ví dụ tham khảo</p>
                        <p class="text-sm text-gray-500 mt-1">Honda Vision — trả trước 20%</p>
                        <p class="text-5xl md:text-6xl font-bold text-honda-red mt-4 tracking-tight">~2.9<span class="text-2xl text-gray-400 font-medium"> triệu</span></p>
                        <p class="text-gray-500 text-sm">/ tháng · 12 kỳ</p>
                        <div class="grid grid-cols-3 gap-3 mt-8 pt-8 border-t border-gray-100 text-center">
                            <div><p class="text-lg font-bold">0%</p><p class="text-[10px] text-gray-400 uppercase mt-1">Phí hồ sơ*</p></div>
                            <div><p class="text-lg font-bold">1 ngày</p><p class="text-[10px] text-gray-400 uppercase mt-1">Duyệt nhanh</p></div>
                            <div><p class="text-lg font-bold">4+</p><p class="text-[10px] text-gray-400 uppercase mt-1">Ngân hàng</p></div>
                        </div>
                        <a href="/tra-gop" class="btn-primary w-full mt-8 py-4 text-center justify-center text-base shadow-lg shadow-red-500/20">
                            Tính trả góp ngay
                        </a>
                        <a href="/lien-he" class="block text-center text-sm font-semibold text-gray-500 mt-4 hover:text-honda-red transition">
                            Nhận tư vấn miễn phí →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ═══ SERVICES ═══ *@
    <section class="home-section page-section py-20 md:py-28 bg-white reveal">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-honda-red">Dịch vụ</span>
                <h2 class="text-3xl md:text-4xl font-bold text-honda-dark mt-2 tracking-tight">Trọn vẹn hành trình</h2>
                <p class="text-gray-500 mt-3">Từ lái thử đến bảo dưỡng — một điểm đến HEAD</p>
            </div>
            <div class="grid md:grid-cols-3 gap-6 md:gap-8">
                @{
                    var services = new[]
                    {
                        ("🏍", "Lái thử miễn phí", "Trải nghiệm xe tại showroom hoặc theo lịch hẹn", "/dat-lich-lai-thu", "from-red-50 to-white"),
                        ("🔧", "Bảo dưỡng HEAD", "KTV Honda, phụ tùng chính hãng, quy trình chuẩn", "/bao-duong", "from-gray-50 to-white"),
                        ("💳", "Trả góp linh hoạt", "Nhiều kỳ hạn, nhiều ngân hàng, thủ tục tại quầy", "/tra-gop", "from-red-50/50 to-white")
                    };
                }
                @foreach (var (icon, title, desc, url, grad) in services)
                {
                    <a href="@url" class="home-service-card group block rounded-3xl border border-gray-100 overflow-hidden hover:border-honda-red/30 hover:shadow-xl transition-all duration-500">
                        <div class="bg-gradient-to-br @grad p-8 md:p-10">
                            <div class="w-16 h-16 rounded-2xl bg-white shadow-md flex items-center justify-center text-3xl group-hover:scale-110 group-hover:shadow-lg transition-all duration-300">@icon</div>
                            <h3 class="text-xl font-bold mt-6 text-honda-dark group-hover:text-honda-red transition">@title</h3>
                            <p class="text-sm text-gray-500 mt-3 leading-relaxed">@desc</p>
                            <span class="inline-flex items-center gap-2 mt-6 text-sm font-bold text-honda-red opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                                Tìm hiểu <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    @* ═══ BRANCH / TRUST ═══ *@
    @if (d.Branches.Any())
    {
        <section class="home-section page-section py-20 md:py-28 bg-honda-dark text-white relative overflow-hidden reveal">
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_20%_50%,_#E40521_0%,_transparent_50%)]"></div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
                <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                    <div>
                        <span class="inline-block text-2xl md:text-3xl font-black tracking-tighter text-white">HONDA <span class="text-honda-red font-bold text-sm align-middle ml-1">HEAD</span></span>
                        <h2 class="text-3xl md:text-4xl font-bold mt-6 tracking-tight">Honda Hiếu Nga HEAD</h2>
                        <p class="text-gray-400 mt-4 leading-relaxed">
                            Tiêu chuẩn cao nhất trong hệ thống đại lý Honda Việt Nam — cam kết minh bạch giá, dịch vụ hậu mãi chuyên nghiệp.
                        </p>
                        <ul class="mt-8 space-y-4">
                            @foreach (var item in new[] { "Showroom trải nghiệm hiện đại", "Đội tư vấn được đào tạo bài bản", "Hỗ trợ trả góp & hồ sơ tại chỗ" })
                            {
                                <li class="flex items-center gap-3 text-sm text-gray-300">
                                    <span class="w-6 h-6 rounded-full bg-honda-red/20 flex items-center justify-center text-honda-red text-xs">✓</span>
                                    @item
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="space-y-4">
                        @foreach (var branch in d.Branches)
                        {
                            <div class="home-branch-card bg-white/5 backdrop-blur border border-white/10 rounded-2xl p-6 md:p-8 hover:bg-white/10 transition">
                                @if (branch.IsHeadOffice)
                                {
                                    <span class="text-[10px] font-bold uppercase tracking-widest text-honda-red">Head Office</span>
                                }
                                <h3 class="text-xl font-bold mt-2">@branch.Name</h3>
                                <p class="text-gray-400 text-sm mt-2">@branch.Address</p>
                                @if (!string.IsNullOrEmpty(branch.Hotline ?? branch.Phone))
                                {
                                    <a href="tel:@(branch.Hotline ?? branch.Phone)" class="inline-block mt-4 text-honda-red font-bold hover:underline">
                                        @(branch.Hotline ?? branch.Phone)
                                    </a>
                                }
                                <a href="/lien-he" class="inline-flex mt-4 ml-4 text-sm text-gray-400 hover:text-white transition">Chỉ đường →</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    }

    @* ═══ TESTIMONIALS ═══ *@
    @if (d.Testimonials.Any())
    {
        <section class="home-section page-section py-20 md:py-28 reveal">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12 md:mb-16">
                    <span class="text-xs font-bold uppercase tracking-[0.2em] text-honda-red">Đánh giá</span>
                    <h2 class="text-3xl md:text-4xl font-bold text-honda-dark mt-2 tracking-tight">Khách hàng tin chọn Hiếu Nga</h2>
                </div>
                <div class="grid md:grid-cols-3 gap-6 md:gap-8">
                    @foreach (var review in d.Testimonials)
                    {
                        var parts = review.CustomerName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        var initials = parts.Length >= 2
                            ? $"{parts[0][0]}{parts[^1][0]}"
                            : (parts.Length > 0 ? parts[0][..Math.Min(2, parts[0].Length)] : "?");
                        <div class="home-testimonial-card bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col">
                            <div class="flex text-amber-400 gap-0.5 mb-4">
                                @for (int i = 0; i < review.Rating; i++) { <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg> }
                            </div>
                            <p class="text-gray-600 leading-relaxed flex-1 text-[15px]">"@review.Content"</p>
                            <div class="flex items-center gap-4 mt-8 pt-6 border-t border-gray-100">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-honda-red to-red-700 flex items-center justify-center text-white font-bold text-sm">
                                    @initials.ToUpper()
                                </div>
                                <div>
                                    <p class="font-bold text-honda-dark">@review.CustomerName</p>
                                    @if (!string.IsNullOrEmpty(review.MotorcycleName))
                                    {
                                        <p class="text-xs text-gray-400 mt-0.5">@review.MotorcycleName</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @* ═══ FINAL CTA ═══ *@
    <section class="pb-20 md:pb-28">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-honda-red to-red-700 p-10 md:p-16 text-center text-white">
                <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=1200&q=80')] bg-cover bg-center opacity-10"></div>
                <div class="relative max-w-2xl mx-auto">
                    <h2 class="text-2xl md:text-4xl font-bold tracking-tight">Sẵn sàng trải nghiệm Honda?</h2>
                    <p class="mt-4 text-white/80 text-base md:text-lg">Đặt lái thử hoặc ghé showroom HEAD Đà Nẵng hôm nay</p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
                        <a href="/dat-lich-lai-thu" class="px-8 py-4 bg-white text-honda-red font-bold rounded-xl hover:bg-gray-100 transition shadow-lg">Đặt lái thử</a>
                        <a href="tel:0905123456" class="px-8 py-4 bg-white/10 backdrop-blur border border-white/30 font-bold rounded-xl hover:bg-white/20 transition">0905 123 456</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
