@page
@model HieuNga.Web.Pages.IndexModel
@using HieuNga.Domain
@using HieuNga.Web.Filters
@using HieuNga.Web.Extensions
@{
    var d = Model.Data;
    var site = SiteSettingsViewData.Get(ViewData);
    var telHref = SiteSettingsViewData.TelHref(site);
    var featuredBikes = d.FeaturedMotorcycles.Take(6).ToList();
    var headBranch = d.Branches.FirstOrDefault(b => b.IsHeadOffice) ?? d.Branches.FirstOrDefault();
    var hotline = headBranch?.Hotline ?? headBranch?.Phone ?? site.Hotline;
    var hotlineTel = new string(hotline.Where(char.IsDigit).ToArray());
    if (string.IsNullOrEmpty(hotlineTel)) hotlineTel = new string(site.Hotline.Where(char.IsDigit).ToArray());
    var zaloUrl = string.IsNullOrWhiteSpace(site.ZaloUrl) ? "https://zalo.me/" : site.ZaloUrl;
    var newsPosts = d.LatestPosts.ToList();
    var featuredPost = newsPosts.FirstOrDefault();
    var sidePosts = newsPosts.Skip(1).Take(3).ToList();
    ViewData["BranchBookUrl"] = "/dat-lich-lai-thu?source=homepage";
    ViewData["BranchBookLabel"] = "Đặt lịch hẹn";
}

@section Head {
    @if (d.Hero.Enabled && d.Hero.Slides.Count > 0)
    {
        <link rel="preload" as="image" href="@d.Hero.Slides[0].ImageUrl" fetchpriority="high" />
        @if (d.Hero.Slides.Count > 1)
        {
            <link rel="preload" as="image" href="@d.Hero.Slides[1].ImageUrl" fetchpriority="low" />
        }
    }
}

<div class="homepage bg-white overflow-x-hidden">
    @* ─── Homepage hero carousel ─── *@
    <partial name="_HomeHero" model="d.Hero" />

    @* Quick actions *@
    <section class="home-quick reveal" aria-label="Lối tắt">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="home-quick-grid">
                <a href="/xe" class="home-quick-card touch-press">
                    <span class="home-quick-icon" aria-hidden="true">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h8a1 1 0 001-1v-3m4-6h2l3 4v5a1 1 0 01-1 1h-1"/></svg>
                    </span>
                    <span class="home-quick-label">Mua xe</span>
                </a>
                <a href="/dich-vu" class="home-quick-card touch-press">
                    <span class="home-quick-icon" aria-hidden="true">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </span>
                    <span class="home-quick-label">Dịch vụ</span>
                </a>
                <a href="/lien-he" class="home-quick-card touch-press">
                    <span class="home-quick-icon" aria-hidden="true">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    </span>
                    <span class="home-quick-label">Liên hệ</span>
                </a>
            </div>
        </div>
    </section>

    @* ─── PHASE 2: Category Experience ─── *@
    <section class="page-section reveal" aria-labelledby="home-cat-heading">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-10">
                <div>
                    <p class="section-eyebrow">Danh mục</p>
                    <h2 id="home-cat-heading" class="section-title">Khám phá theo dòng xe</h2>
                    <p class="section-subtitle">Xe tay ga · Xe số · Xe côn tay · Xe phân khối lớn · Xe điện</p>
                </div>
            </div>
            <div class="home-cat-grid">
                @{ var ci = 0; }
                @foreach (var cat in d.CategoryCounts)
                {
                    var delay = "reveal-delay-" + ((ci % 3) + 1);
                    var countLabel = cat.Count > 0 ? $"{cat.Count} mẫu" : "Đang cập nhật";
                    <a href="/xe?category=@((int)cat.Category)"
                       class="home-cat-card touch-press group reveal reveal-scale @delay">
                        <div class="home-cat-media img-wrap">
                            @if (!string.IsNullOrWhiteSpace(cat.ImageUrl))
                            {
                                <img src="@cat.ImageUrl"
                                     alt="@cat.Label"
                                     class="home-cat-img img-media"
                                     width="640" height="480"
                                     loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <div class="home-cat-placeholder" aria-hidden="true">
                                    <span>@cat.Label.Substring(0, 1)</span>
                                </div>
                            }
                            <div class="home-cat-overlay" aria-hidden="true"></div>
                        </div>
                        <div class="home-cat-body">
                            <span class="home-cat-count">@countLabel</span>
                            <h3 class="home-cat-title">@cat.Label</h3>
                            <span class="home-cat-cta">Khám phá</span>
                        </div>
                    </a>
                    ci++;
                }
            </div>
        </div>
    </section>

    @* ─── PHASE 3: Featured Showcase ─── *@
    @if (featuredBikes.Any())
    {
        <section class="page-section bg-gray-50 border-y border-gray-100 reveal" aria-labelledby="home-featured-heading">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-10">
                    <div>
                        <p class="section-eyebrow">Showroom</p>
                        <h2 id="home-featured-heading" class="section-title">Xe nổi bật</h2>
                        <p class="section-subtitle">Mẫu xe đang được quan tâm tại Xe Máy Hiếu Nga</p>
                    </div>
                    <a href="/xe" class="text-sm font-semibold text-honda-red hover:underline focus-ring rounded shrink-0">Xem danh mục xe →</a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" data-stagger>
                    @foreach (var bike in featuredBikes)
                    {
                        <partial name="_HomeFeaturedCard" model="bike" />
                    }
                </div>
            </div>
        </section>
    }

    @* ─── Services (experience cards) ─── *@
    <section class="page-section bg-gray-50 border-y border-gray-100 reveal" aria-labelledby="home-svc-heading">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-10">
                <div>
                    <p class="section-eyebrow">Xưởng dịch vụ</p>
                    <h2 id="home-svc-heading" class="section-title">Dịch vụ Honda</h2>
                    <p class="section-subtitle">Sáu trải nghiệm dịch vụ — quy trình chuẩn Honda</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="/bao-duong#booking" class="btn-primary touch-press text-sm">Đặt lịch dịch vụ</a>
                    <a href="/dich-vu" class="text-sm font-semibold text-honda-red hover:underline focus-ring rounded self-center">Xem tất cả →</a>
                </div>
            </div>
            <div class="svc-card-grid" data-stagger>
                @if (d.Services.Any())
                {
                    @foreach (var svc in d.Services.Take(6))
                    {
                        <partial name="_ServiceExperienceCard" model="svc" />
                    }
                }
                else
                {
                    <div class="empty-state sm:col-span-2 lg:col-span-3">
                        <h3>Dịch vụ đang cập nhật</h3>
                        <p>Liên hệ showroom để được tư vấn bảo dưỡng.</p>
                        <a href="/bao-duong#booking" class="btn-primary mt-6 inline-flex">Đặt lịch dịch vụ</a>
                    </div>
                }
            </div>
        </div>
    </section>

    @* ─── PHASE 7: Latest Promotions (horizontal carousel) ─── *@
    @if (d.Promotions.Any())
    {
        <section class="page-section reveal" aria-labelledby="home-promo-heading">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8">
                    <div>
                        <p class="section-eyebrow">Ưu đãi</p>
                        <h2 id="home-promo-heading" class="section-title">Khuyến mãi đang diễn ra</h2>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="home-carousel-nav" data-promo-nav>
                            <button type="button" class="home-carousel-btn" data-promo-prev aria-label="Khuyến mãi trước">‹</button>
                            <button type="button" class="home-carousel-btn" data-promo-next aria-label="Khuyến mãi sau">›</button>
                        </div>
                        <a href="/khuyen-mai" class="text-sm font-semibold text-honda-red hover:underline focus-ring rounded">Tất cả →</a>
                    </div>
                </div>
                <div class="home-promo-rail" data-promo-rail tabindex="0" aria-label="Danh sách khuyến mãi">
                    @foreach (var promo in d.Promotions)
                    {
                        var endIso = promo.EndDate.ToString("o");
                        <a href="/khuyen-mai/@promo.Slug" class="home-promo-slide group">
                            <div class="home-promo-media img-wrap">
                                @if (!string.IsNullOrWhiteSpace(promo.ImageUrl))
                                {
                                    <img src="@promo.ImageUrl"
                                         alt="@promo.Title"
                                         class="img-media home-promo-img"
                                         width="960" height="540"
                                         loading="lazy" decoding="async" />
                                }
                                <div class="home-promo-shade" aria-hidden="true"></div>
                                <span class="home-promo-countdown" data-countdown="@endIso" aria-label="Thời hạn khuyến mãi">
                                    Đến @promo.EndDate.ToString("dd/MM")
                                </span>
                            </div>
                            <div class="home-promo-body">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-honda-red">@promo.Type</span>
                                <h3 class="mt-1 text-lg md:text-xl font-bold text-honda-dark group-hover:text-honda-red transition-colors line-clamp-2">@promo.Title</h3>
                                @if (!string.IsNullOrEmpty(promo.Summary))
                                {
                                    <p class="mt-2 text-sm text-gray-500 line-clamp-2">@promo.Summary</p>
                                }
                            </div>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    @* ─── PHASE 8: News (magazine) ─── *@
    @if (featuredPost is not null)
    {
        <section class="page-section bg-gray-50 border-y border-gray-100 reveal reveal-right" aria-labelledby="home-news-heading">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-10">
                    <div>
                        <p class="section-eyebrow">Tin tức</p>
                        <h2 id="home-news-heading" class="section-title">Góc tạp chí Hiếu Nga</h2>
                    </div>
                    <a href="/tin-tuc" class="text-sm font-semibold text-honda-red hover:underline focus-ring rounded">Xem tất cả tin →</a>
                </div>
                <div class="home-news-magazine">
                    @{
                        var featuredRead = Math.Max(1, ((featuredPost.Summary?.Length ?? 180) + 400) / 400);
                    }
                    <a href="/tin-tuc/@featuredPost.Slug" class="home-news-feature group">
                        <div class="home-news-feature-media img-wrap">
                            @if (!string.IsNullOrWhiteSpace(featuredPost.ThumbnailUrl))
                            {
                                <img src="@featuredPost.ThumbnailUrl"
                                     alt="@featuredPost.Title"
                                     class="img-media home-news-feature-img"
                                     width="1200" height="750"
                                     loading="lazy" decoding="async" />
                            }
                        </div>
                        <div class="home-news-feature-body">
                            <div class="home-news-meta">
                                @if (featuredPost.PublishedAt.HasValue)
                                {
                                    <time datetime="@featuredPost.PublishedAt.Value.ToString("yyyy-MM-dd")">@featuredPost.PublishedAt.Value.ToString("dd/MM/yyyy")</time>
                                }
                                <span aria-hidden="true">·</span>
                                <span>@featuredRead phút đọc</span>
                            </div>
                            <h3 class="home-news-feature-title">@featuredPost.Title</h3>
                            @if (!string.IsNullOrEmpty(featuredPost.Summary))
                            {
                                <p class="home-news-feature-summary">@featuredPost.Summary</p>
                            }
                            <span class="home-news-read">Đọc bài →</span>
                        </div>
                    </a>
                    <div class="home-news-side">
                        @foreach (var post in sidePosts)
                        {
                            var readMins = Math.Max(1, ((post.Summary?.Length ?? 120) + 300) / 350);
                            <a href="/tin-tuc/@post.Slug" class="home-news-side-card group">
                                <div class="home-news-side-media img-wrap">
                                    @if (!string.IsNullOrWhiteSpace(post.ThumbnailUrl))
                                    {
                                        <img src="@post.ThumbnailUrl"
                                             alt="@post.Title"
                                             class="img-media"
                                             width="320" height="220"
                                             loading="lazy" decoding="async" />
                                    }
                                </div>
                                <div>
                                    <div class="home-news-meta">
                                        @if (post.PublishedAt.HasValue)
                                        {
                                            <time datetime="@post.PublishedAt.Value.ToString("yyyy-MM-dd")">@post.PublishedAt.Value.ToString("dd/MM/yyyy")</time>
                                        }
                                        <span aria-hidden="true">·</span>
                                        <span>@readMins phút</span>
                                    </div>
                                    <h3 class="home-news-side-title">@post.Title</h3>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </section>
    }

    @* ─── PHASE 9: Customer Reviews slider ─── *@
    @if (d.Testimonials.Any())
    {
        <section class="page-section reveal" aria-labelledby="home-review-heading">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8">
                    <div>
                        <p class="section-eyebrow">Khách hàng</p>
                        <h2 id="home-review-heading" class="section-title">Đánh giá từ khách hàng</h2>
                    </div>
                    <div class="home-carousel-nav" data-review-nav>
                        <button type="button" class="home-carousel-btn" data-review-prev aria-label="Đánh giá trước">‹</button>
                        <button type="button" class="home-carousel-btn" data-review-next aria-label="Đánh giá sau">›</button>
                    </div>
                </div>
                <div class="home-review-slider"
                     data-review-slider
                     data-interval="5500"
                     aria-roledescription="carousel"
                     aria-label="Đánh giá khách hàng"
                     tabindex="0">
                    <div class="home-review-track" data-review-track>
                        @foreach (var review in d.Testimonials)
                        {
                            var initials = string.Concat(review.CustomerName
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .TakeLast(2)
                                .Select(p => char.ToUpperInvariant(p[0])));
                            if (string.IsNullOrEmpty(initials)) initials = "?";
                            <blockquote class="home-review-slide" data-review-slide>
                                <div class="home-review-stars" aria-label="@review.Rating sao">
                                    @for (var s = 0; s < review.Rating; s++)
                                    {
                                        <span aria-hidden="true">★</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Title))
                                {
                                    <p class="home-review-title">@review.Title</p>
                                }
                                <p class="home-review-content">“@review.Content”</p>
                                <footer class="home-review-footer">
                                    <span class="home-review-avatar" aria-hidden="true">@initials</span>
                                    <div>
                                        <cite class="home-review-name">@review.CustomerName</cite>
                                        <p class="home-review-branch">
                                            @(headBranch?.Name ?? site.SiteName)
                                            @if (!string.IsNullOrWhiteSpace(review.MotorcycleName))
                                            {
                                                <span> · @review.MotorcycleName</span>
                                            }
                                        </p>
                                    </div>
                                </footer>
                            </blockquote>
                        }
                    </div>
                    <div class="home-review-dots" data-review-dots role="tablist" aria-label="Chọn đánh giá"></div>
                </div>
            </div>
        </section>
    }

    @* ─── PHASE 10: Branches ─── *@
    <section class="page-section bg-gray-50 border-t border-gray-100 reveal" aria-labelledby="home-branch-heading">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="section-eyebrow">Showroom</p>
            <h2 id="home-branch-heading" class="section-title">Chi nhánh &amp; liên hệ</h2>
            <p class="section-subtitle">
                <span data-counter="@Math.Max(1, d.Branches.Count)" data-counter-suffix="">0</span> điểm Xe Máy Hiếu Nga tại Hải Châu, Đà Nẵng
            </p>

            <div class="mt-10">
                <partial name="_BranchCards" model="d.Branches" />
            </div>

            @{
                var mapBranch = d.Branches.FirstOrDefault(b => !string.IsNullOrWhiteSpace(b.MapEmbedUrl)) ?? headBranch;
            }
            @if (!string.IsNullOrWhiteSpace(mapBranch?.MapEmbedUrl))
            {
                <div class="home-branch-map-wrap mt-8">
                    <div class="home-branch-map">
                        <iframe src="@mapBranch!.MapEmbedUrl"
                                title="Bản đồ @(mapBranch.Name)"
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                allowfullscreen></iframe>
                    </div>
                </div>
            }
            else
            {
                <div class="home-branch-map-wrap mt-8">
                    <div class="home-branch-map home-branch-map-fallback" aria-hidden="true">
                        <div class="home-branch-map-placeholder">
                            <svg class="w-10 h-10 text-honda-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <p>Xe Máy Hiếu Nga · Hải Châu, Đà Nẵng</p>
                        </div>
                    </div>
                </div>
            }

            <div class="mt-6 flex flex-wrap gap-3">
                <a href="/lien-he?intent=mua-xe&amp;source=homepage-branch" class="btn-secondary">Tư vấn mua xe</a>
                <a href="@zaloUrl" target="_blank" rel="noopener noreferrer" hx-boost="false" class="btn-ghost">Chat Zalo</a>
            </div>
        </div>
    </section>
</div>

<script src="~/js/homepage.js" asp-append-version="true"></script>
