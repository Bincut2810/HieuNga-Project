@page
@model HieuNga.Web.Pages.IndexModel
@{
    var d = Model.Data;
    var featuredBikes = d.FeaturedMotorcycles.Take(4).ToList();
    var headBranch = d.Branches.FirstOrDefault(b => b.IsHeadOffice) ?? d.Branches.FirstOrDefault();
    var hotline = headBranch?.Hotline ?? headBranch?.Phone ?? "0905 123 456";
    var hotlineTel = new string(hotline.Where(char.IsDigit).ToArray());
    if (string.IsNullOrEmpty(hotlineTel)) hotlineTel = "0905123456";
}

<div class="homepage bg-white overflow-x-hidden">
    @* ─── 1. Hero ─── *@
    <section class="border-b border-gray-100 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 md:py-16">
            <div class="max-w-3xl">
                <p class="text-xs font-bold uppercase tracking-widest text-honda-red">Honda HEAD · Đà Nẵng</p>
                <h1 class="mt-3 text-2xl sm:text-3xl md:text-4xl font-bold text-honda-dark leading-tight tracking-tight">
                    Xe Máy Hiếu Nga — Mua xe &amp; dịch vụ sửa chữa, bảo dưỡng uy tín
                </h1>
                <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl">
                    Tư vấn xe Honda, hỗ trợ trả góp, đặt lịch bảo dưỡng và sửa chữa nhanh tại Xe Máy Hiếu Nga.
                </p>
                <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3">
                    <a href="/xe" class="btn-primary px-6 py-3.5 text-center justify-center">Xem xe đang bán</a>
                    <a href="/bao-duong#booking" class="btn-secondary px-6 py-3.5 text-center justify-center">Đặt lịch dịch vụ</a>
                </div>
                <a href="tel:@hotlineTel" class="inline-flex items-center gap-2 mt-4 text-sm font-semibold text-gray-600 hover:text-honda-red transition">
                    <svg class="w-4 h-4 text-honda-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    Gọi hotline @hotline
                </a>
            </div>
        </div>
    </section>

    @* ─── 2. Two core business cards ─── *@
    <section class="py-10 md:py-14">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-2 gap-5 md:gap-6">
                <div class="rounded-2xl border border-gray-100 bg-white p-6 md:p-8 shadow-sm">
                    <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center text-honda-red mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h8a1 1 0 001-1v-3m4-6h2l3 4v5a1 1 0 01-1 1h-1"/></svg>
                    </div>
                    <h2 class="text-xl font-bold text-honda-dark">Mua xe Honda</h2>
                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                        Xem mẫu xe đang bán, giá niêm yết, hỗ trợ trả góp và tư vấn chọn xe phù hợp tại showroom HEAD.
                    </p>
                    <a href="/xe" class="inline-flex items-center gap-2 mt-5 text-sm font-semibold text-honda-red hover:underline">
                        Xem danh sách xe
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
                <div class="rounded-2xl border border-gray-100 bg-white p-6 md:p-8 shadow-sm">
                    <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center text-honda-dark mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </div>
                    <h2 class="text-xl font-bold text-honda-dark">Sửa chữa / bảo dưỡng</h2>
                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                        Bảo dưỡng định kỳ, thay nhớt, kiểm tra động cơ, điện, phanh và phụ tùng chính hãng Honda.
                    </p>
                    <a href="/bao-duong#booking" class="inline-flex items-center gap-2 mt-5 text-sm font-semibold text-honda-red hover:underline">
                        Đặt lịch dịch vụ
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    @* ─── 3. Featured motorcycles ─── *@
    @if (featuredBikes.Any())
    {
        <section class="py-10 md:py-14 bg-gray-50 border-y border-gray-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
                    <div>
                        <h2 class="text-2xl md:text-3xl font-bold text-honda-dark tracking-tight">Xe nổi bật</h2>
                        <p class="mt-2 text-sm text-gray-500">Mẫu xe Honda phổ biến tại showroom Hiếu Nga</p>
                    </div>
                    <a href="/xe" class="text-sm font-semibold text-honda-red hover:underline shrink-0">Xem tất cả xe →</a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
                    @foreach (var bike in featuredBikes)
                    {
                        <partial name="_MotorcycleCard" model="bike" />
                    }
                </div>
            </div>
        </section>
    }

    @* ─── 4. Service categories ─── *@
    <section class="py-10 md:py-14">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-8">
                <h2 class="text-2xl md:text-3xl font-bold text-honda-dark tracking-tight">Dịch vụ xưởng HEAD</h2>
                <p class="mt-2 text-sm text-gray-500">Sửa chữa và bảo dưỡng xe máy Honda chính hãng</p>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
                @{
                    var serviceItems = new[]
                    {
                        ("Bảo dưỡng định kỳ", "Kiểm tra tổng thể theo km, đảm bảo xe vận hành ổn định."),
                        ("Thay nhớt", "Nhớt chính hãng Honda, thay đúng quy trình và định mức."),
                        ("Kiểm tra động cơ", "Chẩn đoán tiếng động, hao mòn và hiệu suất động cơ."),
                        ("Điện / bình ắc quy", "Kiểm tra hệ thống điện, đèn, còi và bình ắc quy."),
                        ("Phanh / lốp", "Bảo dưỡng phanh, thay má phanh và kiểm tra lốp an toàn."),
                        ("Phụ tùng chính hãng", "Linh kiện Honda chính hãng, minh bạch báo giá trước khi thay.")
                    };
                }
                @foreach (var (title, desc) in serviceItems)
                {
                    <div class="rounded-xl border border-gray-100 bg-white p-5 md:p-6">
                        <h3 class="font-bold text-honda-dark text-sm md:text-base">@title</h3>
                        <p class="mt-2 text-sm text-gray-500 leading-relaxed">@desc</p>
                    </div>
                }
            </div>
            <div class="mt-8 text-center sm:text-left">
                <a href="/bao-duong#booking" class="btn-primary inline-flex justify-center">Đặt lịch sửa chữa / bảo dưỡng</a>
            </div>
        </div>
    </section>

    @* ─── 5. Why choose ─── *@
    <section class="py-10 md:py-14 bg-gray-50 border-y border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl md:text-3xl font-bold text-honda-dark tracking-tight">Vì sao chọn Xe Máy Hiếu Nga?</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mt-8">
                @{
                    var trustPoints = new[]
                    {
                        ("HEAD Honda uy tín", "Đại lý hạng cao trong hệ thống Honda Việt Nam."),
                        ("Kỹ thuật viên chuyên môn", "Đội ngũ được đào tạo quy trình chuẩn Honda."),
                        ("Phụ tùng chính hãng", "Linh kiện và nhớt Honda 100% chính hãng."),
                        ("Tư vấn rõ ràng", "Báo giá minh bạch, hỗ trợ nhanh qua hotline và Zalo.")
                    };
                }
                @foreach (var (title, desc) in trustPoints)
                {
                    <div class="rounded-xl border border-gray-100 bg-white p-5">
                        <span class="flex w-8 h-8 rounded-full bg-red-50 text-honda-red items-center justify-center text-sm font-bold mb-3">✓</span>
                        <h3 class="font-bold text-honda-dark text-sm">@title</h3>
                        <p class="mt-2 text-xs sm:text-sm text-gray-500 leading-relaxed">@desc</p>
                    </div>
                }
            </div>
        </div>
    </section>

    @* ─── 6. Quick contact CTA ─── *@
    <section class="py-10 md:py-14">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="rounded-2xl border border-gray-100 bg-white p-6 md:p-10 shadow-sm text-center md:text-left">
                <h2 class="text-xl md:text-2xl font-bold text-honda-dark">Cần tư vấn nhanh?</h2>
                <p class="mt-2 text-sm text-gray-500 max-w-xl md:mx-0 mx-auto">
                    Liên hệ đội ngũ Xe Máy Hiếu Nga để được tư vấn mua xe hoặc đặt lịch dịch vụ.
                </p>
                <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3 justify-center md:justify-start">
                    <a href="/lien-he?intent=mua-xe" class="btn-primary justify-center">Tư vấn mua xe</a>
                    <a href="/bao-duong#booking" class="btn-secondary justify-center">Đặt lịch dịch vụ</a>
                    <a href="tel:@hotlineTel" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-honda-dark border border-gray-200 rounded-lg hover:border-honda-red hover:text-honda-red transition">
                        Gọi ngay
                    </a>
                </div>
            </div>
        </div>
    </section>

    @* ─── 7. Branch / contact ─── *@
    <section class="py-10 md:py-14 bg-gray-50 border-t border-gray-100 pb-16 md:pb-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-bold text-honda-dark tracking-tight">Showroom &amp; liên hệ</h2>
            @if (headBranch is not null)
            {
                <div class="mt-6 rounded-2xl border border-gray-100 bg-white p-6 md:p-8 max-w-2xl">
                    @if (headBranch.IsHeadOffice)
                    {
                        <span class="text-[10px] font-bold uppercase tracking-widest text-honda-red">HEAD Office</span>
                    }
                    <h3 class="text-lg font-bold text-honda-dark mt-1">@headBranch.Name</h3>
                    <p class="mt-2 text-sm text-gray-600">@headBranch.Address</p>
                    @if (!string.IsNullOrEmpty(headBranch.OpeningHours))
                    {
                        <p class="mt-2 text-sm text-gray-500">@headBranch.OpeningHours</p>
                    }
                    <p class="mt-4">
                        <a href="tel:@hotlineTel" class="text-honda-red font-bold hover:underline">@hotline</a>
                    </p>
                </div>
            }
            else
            {
                <div class="mt-6 rounded-2xl border border-gray-100 bg-white p-6 md:p-8 max-w-2xl">
                    <h3 class="text-lg font-bold text-honda-dark">Xe Máy Hiếu Nga Đà Nẵng</h3>
                    <p class="mt-2 text-sm text-gray-600">123 Nguyễn Văn Linh, Đà Nẵng</p>
                    <p class="mt-2 text-sm text-gray-500">T2–T7: 8:00–18:00 · CN: 8:00–17:00</p>
                    <p class="mt-4">
                        <a href="tel:0905123456" class="text-honda-red font-bold hover:underline">0905 123 456</a>
                    </p>
                </div>
            }
            <a href="/lien-he" class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-honda-red hover:underline">
                Xem thông tin liên hệ
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
        </div>
    </section>
</div>
