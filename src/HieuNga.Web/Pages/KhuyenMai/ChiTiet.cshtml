@page "/khuyen-mai/{slug}"
@model HieuNga.Web.Pages.KhuyenMai.ChiTietModel
@{
    var p = Model.Promotion!;
}

<section class="relative min-h-[40vh] flex items-end overflow-hidden bg-honda-dark">
    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
    {
        <img src="@p.ImageUrl" alt="@p.Title" class="absolute inset-0 w-full h-full object-cover opacity-50" />
    }
    <div class="absolute inset-0 bg-gradient-to-t from-honda-dark to-transparent"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 w-full">
        <nav class="text-sm text-gray-400 mb-4">
            <a href="/khuyen-mai" class="hover:text-white">Khuyến mãi</a> / <span class="text-white">@p.Title</span>
        </nav>
        <span class="text-xs font-bold text-honda-red bg-white/10 px-3 py-1 rounded uppercase">@p.Type</span>
        <h1 class="text-3xl md:text-5xl font-bold text-white mt-4 max-w-4xl">@p.Title</h1>
        @if (!string.IsNullOrEmpty(p.Summary))
        {
            <p class="text-gray-300 mt-4 text-lg max-w-2xl">@p.Summary</p>
        }
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
            @if (!string.IsNullOrEmpty(p.Content))
            {
                <div class="prose prose-lg max-w-none text-gray-600">
                    @Html.Raw(p.Content)
                </div>
            }
            @if (p.DiscountAmount.HasValue || p.DiscountPercent.HasValue)
            {
                <div class="mt-8 p-6 bg-red-50 rounded-2xl border border-red-100">
                    <p class="font-bold text-honda-red text-lg">
                        @if (p.DiscountAmount.HasValue) { <span>Giảm @p.DiscountAmount.Value.ToVnd()</span> }
                        @if (p.DiscountPercent.HasValue) { <span>Giảm @p.DiscountPercent%</span> }
                    </p>
                </div>
            }
        </div>
        <aside class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border">
                <p class="text-sm text-gray-500">Thời gian</p>
                <p class="font-semibold mt-1">@p.StartDate.ToString("dd/MM/yyyy") — @p.EndDate.ToString("dd/MM/yyyy")</p>
            </div>
            @if (!string.IsNullOrEmpty(p.MotorcycleSlug))
            {
                <a href="/xe/@p.MotorcycleSlug" class="block bg-white border rounded-2xl p-6 hover:border-honda-red transition">
                    <p class="text-sm text-gray-500">Áp dụng cho</p>
                    <p class="font-bold text-lg mt-1">@p.MotorcycleName</p>
                    <span class="text-honda-red text-sm font-semibold mt-2 inline-block">Xem xe →</span>
                </a>
            }
            <a href="/dat-lich-lai-thu?source=promotion" class="btn-primary w-full text-center">Đặt lái thử</a>
            <a href="/lien-he?intent=khuyen-mai&amp;source=promotion" class="btn-secondary w-full text-center">Tư vấn ngay</a>
        </aside>
    </div>
</section>

<partial name="_CtaBanner" />
