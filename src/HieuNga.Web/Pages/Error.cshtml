@page "/Error"
@model HieuNga.Web.Pages.ErrorModel
<section class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center">
        <h1 class="text-6xl font-bold text-honda-red">@(Model.HttpStatusCode)</h1>
        <p class="text-xl text-gray-600 mt-4">@Model.Message</p>
        <a href="/" class="btn-primary mt-8 inline-flex">Về trang chủ</a>
    </div>
</section>
