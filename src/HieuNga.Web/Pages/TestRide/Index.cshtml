@page "/dat-lich-lai-thu"
@model HieuNga.Web.Pages.TestRide.IndexModel
@using HieuNga.Application.TestRide
@using HieuNga.Web.ViewModels.TestRide
@{
    ViewData["Title"] = Model.Success ? "Đặt lịch thành công" : "Đặt lịch xem xe";
    ViewData["MetaTitle"] = Model.Success
        ? "Đặt lịch thành công | Xe Máy Hiếu Nga"
        : "Đặt lịch xem xe | Xe Máy Hiếu Nga";
}

@section Head {
    <link rel="stylesheet" href="~/css/test-ride.css" asp-append-version="true" />
}

<link rel="stylesheet" href="~/css/test-ride.css" asp-append-version="true" data-tr-css />

<section class="tr-page" data-tr-page>
    <div class="tr-shell">
        @if (Model.Success)
        {
            <div class="tr-success-static" role="status" aria-live="polite">
                <div class="tr-modal-icon tr-modal-icon-ok" aria-hidden="true">✓</div>
                <h1 class="tr-heading">Đặt lịch thành công</h1>
                <p class="tr-received">@Model.SuccessReceivedAt</p>
                <div class="tr-success-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.SuccessCustomerName))
                    {
                        <p><strong>@Model.SuccessCustomerName</strong></p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SuccessMotorcycleName))
                    {
                        <p>@Model.SuccessMotorcycleName</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SuccessAppointmentDate))
                    {
                        <p>@Model.SuccessAppointmentDate · @Model.SuccessAppointmentTime</p>
                    }
                </div>
                <p class="tr-sub">
                    @(Model.IsDuplicate
                        ? IndexModel.DuplicateMessage
                        : "Cảm ơn bạn đã đăng ký. Nhân viên sẽ sớm liên hệ xác nhận lịch hẹn.")
                </p>
                <div class="tr-actions" style="margin-top:1.25rem">
                    <a href="@Model.SuccessMotorcycleUrl" class="tr-btn tr-btn-primary">Tiếp tục xem xe</a>
                </div>
            </div>
        }
        else
        {
            <h1 class="tr-heading">Đặt lịch xem xe</h1>
            <p class="tr-sub">Chỉ mất khoảng 30 giây để hoàn tất.</p>

            <div asp-validation-summary="ModelOnly" class="tr-errors" role="alert"></div>

            <partial name="_TestRideBookingForm" model="Model.Form" />
        }
    </div>
</section>

@if (!Model.Success)
{
    <partial name="_TestRideBookingModals" />
}

@section Scripts {
    <script src="~/js/test-ride.js" asp-append-version="true"></script>
}
