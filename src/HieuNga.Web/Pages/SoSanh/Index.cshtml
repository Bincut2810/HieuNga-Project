@page "/so-sanh"
@model HieuNga.Web.Pages.SoSanh.IndexModel

<partial name="_PageHero" model='("So sánh xe", "Chọn tối đa 3 mẫu xe để so sánh giá và thông số", "Compare")' />

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    @if (!Model.Motorcycles.Any())
    {
        <div class="text-center py-20 bg-gray-50 rounded-3xl border border-dashed">
            <p class="text-gray-500 text-lg">Chưa có xe trong danh sách so sánh.</p>
            <p class="text-sm text-gray-400 mt-2">Vào trang chi tiết xe và nhấn <strong>+ So sánh</strong></p>
            <a href="/xe" class="btn-primary mt-8 inline-flex">Khám phá xe</a>
        </div>
    }

    <div id="compare-table">
        <partial name="_CompareTable" model="Model.Motorcycles" />
    </div>
</section>
