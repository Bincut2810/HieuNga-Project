@page "/admin/cai-dat"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.CaiDat.IndexModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Cài đặt site")' />

<form method="post" class="admin-form-card" style="max-width: 48rem;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="admin-validation-summary"></div>
    <div class="admin-form-stack">
        <div>
            <label asp-for="Input.SiteName" class="admin-label">Tên site *</label>
            <input asp-for="Input.SiteName" class="admin-input" />
        </div>
        <div class="admin-grid-2">
            <div>
                <label asp-for="Input.Hotline" class="admin-label">Hotline *</label>
                <input asp-for="Input.Hotline" class="admin-input" />
            </div>
            <div>
                <label asp-for="Input.Phone" class="admin-label">Điện thoại *</label>
                <input asp-for="Input.Phone" class="admin-input" />
            </div>
        </div>
        <div class="admin-grid-2">
            <div>
                <label asp-for="Input.Email" class="admin-label">Email *</label>
                <input asp-for="Input.Email" class="admin-input" />
            </div>
            <div>
                <label asp-for="Input.ZaloUrl" class="admin-label">Zalo URL</label>
                <input asp-for="Input.ZaloUrl" class="admin-input" />
            </div>
        </div>
        <div>
            <label asp-for="Input.Address" class="admin-label">Địa chỉ *</label>
            <input asp-for="Input.Address" class="admin-input" />
        </div>
        <div>
            <label asp-for="Input.OpeningHours" class="admin-label">Giờ mở cửa</label>
            <input asp-for="Input.OpeningHours" class="admin-input" />
        </div>
        <div>
            <label asp-for="Input.DefaultMetaTitle" class="admin-label">SEO title mặc định</label>
            <input asp-for="Input.DefaultMetaTitle" class="admin-input" />
        </div>
        <div>
            <label asp-for="Input.DefaultMetaDescription" class="admin-label">SEO description mặc định</label>
            <textarea asp-for="Input.DefaultMetaDescription" rows="2" class="admin-textarea"></textarea>
        </div>
        <div>
            <label asp-for="Input.FacebookUrl" class="admin-label">Facebook URL</label>
            <input asp-for="Input.FacebookUrl" class="admin-input" />
        </div>
        <div>
            <label asp-for="Input.FooterText" class="admin-label">Footer text</label>
            <input asp-for="Input.FooterText" class="admin-input" />
        </div>
        <div>
            <label asp-for="Input.ServicePricingDisclaimer" class="admin-label">Disclaimer bảng giá dịch vụ</label>
            <textarea asp-for="Input.ServicePricingDisclaimer" rows="3" class="admin-textarea"></textarea>
        </div>
    </div>
    <div class="admin-form-actions">
        <button type="submit" class="admin-btn admin-btn-primary">Lưu cài đặt</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
