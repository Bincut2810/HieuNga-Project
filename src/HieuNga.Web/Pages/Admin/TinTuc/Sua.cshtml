@page "/admin/tin-tuc/sua/{id:guid}"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.TinTucSuaModel
@{
    var editId = RouteData.Values["id"] as string;
}

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Sửa bài viết")' />

<form method="post" class="admin-form-card" style="max-width: 48rem;">
    @Html.AntiForgeryToken()
    <partial name="Admin/Shared/_BlogPostForm" model="Model" />
    <div class="admin-form-actions">
        <a href="/admin/tin-tuc" class="admin-btn admin-btn-ghost">Hủy</a>
        <button type="submit" class="admin-btn admin-btn-primary">Lưu thay đổi</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(editId))
{
    <form method="post" asp-page-handler="Delete" class="admin-form-card" style="max-width: 48rem; margin-top: 1.5rem; border-color: rgba(185, 28, 28, 0.25);"
          data-confirm-form data-confirm-title="Xóa bài viết?" data-confirm-body="Bạn có chắc muốn xóa bài viết này không? Bài viết sẽ bị ẩn khỏi website." data-confirm-ok="Xóa bài" data-confirm-cancel="Hủy" data-confirm-danger="true">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@editId" />
        <h2 class="admin-form-section-title" style="color: #B91C1C;">Xóa bài viết</h2>
        <p class="admin-hint" style="margin: 0.5rem 0 1rem;">Bài viết sẽ bị ẩn khỏi danh sách bài viết và trang chủ. Bạn có thể khôi phục lại trong cơ sở dữ liệu nếu cần.</p>
        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-danger">Xóa bài viết</button>
        </div>
    </form>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
