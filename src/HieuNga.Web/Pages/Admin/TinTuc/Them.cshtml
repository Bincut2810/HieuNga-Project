@page "/admin/tin-tuc/them"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.TinTucThemModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Thêm bài viết")' />

<form method="post" class="admin-form-card" style="max-width: 48rem;">
    @Html.AntiForgeryToken()
    <partial name="Admin/Shared/_BlogPostForm" model="Model" />
    <div class="admin-form-actions">
        <a href="/admin/tin-tuc" class="admin-btn admin-btn-ghost">Hủy</a>
        <button type="submit" class="admin-btn admin-btn-primary">Đăng bài</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
