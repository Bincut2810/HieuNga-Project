@page "/admin/tin-tuc"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.TinTuc.IndexModel
@{
    ViewData["Title"] = "Tin tức";
}

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "Tin tức",
             "Quản lý bài viết — tạo, chỉnh sửa, xuất bản và ẩn bài viết trên website.",
             "/admin/tin-tuc/them",
             "+ Thêm bài viết")' />

<form method="get" class="admin-toolbar">
    <div class="admin-toolbar-fields">
        <div class="admin-field" style="flex: 1; min-width: 200px;">
            <label for="search" class="admin-label">Tìm kiếm</label>
            <input id="search" name="Search" value="@Model.Search" placeholder="Tìm theo tiêu đề hoặc slug…" class="admin-input" />
        </div>
        <div class="admin-toolbar-actions">
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a href="/admin/tin-tuc" class="admin-btn admin-btn-ghost">Xóa lọc</a>
            }
            <button type="submit" class="admin-btn admin-btn-secondary">Tìm</button>
        </div>
    </div>
</form>

@if (Model.Posts.Count == 0)
{
    if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <div class="admin-empty">
            <p class="admin-empty-title">Không tìm thấy bài viết</p>
            <p class="admin-empty-text">Thử từ khóa khác hoặc <a href="/admin/tin-tuc">xem tất cả</a>.</p>
        </div>
    }
    else
    {
        <partial name="Admin/Shared/_AdminEmptyState"
                 model='new AdminEmptyStateModel("Chưa có bài viết", "Viết bài đầu tiên cho mục Tin tức — kèm ảnh đại diện và tóm tắt.", "/admin/tin-tuc/them", "+ Thêm bài viết")' />
    }
}
else
{
    <div class="admin-thumb-list">
        @foreach (var post in Model.Posts)
        {
            var isPub = post.IsPublished;
            var publishedLabel = post.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
            string statusBadgeClass = isPub ? "admin-badge-success" : "admin-badge-muted";
            string statusLabel = isPub ? "Đã xuất bản" : "Bản nháp";
            string editUrl = $"/admin/tin-tuc/sua/{post.Id}";
            <article class="admin-thumb-row">
                <div class="admin-thumb-row-img">
                    @if (!string.IsNullOrWhiteSpace(post.ThumbnailUrl))
                    {
                        <img src="@post.ThumbnailUrl" alt="" loading="lazy" width="72" height="72" />
                    }
                    else
                    {
                        <div class="admin-thumb-row-placeholder">Chưa có ảnh</div>
                    }
                </div>
                <div class="admin-thumb-row-body">
                    <h2 class="admin-thumb-row-title">@post.Title</h2>
                    <p class="admin-thumb-row-meta">
                        <span class="admin-badge @statusBadgeClass">@statusLabel</span>
                        @if (!string.IsNullOrWhiteSpace(post.CategoryName))
                        {
                            <span class="admin-badge admin-badge-category">@post.CategoryName</span>
                        }
                        @if (isPub && !string.IsNullOrEmpty(publishedLabel))
                        {
                            <span>Đăng: @publishedLabel</span>
                        }
                        else if (!isPub)
                        {
                            <span>Chưa đăng — bài viết ở chế độ nháp</span>
                        }
                    </p>
                </div>
                <div class="admin-thumb-row-actions">
                    <a href="@editUrl" class="admin-action admin-action-edit">Sửa</a>
                    <form method="post" asp-page-handler="Delete" class="inline"
                          data-confirm="true"
                          data-confirm-title="Xóa bài viết?"
                          data-confirm-body="Bạn có chắc muốn xóa bài viết này không? Bài viết sẽ bị ẩn khỏi website."
                          data-confirm-ok="Xóa bài"
                          data-confirm-cancel="Hủy"
                          data-confirm-danger="true">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@post.Id" />
                        <button type="submit" class="admin-action admin-action-danger">Xóa</button>
                    </form>
                </div>
            </article>
        }
    </div>
}
