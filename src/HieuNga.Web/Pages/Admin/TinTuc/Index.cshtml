@page "/admin/tin-tuc"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.TinTuc.IndexModel
@{
    ViewData["Title"] = "Tin tức";
}

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "News",
             "Bài viết và tin tức công khai.",
             "/admin/tin-tuc/them",
             "+ Thêm bài viết")' />

@if (Model.Posts.Count == 0)
{
    <partial name="Admin/Shared/_AdminEmptyState"
             model='new AdminEmptyStateModel("Chưa có bài viết", "Viết bài đầu tiên cho mục Tin tức.", "/admin/tin-tuc/them", "+ Thêm bài viết")' />
}
else
{
    <div class="admin-list">
        @foreach (var post in Model.Posts)
        {
            <partial name="Admin/Shared/_AdminListItem"
                     model='new AdminListItemModel(
                         post.Title,
                         null,
                         post.PublishedAt?.ToString("dd/MM/yyyy") ?? "Nháp",
                         $"/admin/tin-tuc/sua/{post.Id}",
                         $"/tin-tuc/{post.Slug}")' />
        }
    </div>
}
