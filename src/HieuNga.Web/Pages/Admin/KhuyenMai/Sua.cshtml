@page "/admin/khuyen-mai/sua/{id:guid}"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.KhuyenMaiSuaModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Sửa khuyến mãi")' />

<form method="post" class="admin-form-card" style="max-width: 48rem;">
    @Html.AntiForgeryToken()
    <partial name="Admin/Shared/_PromotionForm" model="Model.Input" />
    <div class="admin-form-actions">
        <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
