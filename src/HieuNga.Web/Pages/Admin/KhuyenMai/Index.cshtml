@page "/admin/khuyen-mai"
@model HieuNga.Web.Pages.Admin.KhuyenMai.IndexModel

<h1 class="text-2xl font-bold">Khuyến mãi</h1>
<div class="mt-8 grid gap-4">
    @foreach (var p in Model.Items)
    {
        <div class="bg-white border rounded-xl p-6 flex flex-wrap justify-between gap-4 items-center">
            <div>
                <span class="text-xs font-bold text-honda-red">@p.Type</span>
                <h3 class="font-bold mt-1">@p.Title</h3>
                <p class="text-sm text-gray-500">Hết hạn @p.EndDate.ToString("dd/MM/yyyy")</p>
            </div>
            <a href="/khuyen-mai/@p.Slug" target="_blank" class="text-sm font-semibold text-honda-red">Xem trang →</a>
        </div>
    }
</div>
