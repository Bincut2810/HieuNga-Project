@page "/admin"
@model HieuNga.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="text-2xl md:text-3xl font-bold text-honda-dark">Dashboard</h1>
<p class="text-gray-500 mt-1">Tổng quan showroom Honda Hiếu Nga</p>

<div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-6 mt-8">
    <div class="bg-white rounded-2xl p-6 border shadow-sm">
        <p class="text-sm text-gray-500">Xe máy</p>
        <p class="text-3xl font-bold text-honda-red mt-2">@Model.MotorcycleCount</p>
        <a href="/admin/xe" class="text-xs font-semibold mt-4 inline-block hover:text-honda-red">Quản lý →</a>
    </div>
    <div class="bg-white rounded-2xl p-6 border shadow-sm">
        <p class="text-sm text-gray-500">Khuyến mãi</p>
        <p class="text-3xl font-bold mt-2">@Model.PromotionCount</p>
        <a href="/admin/khuyen-mai" class="text-xs font-semibold mt-4 inline-block hover:text-honda-red">Quản lý →</a>
    </div>
    <div class="bg-white rounded-2xl p-6 border shadow-sm">
        <p class="text-sm text-gray-500">Bài viết</p>
        <p class="text-3xl font-bold mt-2">@Model.BlogCount</p>
        <a href="/admin/tin-tuc" class="text-xs font-semibold mt-4 inline-block hover:text-honda-red">Quản lý →</a>
    </div>
    <div class="bg-white rounded-2xl p-6 border shadow-sm">
        <p class="text-sm text-gray-500">Lịch hẹn / Lead</p>
        <p class="text-3xl font-bold mt-2">@Model.BookingCount</p>
    </div>
</div>

<div class="mt-10 bg-white rounded-2xl border p-8">
    <h2 class="font-bold text-lg">Chuẩn bị demo</h2>
    <ul class="mt-4 space-y-2 text-sm text-gray-600">
        <li>✓ Trang khuyến mãi, tin tức, liên hệ đã hoàn thiện</li>
        <li>✓ So sánh xe & đặt bảo dưỡng</li>
        <li>→ Phase 2: Form thêm/sửa CRUD đầy đủ</li>
    </ul>
    <a href="/" target="_blank" class="btn-primary mt-6 inline-flex text-sm px-5 py-2.5 bg-honda-red text-white rounded-lg font-semibold">Xem website demo</a>
</div>
