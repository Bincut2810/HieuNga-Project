@using HieuNga.Web.Pages.Admin.Extensions
@{
    // Read via the indexer (not Peek) so the entry is marked for deletion
    // after the first render. Without this, TempData.Peek(...) leaves the
    // value stuck in the cookie / session and the error banner re-renders
    // on every subsequent GET until the cookie expires — the source of
    // stale "Đã xảy ra lỗi…" messages after the original failure is gone.
    var success = TempData[AdminUi.SuccessKey] as string;
    var error = TempData[AdminUi.ErrorKey] as string;

    // Toast trigger payload: emitted as a hidden <input data-toast> so the
    // admin-toast.js widget can pick it up and render a real toast. The
    // inline banner is also rendered below as a non-blocking fallback for
    // users with JS disabled (it is hidden client-side when the toast
    // is shown, so the user never sees a duplicate message).
    var successText = string.IsNullOrEmpty(success) ? null : "✓ " + success;
    var errorText = string.IsNullOrEmpty(error) ? null : error;
}
@if (!string.IsNullOrEmpty(success))
{
    <div class="admin-flash admin-flash-success" data-admin-flash="success" role="status">@success</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="admin-flash admin-flash-error" data-admin-flash="error" role="alert">@error</div>
}
@if (successText != null)
{
    <input type="hidden" data-toast data-toast-type="success" value="@successText" />
}
@if (errorText != null)
{
    <input type="hidden" data-toast data-toast-type="error" value="@errorText" />
}
