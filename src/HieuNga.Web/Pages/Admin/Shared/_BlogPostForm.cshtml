@*
    Staff-friendly Blog Post form partial.

    Strongly typed to BlogPostInputModel so the field names are
    statically correct and the model binder can pick them up.

    The parent page renders this with:
        <partial name="Admin/Shared/_BlogPostForm" model="Model.Input" />

    Every input here uses the `Input.` prefix in its `name` attribute
    so the form posts directly to BlogPostInputModel on the page model
    via the [BindProperty] Input property.

    No SEO / Slug fields are rendered — staff never edits them.
*@
@model HieuNga.Web.Pages.Admin.TinTuc.BlogPostInputModel

<div class="admin-form-stack">
    <section class="admin-form-section">
        <h2 class="admin-form-section-title">Nội dung chính</h2>
        <div>
            <label for="Input_Title" class="admin-label">
                Tiêu đề <span class="admin-label-required">*</span>
            </label>
            <input id="Input_Title"
                   name="Input.Title"
                   class="admin-input"
                   placeholder="Ví dụ: Hướng dẫn chọn xe ga phù hợp"
                   maxlength="200"
                   value="@Model.Title" />
            <span class="admin-field-error" data-valmsg-for="Input.Title" data-valmsg-replace="true"></span>
        </div>
        <div>
            <label for="Input_Summary" class="admin-label">Tóm tắt</label>
            <textarea id="Input_Summary"
                      name="Input.Summary"
                      rows="2"
                      class="admin-textarea"
                      maxlength="500"
                      placeholder="Một vài câu mô tả ngắn hiển thị ở danh sách bài viết.">@Model.Summary</textarea>
        </div>
        <div>
            <label for="Input_Content" class="admin-label">
                Nội dung <span class="admin-label-required">*</span>
            </label>
            <textarea id="Input_Content"
                      name="Input.Content"
                      rows="12"
                      class="admin-textarea"
                      style="white-space: pre-wrap;"
                      placeholder="Viết nội dung ở đây. Xuống dòng sẽ được giữ nguyên khi hiển thị trên website.">@Model.Content</textarea>
            <span class="admin-field-error" data-valmsg-for="Input.Content" data-valmsg-replace="true"></span>
            <p class="admin-hint" style="margin: 0.3rem 0 0;">Mỗi đoạn cách nhau một dòng trống sẽ hiển thị thành đoạn riêng trên website.</p>
        </div>
    </section>

    <section class="admin-form-section">
        <h2 class="admin-form-section-title">Ảnh đại diện &amp; Danh mục</h2>
        <div class="admin-grid-2">
            <div>
                <label for="Input_CategoryId" class="admin-label">Chuyên mục</label>
                <select id="Input_CategoryId"
                        name="Input.CategoryId"
                        asp-items="@(ViewData["CategoryOptions"] as SelectList)"
                        class="admin-select">
                    <option value="">— Chưa phân loại —</option>
                </select>
            </div>
            <div>
                <label for="Input_AuthorName" class="admin-label">Tác giả</label>
                <input id="Input_AuthorName"
                       name="Input.AuthorName"
                       class="admin-input"
                       placeholder="Tên hiển thị"
                       value="@Model.AuthorName" />
            </div>
        </div>
        <div>
            <partial name="Admin/Shared/_ImageUploader" model='new HieuNga.Web.Pages.Admin.Extensions.ImageUploaderField(
                Kind: "blog-thumbnail",
                AspFor: "Input.ThumbnailUrl",
                Label: "Ảnh đại diện",
                Hint: "Kéo ảnh vào đây hoặc bấm để chọn ảnh",
                HelpText: "JPG, PNG hoặc WebP • Tối đa 5 MB.",
                CurrentValue: Model.ThumbnailUrl)' />
        </div>
    </section>

    <section class="admin-form-section">
        <h2 class="admin-form-section-title">Xuất bản</h2>
        <div class="admin-grid-2">
            <label class="admin-check" style="padding-top: 0.5rem;">
                <input id="Input_IsPublished"
                       name="Input.IsPublished"
                       type="checkbox"
                       @(Model.IsPublished ? "checked=\"checked\"" : "")
                       value="true"
                       style="accent-color: var(--admin-honda-red);" />
                Đăng bài viết lên website
            </label>
            <div>
                <label for="Input_PublishedAt" class="admin-label">Ngày đăng</label>
                <input id="Input_PublishedAt"
                       name="Input.PublishedAt"
                       type="datetime-local"
                       class="admin-input"
                       value="@(Model.PublishedAt == null ? "" : Model.PublishedAt.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" />
                <p class="admin-hint" style="margin: 0.3rem 0 0;">Bỏ trống để dùng ngày hiện tại khi đăng.</p>
            </div>
        </div>
    </section>
</div>
