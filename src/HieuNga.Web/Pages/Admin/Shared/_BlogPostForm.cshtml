@model HieuNga.Web.Pages.Admin.BlogPostInputModel
@{
    // Phase 1 — Staff-friendly Blog form.
    // Hidden from staff (still bound server-side): Slug, MetaTitle,
    // MetaDescription, MetaKeywords, OgImageUrl, CanonicalUrl.
}
<div class="admin-form-stack">
    <section class="admin-form-section">
        <h2 class="admin-form-section-title">Nội dung chính</h2>
        <div>
            <label asp-for="Title" class="admin-label">Tiêu đề <span class="admin-label-required">*</span></label>
            <input asp-for="Title" class="admin-input" placeholder="Ví dụ: Hướng dẫn chọn xe ga phù hợp" maxlength="200" />
            <span asp-validation-for="Title" class="admin-field-error"></span>
        </div>
        <div>
            <label asp-for="Summary" class="admin-label">Tóm tắt</label>
            <textarea asp-for="Summary" rows="2" class="admin-textarea" maxlength="500"
                      placeholder="Một vài câu mô tả ngắn hiển thị ở danh sách bài viết."></textarea>
        </div>
        <div>
            <label asp-for="Content" class="admin-label">Nội dung <span class="admin-label-required">*</span></label>
            <textarea asp-for="Content" rows="12" class="admin-textarea" style="white-space: pre-wrap;"
                      placeholder="Viết nội dung ở đây. Xuống dòng sẽ được giữ nguyên khi hiển thị trên website."></textarea>
            <span asp-validation-for="Content" class="admin-field-error"></span>
            <p class="admin-hint" style="margin: 0.3rem 0 0;">Mỗi đoạn cách nhau một dòng trống sẽ hiển thị thành đoạn riêng trên website.</p>
        </div>
    </section>

    <section class="admin-form-section">
        <h2 class="admin-form-section-title">Ảnh đại diện &amp; Danh mục</h2>
        <div class="admin-grid-2">
            <div>
                <label asp-for="CategoryId" class="admin-label">Chuyên mục</label>
                <select asp-for="CategoryId" asp-items="@(ViewData["CategoryOptions"] as SelectList)" class="admin-select">
                    <option value="">— Chưa phân loại —</option>
                </select>
            </div>
            <div>
                <label asp-for="AuthorName" class="admin-label">Tác giả</label>
                <input asp-for="AuthorName" class="admin-input" placeholder="Tên hiển thị" />
            </div>
        </div>
        <div>
            <partial name="Admin/Shared/_ImageUploader" model='new HieuNga.Web.Pages.Admin.Extensions.ImageUploaderField(
                Kind: "blog-thumbnail",
                AspFor: "ThumbnailUrl",
                Label: "Ảnh đại diện",
                Hint: "Kéo ảnh vào đây hoặc bấm để chọn ảnh",
                HelpText: "JPG, PNG hoặc WebP • Tối đa 5 MB.",
                CurrentValue: Model.ThumbnailUrl)' />
        </div>
    </section>

    <section class="admin-form-section">
        <h2 class="admin-form-section-title">Xuất bản</h2>
        <div class="admin-grid-2">
            <label class="admin-check" style="padding-top: 0.5rem;">
                <input asp-for="IsPublished" type="checkbox" style="accent-color: var(--admin-honda-red);" />
                Đăng bài viết lên website
            </label>
            <div>
                <label asp-for="PublishedAt" class="admin-label">Ngày đăng</label>
                <input asp-for="PublishedAt" type="datetime-local" class="admin-input"
                       value="@(Model.PublishedAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" />
                <p class="admin-hint" style="margin: 0.3rem 0 0;">Bỏ trống để dùng ngày hiện tại khi đăng.</p>
            </div>
        </div>
    </section>
</div>
