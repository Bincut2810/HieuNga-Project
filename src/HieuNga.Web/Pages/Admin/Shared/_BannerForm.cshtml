@model HieuNga.Web.Pages.Admin.BannerInputModel
<div class="admin-form-stack">
    <div>
        <label asp-for="Title" class="admin-label">Tiêu đề *</label>
        <input asp-for="Title" class="admin-input" />
        <span asp-validation-for="Title" class="admin-validation"></span>
    </div>
    <div>
        <label asp-for="Subtitle" class="admin-label">Phụ đề</label>
        <input asp-for="Subtitle" class="admin-input" />
    </div>
    <div>
        <label asp-for="ImageUrl" class="admin-label">Ảnh URL *</label>
        <input asp-for="ImageUrl" class="admin-input" />
        <span asp-validation-for="ImageUrl" class="admin-validation"></span>
    </div>
    <div class="admin-grid-2">
        <div>
            <label asp-for="PrimaryButtonText" class="admin-label">Nút chính — text</label>
            <input asp-for="PrimaryButtonText" class="admin-input" />
        </div>
        <div>
            <label asp-for="PrimaryButtonUrl" class="admin-label">Nút chính — URL</label>
            <input asp-for="PrimaryButtonUrl" class="admin-input" />
        </div>
    </div>
    <div>
        <label asp-for="DisplayOrder" class="admin-label">Thứ tự hiển thị</label>
        <input asp-for="DisplayOrder" type="number" class="admin-input" />
    </div>
    <label class="admin-check"><input asp-for="Enabled" type="checkbox" /> Đã xuất bản (kích hoạt)</label>
</div>
