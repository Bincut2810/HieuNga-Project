@model HieuNga.Web.Pages.Admin.PromotionInputModel
<div class="admin-form-stack">
    <div>
        <label asp-for="Title" class="admin-label">Tiêu đề *</label>
        <input asp-for="Title" class="admin-input" />
        <span asp-validation-for="Title" class="admin-validation"></span>
    </div>
    <div>
        <label asp-for="Slug" class="admin-label">Slug</label>
        <input asp-for="Slug" class="admin-input" />
    </div>
    <div>
        <label asp-for="Summary" class="admin-label">Tóm tắt</label>
        <textarea asp-for="Summary" rows="2" class="admin-textarea"></textarea>
    </div>
    <div>
        <label asp-for="Content" class="admin-label">Nội dung</label>
        <textarea asp-for="Content" rows="6" class="admin-textarea"></textarea>
    </div>
    <div class="admin-grid-2">
        <div>
            <label asp-for="Type" class="admin-label">Loại</label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<PromotionType>()" class="admin-select"></select>
        </div>
        <div>
            <label asp-for="MotorcycleId" class="admin-label">Xe liên quan</label>
            <select asp-for="MotorcycleId" asp-items="@(ViewData["MotorcycleOptions"] as SelectList)" class="admin-select">
                <option value="">—</option>
            </select>
        </div>
    </div>
    <div class="admin-grid-2">
        <div>
            <label asp-for="StartDate" class="admin-label">Bắt đầu</label>
            <input asp-for="StartDate" type="date" class="admin-input" />
        </div>
        <div>
            <label asp-for="EndDate" class="admin-label">Kết thúc</label>
            <input asp-for="EndDate" type="date" class="admin-input" />
        </div>
    </div>
    <div>
        <label asp-for="ImageUrl" class="admin-label">Ảnh URL</label>
        <input asp-for="ImageUrl" class="admin-input" />
    </div>
    <div class="admin-grid-2">
        <label class="admin-check"><input asp-for="IsActive" type="checkbox" /> Kích hoạt</label>
        <label class="admin-check"><input asp-for="IsFeatured" type="checkbox" /> Nổi bật</label>
    </div>
    <partial name="Admin/Shared/_SeoFields" model="Model" />
</div>
