@{
    var title = ViewData["Title"] as string ?? "Admin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title | Honda Hiếu Nga Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { theme: { extend: { colors: { honda: { red: '#E40521', dark: '#1A1A1A' } } } } } };
    </script>
</head>
<body class="bg-gray-50 font-sans antialiased min-h-screen">
    <div class="flex min-h-screen">
        <aside class="w-64 bg-honda-dark text-white flex-shrink-0 hidden lg:flex flex-col">
            <div class="p-6 border-b border-white/10">
                <p class="font-bold">Honda Hiếu Nga</p>
                <p class="text-xs text-gray-400">CMS Admin</p>
            </div>
            <nav class="flex-1 p-4 space-y-1 text-sm">
                <a href="/admin" class="block px-4 py-3 rounded-lg hover:bg-white/10 transition">Dashboard</a>
                <a href="/admin/xe" class="block px-4 py-3 rounded-lg hover:bg-white/10 transition">Xe máy</a>
                <a href="/admin/khuyen-mai" class="block px-4 py-3 rounded-lg hover:bg-white/10 transition">Khuyến mãi</a>
                <a href="/admin/tin-tuc" class="block px-4 py-3 rounded-lg hover:bg-white/10 transition">Tin tức</a>
                <a href="/admin/banner" class="block px-4 py-3 rounded-lg hover:bg-white/10 transition">Banner</a>
                <a href="/admin/chi-nhanh" class="block px-4 py-3 rounded-lg hover:bg-white/10 transition">Chi nhánh</a>
            </nav>
            <div class="p-4 border-t border-white/10">
                <a href="/" target="_blank" class="text-xs text-gray-400 hover:text-white">← Xem website</a>
                <form method="post" asp-page="/Admin/DangNhap" asp-page-handler="Logout" class="mt-3">
                    <button type="submit" class="text-xs text-red-300 hover:text-white">Đăng xuất</button>
                </form>
            </div>
        </aside>
        <main class="flex-1 overflow-auto">
            <header class="bg-white border-b px-6 py-4 flex items-center justify-between lg:hidden">
                <span class="font-bold">Admin</span>
                <a href="/" class="text-sm text-honda-red">Website</a>
            </header>
            <div class="p-6 md:p-10">
                @RenderBody()
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
