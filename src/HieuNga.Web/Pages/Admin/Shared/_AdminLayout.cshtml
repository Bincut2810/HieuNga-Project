@{
    var title = ViewData["Title"] as string ?? "Admin";
    var path = Context.Request.Path.Value ?? "";

    bool IsNavActive(string href, string? excludePrefix = null)
    {
        if (excludePrefix != null && path.StartsWith(excludePrefix, StringComparison.OrdinalIgnoreCase))
            return false;
        if (href.Equals("/admin", StringComparison.OrdinalIgnoreCase))
            return path.Equals("/admin", StringComparison.OrdinalIgnoreCase);
        return path.Equals(href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(string href, string? excludePrefix = null) =>
        IsNavActive(href, excludePrefix) ? "admin-nav-link is-active" : "admin-nav-link";

    bool GroupActive(params string[] prefixes) =>
        prefixes.Any(p => path.Equals(p, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));

    string Icon(string name) => name switch
    {
        "home" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5z"/></svg>""",
        "bike" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="6.5" cy="16.5" r="3.5"/><circle cx="17.5" cy="16.5" r="3.5"/><path d="M6.5 16.5 10 8h4l2 4h3"/></svg>""",
        "import" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>""",
        "wrench" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5 2.5-2.5z"/></svg>""",
        "folder" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>""",
        "calendar" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>""",
        "bank" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 10h18L12 3 3 10z"/><path d="M5 10v8M9 10v8M15 10v8M19 10v8M3 18h18"/></svg>""",
        "percent" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="7.5" cy="7.5" r="2"/><circle cx="16.5" cy="16.5" r="2"/><path d="m6 18 12-12"/></svg>""",
        "users" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>""",
        "tag" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M20.6 13.4 12 22l-9-9V4h9l8.6 8.6z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>""",
        "news" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 4h12v16H4z"/><path d="M16 8h4v12a2 2 0 0 1-2 2h-2"/><path d="M7 8h6M7 12h6M7 16h4"/></svg>""",
        "image" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 15-4.5-4.5L7 20"/></svg>""",
        "pin" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 22s7-5.5 7-12a7 7 0 1 0-14 0c0 6.5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>""",
        "gear" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>""",
        _ => ""
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title | Xe Máy Hiếu Nga Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-shell" data-admin-shell>
        <div id="admin-sidebar-overlay" class="admin-sidebar-overlay" aria-hidden="true"></div>

        <aside id="admin-sidebar" class="admin-sidebar" aria-label="Admin navigation">
            <div class="admin-sidebar-brand">
                <img src="~/images/logohieunga.webp"
                     asp-append-version="true"
                     alt="Hiếu Nga"
                     class="admin-sidebar-brand-logo"
                     width="140"
                     height="40"
                     decoding="async" />
                <div class="admin-sidebar-brand-text">
                    <p class="admin-sidebar-brand-title">Xe Máy Hiếu Nga</p>
                    <p class="admin-sidebar-brand-sub">CMS Studio</p>
                </div>
                <button type="button" class="admin-sidebar-collapse" id="admin-sidebar-collapse" aria-label="Thu gọn menu" title="Thu gọn">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6 9 12l6 6"/></svg>
                </button>
            </div>

            <nav class="admin-sidebar-nav">
                <div class="admin-nav-group">
                    <p class="admin-nav-group-label">Tổng quan</p>
                    <a href="/admin" class="@NavClass("/admin")"><span class="admin-nav-icon">@Html.Raw(Icon("home"))</span><span class="admin-nav-text">Dashboard</span></a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/xe") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Inventory</p>
                    <a href="/admin/xe" class="@NavClass("/admin/xe")"><span class="admin-nav-icon">@Html.Raw(Icon("bike"))</span><span class="admin-nav-text">Motorcycles</span></a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/dich-vu", "/admin/bookings", "/admin/test-ride", "/admin/khach-hang/bao-duong") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Service</p>
                    <a href="/admin/dich-vu/bang-gia" class="@NavClass("/admin/dich-vu/bang-gia")"><span class="admin-nav-icon">@Html.Raw(Icon("wrench"))</span><span class="admin-nav-text">Services</span></a>
                    <a href="/admin/dich-vu/danh-muc" class="@NavClass("/admin/dich-vu/danh-muc")"><span class="admin-nav-icon">@Html.Raw(Icon("folder"))</span><span class="admin-nav-text">Categories</span></a>
                    <a href="/admin/bookings" class="@NavClass("/admin/bookings")"><span class="admin-nav-icon">@Html.Raw(Icon("calendar"))</span><span class="admin-nav-text">Booking Center</span></a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/tra-gop", "/admin/khach-hang/tra-gop") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Finance</p>
                    <a href="/admin/tra-gop/ngan-hang" class="@NavClass("/admin/tra-gop/ngan-hang")"><span class="admin-nav-icon">@Html.Raw(Icon("bank"))</span><span class="admin-nav-text">Banks</span></a>
                    <a href="/admin/tra-gop/lai-suat" class="@NavClass("/admin/tra-gop/lai-suat")"><span class="admin-nav-icon">@Html.Raw(Icon("percent"))</span><span class="admin-nav-text">Interest Rates</span></a>
                    <a href="/admin/khach-hang/tra-gop" class="@NavClass("/admin/khach-hang/tra-gop")"><span class="admin-nav-icon">@Html.Raw(Icon("users"))</span><span class="admin-nav-text">Installment leads</span></a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/banner", "/admin/khuyen-mai", "/admin/tin-tuc") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Content</p>
                    <a href="/admin/khuyen-mai" class="@NavClass("/admin/khuyen-mai")"><span class="admin-nav-icon">@Html.Raw(Icon("tag"))</span><span class="admin-nav-text">Promotions</span></a>
                    <a href="/admin/tin-tuc" class="@NavClass("/admin/tin-tuc")"><span class="admin-nav-icon">@Html.Raw(Icon("news"))</span><span class="admin-nav-text">News</span></a>
                    <a href="/admin/banner" class="@NavClass("/admin/banner")"><span class="admin-nav-icon">@Html.Raw(Icon("image"))</span><span class="admin-nav-text">Banner</span></a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/chi-nhanh", "/admin/cai-dat") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Site</p>
                    <a href="/admin/chi-nhanh" class="@NavClass("/admin/chi-nhanh")"><span class="admin-nav-icon">@Html.Raw(Icon("pin"))</span><span class="admin-nav-text">Branches</span></a>
                    <a href="/admin/cai-dat" class="@NavClass("/admin/cai-dat")"><span class="admin-nav-icon">@Html.Raw(Icon("gear"))</span><span class="admin-nav-text">Settings</span></a>
                </div>
            </nav>

            <div class="admin-sidebar-footer">
                <a href="/" target="_blank" rel="noopener" class="admin-sidebar-footer-link">↗ Xem website</a>
                <form method="post" asp-page="/Admin/DangNhap" asp-page-handler="Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-logout-btn">Đăng xuất</button>
                </form>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div class="admin-topbar-left">
                    <button type="button" id="admin-menu-toggle" class="admin-topbar-menu-btn" aria-label="Mở menu" aria-expanded="false" aria-controls="admin-sidebar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                    </button>
                    <span class="admin-topbar-title">@title</span>
                </div>
                <div class="admin-topbar-actions">
                    <a href="/" target="_blank" rel="noopener" class="admin-btn admin-btn-ghost admin-topbar-site-link">Xem website</a>
                </div>
            </header>

            <div class="admin-content">
                <partial name="Admin/Shared/_AdminFlash" />
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
