@{
    var title = ViewData["Title"] as string ?? "Admin";
    var path = Context.Request.Path.Value ?? "";

    bool IsNavActive(string href, string? excludePrefix = null)
    {
        if (excludePrefix != null && path.StartsWith(excludePrefix, StringComparison.OrdinalIgnoreCase))
            return false;
        if (href.Equals("/admin", StringComparison.OrdinalIgnoreCase))
            return path.Equals("/admin", StringComparison.OrdinalIgnoreCase);
        return path.Equals(href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(string href, string? excludePrefix = null) =>
        IsNavActive(href, excludePrefix) ? "admin-nav-link admin-nav-link-active" : "admin-nav-link";

    // Group highlight when any child route matches
    bool GroupActive(params string[] prefixes) =>
        prefixes.Any(p => path.Equals(p, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title | Xe Máy Hiếu Nga Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-shell">
        <div id="admin-sidebar-overlay" class="admin-sidebar-overlay" aria-hidden="true"></div>

        <aside id="admin-sidebar" class="admin-sidebar" aria-label="Admin navigation">
            <div class="admin-sidebar-brand">
                <p class="admin-sidebar-brand-title">Xe Máy Hiếu Nga</p>
                <p class="admin-sidebar-brand-sub">Motorcycle CMS</p>
            </div>

            <nav class="admin-sidebar-nav">
                <div class="admin-nav-group">
                    <p class="admin-nav-group-label">Tổng quan</p>
                    <a href="/admin" class="@NavClass("/admin")">Dashboard</a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/xe") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Inventory</p>
                    <a href="/admin/xe" class="@NavClass("/admin/xe", "/admin/xe/import-demo")">Motorcycles</a>
                    <a href="/admin/xe/import-demo" class="@NavClass("/admin/xe/import-demo")">Import Demo Data</a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/dich-vu", "/admin/khach-hang/lich-hen", "/admin/khach-hang/bao-duong") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Service</p>
                    <a href="/admin/dich-vu/bang-gia" class="@NavClass("/admin/dich-vu/bang-gia")">Services</a>
                    <a href="/admin/dich-vu/danh-muc" class="@NavClass("/admin/dich-vu/danh-muc")">Categories</a>
                    <a href="/admin/khach-hang/lich-hen" class="@NavClass("/admin/khach-hang/lich-hen")">Appointments</a>
                    <a href="/admin/khach-hang/bao-duong" class="@NavClass("/admin/khach-hang/bao-duong")">Maintenance</a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/tra-gop", "/admin/khach-hang/tra-gop") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Finance</p>
                    <a href="/admin/tra-gop/ngan-hang" class="@NavClass("/admin/tra-gop/ngan-hang")">Banks</a>
                    <a href="/admin/tra-gop/lai-suat" class="@NavClass("/admin/tra-gop/lai-suat")">Interest Rates</a>
                    <a href="/admin/khach-hang/tra-gop" class="@NavClass("/admin/khach-hang/tra-gop")">Installment leads</a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/banner", "/admin/khuyen-mai", "/admin/tin-tuc") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Content</p>
                    <a href="/admin/khuyen-mai" class="@NavClass("/admin/khuyen-mai")">Promotions</a>
                    <a href="/admin/tin-tuc" class="@NavClass("/admin/tin-tuc")">News</a>
                    <a href="/admin/banner" class="@NavClass("/admin/banner")">Banner</a>
                </div>

                <div class="admin-nav-group @(GroupActive("/admin/chi-nhanh", "/admin/cai-dat") ? "is-active-group" : null)">
                    <p class="admin-nav-group-label">Site</p>
                    <a href="/admin/chi-nhanh" class="@NavClass("/admin/chi-nhanh")">Branches</a>
                    <a href="/admin/cai-dat" class="@NavClass("/admin/cai-dat")">Settings</a>
                </div>
            </nav>

            <div class="admin-sidebar-footer">
                <a href="/" target="_blank" rel="noopener" class="admin-sidebar-footer-link">↗ Xem website</a>
                <form method="post" asp-page="/Admin/DangNhap" asp-page-handler="Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-logout-btn">Đăng xuất</button>
                </form>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <button type="button" id="admin-menu-toggle" class="admin-topbar-menu-btn" aria-label="Mở menu" aria-expanded="false" aria-controls="admin-sidebar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                    </button>
                    <span class="admin-topbar-title">@title</span>
                </div>
                <div class="admin-topbar-actions">
                    <a href="/" target="_blank" rel="noopener" class="admin-topbar-site-link">Xem website</a>
                </div>
            </header>

            <div class="admin-content">
                <partial name="Admin/Shared/_AdminFlash" />
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
