@model HieuNga.Web.Pages.Admin.BranchInputModel
<div class="admin-form-stack">
    <div>
        <label asp-for="Name" class="admin-label">Tên *</label>
        <input asp-for="Name" class="admin-input" />
        <span asp-validation-for="Name" class="admin-validation"></span>
    </div>
    <div>
        <label asp-for="Slug" class="admin-label">Slug</label>
        <input asp-for="Slug" class="admin-input" />
    </div>
    <div>
        <label asp-for="Address" class="admin-label">Địa chỉ *</label>
        <input asp-for="Address" class="admin-input" />
        <span asp-validation-for="Address" class="admin-validation"></span>
    </div>
    <div class="admin-grid-2">
        <div>
            <label asp-for="Phone" class="admin-label">Điện thoại</label>
            <input asp-for="Phone" class="admin-input" />
        </div>
        <div>
            <label asp-for="Hotline" class="admin-label">Hotline</label>
            <input asp-for="Hotline" class="admin-input" />
        </div>
    </div>
    <div>
        <label asp-for="Email" class="admin-label">Email</label>
        <input asp-for="Email" class="admin-input" />
    </div>
    <div>
        <label asp-for="OpeningHours" class="admin-label">Giờ mở cửa</label>
        <input asp-for="OpeningHours" class="admin-input" />
    </div>
    <div>
        <label asp-for="MapEmbedUrl" class="admin-label">Map embed URL</label>
        <input asp-for="MapEmbedUrl" class="admin-input" />
    </div>
    <div class="admin-grid-2">
        <label class="admin-check"><input asp-for="IsHeadOffice" type="checkbox" /> Trụ sở chính</label>
        <label class="admin-check"><input asp-for="IsActive" type="checkbox" /> Kích hoạt</label>
    </div>
</div>
