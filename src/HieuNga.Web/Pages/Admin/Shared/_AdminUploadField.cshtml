@model HieuNga.Web.Pages.Admin.Extensions.AdminUploadFieldModel

<div class="admin-upload-field">
    <label class="admin-label">@Model.Label</label>
    @if (!string.IsNullOrEmpty(Model.PreviewUrl))
    {
        <div class="admin-upload-preview">
            <img src="@Model.PreviewUrl" alt="Preview" />
        </div>
    }
    @if (Model.Enabled)
    {
        <label class="admin-upload-dropzone">
            <input type="file"
                   name="@Model.InputName"
                   accept="@Model.Accept"
                   class="admin-upload-input"
                   @(Model.Multiple ? "multiple" : null) />
            <span class="admin-upload-dropzone-title">Chọn ảnh@(Model.Multiple ? " (nhiều file)" : "")</span>
            <span class="admin-upload-dropzone-hint">Kéo thả hoặc bấm để tải lên · JPEG, PNG, WebP</span>
        </label>
    }
    else
    {
        <p class="admin-hint" style="color: #B45309;">@(Model.DisabledMessage ?? "Upload tạm thời không khả dụng.")</p>
    }
    @if (!string.IsNullOrEmpty(Model.Hint))
    {
        <p class="admin-hint">@Model.Hint</p>
    }
</div>
