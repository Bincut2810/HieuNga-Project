@page "/admin/tra-gop/ngan-hang"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.TraGop.NganHangIndexModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Ngân hàng trả góp")' />

<div class="admin-grid-2">
    <div class="admin-card admin-card-padded">
        <h2 class="admin-form-section-title">@(Model.Input.Id.HasValue ? "Sửa ngân hàng" : "Thêm ngân hàng")</h2>
        <form method="post" class="admin-form-stack">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Input.Id" />
            <div>
                <label class="admin-label">Loại ngân hàng</label>
                <select asp-for="Input.BankTypeId" asp-items="Model.TypeOptions" class="admin-select"></select>
            </div>
            <div>
                <label class="admin-label">Tên *</label>
                <input asp-for="Input.Name" class="admin-input" />
                <span asp-validation-for="Input.Name" class="admin-validation"></span>
            </div>
            <div>
                <label class="admin-label">Tên viết tắt *</label>
                <input asp-for="Input.ShortName" class="admin-input" />
            </div>
            <div>
                <label class="admin-label">Logo URL</label>
                <input asp-for="Input.LogoUrl" class="admin-input" />
            </div>
            <div class="admin-grid-2">
                <div>
                    <label class="admin-label">Màu thương hiệu</label>
                    <input asp-for="Input.BrandColor" class="admin-input" placeholder="#E40521" />
                </div>
                <div>
                    <label class="admin-label">Thứ tự</label>
                    <input asp-for="Input.DisplayOrder" type="number" class="admin-input" />
                </div>
            </div>
            <label class="admin-check"><input asp-for="Input.IsActive" type="checkbox" /> Kích hoạt</label>
            <div class="admin-form-actions" style="margin-top: 0; padding-top: 0; border-top: none;">
                <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
            </div>
        </form>
    </div>
    <div class="admin-card admin-table-wrap">
        <div class="admin-table-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ngân hàng</th>
                        <th>Loại</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Items)
                    {
                        <tr>
                            <td>
                                <p class="admin-table-primary">@b.Name (@b.ShortName)</p>
                            </td>
                            <td>@b.TypeName</td>
                            <td class="text-right">
                                <div class="admin-actions">
                                    <a href="?editId=@b.Id" class="admin-action admin-action-edit">Sửa</a>
                                    <form method="post" asp-page-handler="Delete">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="admin-action admin-action-danger" onclick="return confirm('Xóa?')">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
