@page "/admin/tra-gop/lai-suat"
@model HieuNga.Web.Pages.Admin.TraGop.LaiSuatIndexModel

<h1 class="text-2xl font-bold">Lãi suất trả góp</h1>

<div class="mt-8 grid lg:grid-cols-2 gap-8">
    <div class="bg-white border rounded-2xl p-6">
        <h2 class="font-semibold mb-4">@(Model.Input.Id.HasValue ? "Sửa gói lãi suất" : "Thêm gói lãi suất")</h2>
        <form method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Input.Id" />
            <div>
                <label class="block text-sm font-medium mb-1">Ngân hàng</label>
                <select asp-for="Input.BankId" asp-items="Model.BankOptions" class="w-full border rounded-lg px-3 py-2 text-sm"></select>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Tên gói</label>
                <input asp-for="Input.PlanName" class="w-full border rounded-lg px-3 py-2 text-sm" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-medium mb-1">Lãi suất %/tháng</label>
                    <input asp-for="Input.MonthlyInterestRatePercent" type="number" step="0.01" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Kỳ hạn (tháng CSV)</label>
                    <input asp-for="Input.SupportedTermsMonths" class="w-full border rounded-lg px-3 py-2 text-sm" placeholder="6,12,18,24,36" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-medium mb-1">Trả trước min %</label>
                    <input asp-for="Input.MinDownPaymentPercent" type="number" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Trả trước max %</label>
                    <input asp-for="Input.MaxDownPaymentPercent" type="number" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-medium mb-1">Kỳ hạn min</label>
                    <input asp-for="Input.MinTermMonths" type="number" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Kỳ hạn max</label>
                    <input asp-for="Input.MaxTermMonths" type="number" class="w-full border rounded-lg px-3 py-2 text-sm" />
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Nhãn tin cậy</label>
                <input asp-for="Input.TrustLabel" class="w-full border rounded-lg px-3 py-2 text-sm" />
            </div>
            <div class="flex gap-4">
                <label class="flex items-center gap-2 text-sm"><input asp-for="Input.IsDefault" type="checkbox" /> Mặc định</label>
                <label class="flex items-center gap-2 text-sm"><input asp-for="Input.IsActive" type="checkbox" /> Kích hoạt</label>
            </div>
            <button type="submit" class="bg-honda-red text-white px-4 py-2 rounded-lg font-semibold text-sm">Lưu</button>
        </form>
    </div>
    <div class="bg-white border rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-500 text-left"><tr><th class="px-4 py-3">Ngân hàng</th><th class="px-4 py-3">Gói</th><th class="px-4 py-3">Lãi suất</th><th class="px-4 py-3"></th></tr></thead>
            <tbody class="divide-y">
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td class="px-4 py-3">@r.BankName</td>
                        <td class="px-4 py-3 font-medium">@r.PlanName @(r.IsDefault ? "★" : "")</td>
                        <td class="px-4 py-3 text-honda-red">@r.Rate%/tháng</td>
                        <td class="px-4 py-3 text-right">
                            <a href="?editId=@r.Id" class="text-honda-red text-xs font-medium">Sửa</a>
                            <form method="post" asp-page-handler="Delete" class="inline ml-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="text-gray-400 text-xs" onclick="return confirm('Xóa?')">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
