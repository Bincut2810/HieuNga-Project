@page "/admin/tra-gop/lai-suat"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.TraGop.LaiSuatIndexModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Lãi suất trả góp")' />

<div class="admin-grid-2">
    <div class="admin-card admin-card-padded">
        <h2 class="admin-form-section-title">@(Model.Input.Id.HasValue ? "Sửa gói lãi suất" : "Thêm gói lãi suất")</h2>
        <form method="post" class="admin-form-stack">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Input.Id" />
            <div>
                <label class="admin-label">Ngân hàng</label>
                <select asp-for="Input.BankId" asp-items="Model.BankOptions" class="admin-select"></select>
            </div>
            <div>
                <label class="admin-label">Tên gói</label>
                <input asp-for="Input.PlanName" class="admin-input" />
            </div>
            <div class="admin-grid-2">
                <div>
                    <label class="admin-label">Lãi suất %/tháng</label>
                    <input asp-for="Input.MonthlyInterestRatePercent" type="number" step="0.01" class="admin-input" />
                </div>
                <div>
                    <label class="admin-label">Kỳ hạn (tháng CSV)</label>
                    <input asp-for="Input.SupportedTermsMonths" class="admin-input" placeholder="6,12,18,24,36" />
                </div>
            </div>
            <div class="admin-grid-2">
                <div>
                    <label class="admin-label">Trả trước min %</label>
                    <input asp-for="Input.MinDownPaymentPercent" type="number" class="admin-input" />
                </div>
                <div>
                    <label class="admin-label">Trả trước max %</label>
                    <input asp-for="Input.MaxDownPaymentPercent" type="number" class="admin-input" />
                </div>
            </div>
            <div class="admin-grid-2">
                <div>
                    <label class="admin-label">Kỳ hạn min</label>
                    <input asp-for="Input.MinTermMonths" type="number" class="admin-input" />
                </div>
                <div>
                    <label class="admin-label">Kỳ hạn max</label>
                    <input asp-for="Input.MaxTermMonths" type="number" class="admin-input" />
                </div>
            </div>
            <div>
                <label class="admin-label">Nhãn tin cậy</label>
                <input asp-for="Input.TrustLabel" class="admin-input" />
            </div>
            <div class="admin-grid-2">
                <label class="admin-check"><input asp-for="Input.IsDefault" type="checkbox" /> Mặc định</label>
                <label class="admin-check"><input asp-for="Input.IsActive" type="checkbox" /> Kích hoạt</label>
            </div>
            <div class="admin-form-actions" style="margin-top: 0; padding-top: 0; border-top: none;">
                <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
            </div>
        </form>
    </div>
    <div class="admin-card admin-table-wrap">
        <div class="admin-table-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ngân hàng</th>
                        <th>Gói</th>
                        <th>Lãi suất</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td>@r.BankName</td>
                            <td>
                                <p class="admin-table-primary">@r.PlanName @(r.IsDefault ? "★" : "")</p>
                            </td>
                            <td style="color: var(--admin-honda-red); font-weight: 600;">@r.Rate%/tháng</td>
                            <td class="text-right">
                                <div class="admin-actions">
                                    <a href="?editId=@r.Id" class="admin-action admin-action-edit">Sửa</a>
                                    <form method="post" asp-page-handler="Delete">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="admin-action admin-action-danger" onclick="return confirm('Xóa?')">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
