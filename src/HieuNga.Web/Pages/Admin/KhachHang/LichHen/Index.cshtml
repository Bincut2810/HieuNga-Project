@page "/admin/khach-hang/lich-hen"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.KhachHang.LichHenIndexModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Lịch hẹn")' />

<form method="get" class="admin-toolbar">
    <div class="admin-toolbar-fields">
        <div class="admin-field">
            <label for="q" class="admin-label">Tìm kiếm</label>
            <input id="q" name="q" value="@Model.Q" placeholder="Tên, SĐT..." class="admin-input" />
        </div>
        <div class="admin-field admin-field-sm">
            <label for="status" class="admin-label">Trạng thái</label>
            <select id="status" name="status" asp-items="Model.StatusOptions" class="admin-select">
                <option value="">Tất cả trạng thái</option>
            </select>
        </div>
        <div class="admin-toolbar-actions">
            <button type="submit" class="admin-btn admin-btn-secondary">Lọc</button>
        </div>
    </div>
</form>

<div class="admin-card admin-table-wrap">
    <div class="admin-table-scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Loại</th>
                    <th>Ngày</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <p class="admin-table-primary">@item.CustomerName</p>
                            <p class="admin-table-secondary">@item.Phone</p>
                        </td>
                        <td>@item.Type</td>
                        <td>@item.PreferredDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.Status</td>
                        <td class="text-right">
                            <a href="/admin/khach-hang/lich-hen/@item.Id" class="admin-action admin-action-edit">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
