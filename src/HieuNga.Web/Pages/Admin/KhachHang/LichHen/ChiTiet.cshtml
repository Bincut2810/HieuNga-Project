@page "/admin/khach-hang/lich-hen/{id:guid}"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.KhachHang.LichHenDetailModel

<header class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Chi tiết lịch hẹn</h1>
        <p class="admin-page-subtitle"><a href="/admin/khach-hang/lich-hen" style="color: var(--admin-honda-red);">← Danh sách</a></p>
    </div>
</header>

@if (Model.Booking is not null)
{
    var b = Model.Booking;
    <div class="admin-grid-2">
        <div class="admin-card admin-card-padded admin-form-stack">
            <p><span class="admin-hint">Khách:</span> <strong>@b.CustomerName</strong></p>
            <p><span class="admin-hint">SĐT:</span> @b.Phone</p>
            <p><span class="admin-hint">Email:</span> @(b.Email ?? "—")</p>
            <p><span class="admin-hint">Loại:</span> @b.Type</p>
            <p><span class="admin-hint">Ngày hẹn:</span> @b.PreferredDate.ToString("dd/MM/yyyy") @b.PreferredTime</p>
            <p><span class="admin-hint">Xe:</span> @(b.Motorcycle?.Name ?? "—")</p>
            <p><span class="admin-hint">Chi nhánh:</span> @(b.Branch?.Name ?? "—")</p>
            <p><span class="admin-hint">Ghi chú KH:</span> @(b.Notes ?? "—")</p>
            @{
                var leadSrc = HieuNga.Application.LeadAttribution.ExtractSourceLabel(b.Notes);
            }
            @if (!string.IsNullOrWhiteSpace(leadSrc))
            {
                <p style="padding-top: 0.75rem; border-top: 1px solid var(--admin-border);">
                    <span class="admin-hint">Nguồn lead:</span>
                    <strong style="color: var(--admin-honda-red);">@leadSrc</strong>
                </p>
            }
        </div>
        <form method="post" class="admin-form-card">
            @Html.AntiForgeryToken()
            <div class="admin-form-stack">
                <div>
                    <label asp-for="Input.Status" class="admin-label">Trạng thái</label>
                    <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<BookingStatus>()" class="admin-select"></select>
                </div>
                <div>
                    <label asp-for="Input.AdminNotes" class="admin-label">Ghi chú admin</label>
                    <textarea asp-for="Input.AdminNotes" rows="4" class="admin-textarea"></textarea>
                </div>
            </div>
            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
            </div>
        </form>
    </div>
}
