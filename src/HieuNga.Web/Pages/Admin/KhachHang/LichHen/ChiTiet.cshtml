@page "/admin/khach-hang/lich-hen/{id:guid}"
@using HieuNga.Domain.Enums
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.KhachHang.LichHenDetailModel
@{
    string StatusLabel(BookingStatus s) => s switch
    {
        BookingStatus.Pending => "Chờ xác nhận",
        BookingStatus.Confirmed => "Đã xác nhận",
        BookingStatus.Completed => "Hoàn thành",
        BookingStatus.Cancelled => "Đã hủy",
        _ => "—"
    };
    string StatusTone(BookingStatus s) => s switch
    {
        BookingStatus.Pending => "new",
        BookingStatus.Confirmed => "confirmed",
        BookingStatus.Completed => "done",
        _ => "cancel"
    };
    IEnumerable<BookingStatus> AllowedStatuses(BookingStatus current)
    {
        yield return current;
        if (current == BookingStatus.Pending)
        {
            yield return BookingStatus.Confirmed;
            yield return BookingStatus.Completed;
            yield return BookingStatus.Cancelled;
        }
        else if (current == BookingStatus.Confirmed)
        {
            yield return BookingStatus.Completed;
            yield return BookingStatus.Cancelled;
        }
    }
}

<header class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Chi tiết lịch xem xe</h1>
        <p class="admin-page-subtitle"><a href="/admin/khach-hang/lich-hen" style="color: var(--admin-honda-red);">← Bảng lịch</a></p>
    </div>
</header>

@if (Model.Booking is not null)
{
    var b = Model.Booking;
    var leadSrc = HieuNga.Application.LeadAttribution.ExtractSourceLabel(b.Notes);
    var note = HieuNga.Application.LeadAttribution.StripTag(b.Notes);

    <div class="ride-detail">
        <section class="admin-card admin-card-padded">
            <h2 class="ride-detail-h">Khách hàng</h2>
            <p class="ride-detail-name">@b.CustomerName</p>
            <p><a class="book-card-phone" href="tel:@b.Phone">@b.Phone</a></p>
            @if (!string.IsNullOrWhiteSpace(b.Email))
            {
                <p class="admin-hint">@b.Email</p>
            }
        </section>

        <section class="admin-card admin-card-padded">
            <h2 class="ride-detail-h">Xe</h2>
            <p class="ride-detail-strong">@(b.Motorcycle?.Name ?? "Chưa chọn")</p>
        </section>

        <section class="admin-card admin-card-padded">
            <h2 class="ride-detail-h">Lịch hẹn</h2>
            <p class="ride-detail-strong">@b.PreferredDate.ToString("dd/MM/yyyy") · @(b.PreferredTime ?? "—")</p>
            <p class="admin-hint">Chi nhánh: @(b.Branch?.Name ?? "—")</p>
            <p class="admin-hint" style="margin-top:0.5rem;">
                <span class="book-badge book-badge-@StatusTone(b.Status)">@StatusLabel(b.Status)</span>
            </p>
            @if (!string.IsNullOrWhiteSpace(note))
            {
                <p style="margin-top:0.75rem;">Ghi chú khách: @note</p>
            }
            @if (!string.IsNullOrWhiteSpace(leadSrc))
            {
                <p class="admin-hint">Nguồn: @leadSrc</p>
            }
        </section>

        <section class="admin-card admin-card-padded">
            <h2 class="ride-detail-h">Ghi chú nội bộ</h2>
            <form method="post" class="admin-form-stack" data-ride-detail-form>
                @Html.AntiForgeryToken()
                <div>
                    <label asp-for="Input.Status" class="admin-label">Trạng thái</label>
                    <select asp-for="Input.Status" class="admin-select">
                        @foreach (var s in AllowedStatuses(b.Status).Distinct())
                        {
                            if (Model.Input.Status == s)
                            {
                                <option value="@((int)s)" selected>@StatusLabel(s)</option>
                            }
                            else
                            {
                                <option value="@((int)s)">@StatusLabel(s)</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="Input.AdminNotes" class="admin-label">Ghi chú</label>
                    <textarea asp-for="Input.AdminNotes" rows="4" class="admin-textarea"
                              placeholder="VD: Đã gọi, khách đến lúc 14h…"></textarea>
                </div>
                <div class="admin-form-actions">
                    <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
                </div>
            </form>
        </section>

        <section class="admin-card admin-card-padded">
            <h2 class="ride-detail-h">Lịch sử</h2>
            <p class="admin-hint">Tạo: @b.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            @if (b.UpdatedAt.HasValue)
            {
                <p class="admin-hint">Cập nhật: @b.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            }
        </section>
    </div>
}
