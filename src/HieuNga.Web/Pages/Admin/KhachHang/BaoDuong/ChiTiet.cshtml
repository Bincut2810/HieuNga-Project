@page "/admin/khach-hang/bao-duong/{id:guid}"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.KhachHang.BaoDuongDetailModel

<header class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Chi tiết bảo dưỡng</h1>
        <p class="admin-page-subtitle"><a href="/admin/khach-hang/bao-duong" style="color: var(--admin-honda-red);">← Danh sách</a></p>
    </div>
</header>

@if (Model.Booking is not null)
{
    var b = Model.Booking;
    <div class="admin-grid-2">
        <div class="admin-card admin-card-padded admin-form-stack">
            <p><strong>@b.CustomerName</strong> · @b.Phone</p>
            <p>Xe: @(b.MotorcycleModel ?? "—") · @(b.LicensePlate ?? "")</p>
            <p>Dịch vụ: @b.ServiceType</p>
            <p>Ngày: @b.PreferredDate.ToString("dd/MM/yyyy") @b.PreferredTime</p>
            <p>Ghi chú: @(b.Notes ?? "—")</p>
        </div>
        <form method="post" class="admin-form-card">
            @Html.AntiForgeryToken()
            <div class="admin-form-stack">
                <div>
                    <label asp-for="Input.Status" class="admin-label">Trạng thái</label>
                    <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<BookingStatus>()" class="admin-select"></select>
                </div>
                <div>
                    <label asp-for="Input.AdminNotes" class="admin-label">Ghi chú admin</label>
                    <textarea asp-for="Input.AdminNotes" rows="4" class="admin-textarea"></textarea>
                </div>
            </div>
            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
            </div>
        </form>
    </div>
}
