@page "/admin/khach-hang/bao-duong"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.KhachHang.BaoDuongIndexModel
@{
    string RangeClass(string value) =>
        string.Equals(Model.Range, value, StringComparison.OrdinalIgnoreCase) ? "book-chip is-active" : "book-chip";
}

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "Lịch bảo dưỡng",
             "Bảng lịch trong ngày — xác nhận / hoàn thành / hủy bằng một chạm.")' />

<div class="book-dash">
    <div class="book-dash-card">
        <p class="book-dash-label">Hôm nay</p>
        <p class="book-dash-value">@Model.Board.Counts.Today</p>
    </div>
    <div class="book-dash-card">
        <p class="book-dash-label">Chờ xác nhận</p>
        <p class="book-dash-value book-dash-warn">@Model.Board.Counts.Waiting</p>
    </div>
    <div class="book-dash-card">
        <p class="book-dash-label">Hoàn thành hôm nay</p>
        <p class="book-dash-value book-dash-ok">@Model.Board.Counts.CompletedToday</p>
    </div>
    <div class="book-dash-card">
        <p class="book-dash-label">Đã hủy</p>
        <p class="book-dash-value">@Model.Board.Counts.Cancelled</p>
    </div>
</div>

<form method="get" class="book-filters">
    <div class="book-chips">
        <a class="@RangeClass("today")" href="?range=today&q=@Uri.EscapeDataString(Model.Q ?? "")">Hôm nay</a>
        <a class="@RangeClass("tomorrow")" href="?range=tomorrow&q=@Uri.EscapeDataString(Model.Q ?? "")">Ngày mai</a>
        <a class="@RangeClass("week")" href="?range=week&q=@Uri.EscapeDataString(Model.Q ?? "")">Tuần này</a>
        <a class="@RangeClass("all")" href="?range=all&q=@Uri.EscapeDataString(Model.Q ?? "")">Tất cả</a>
    </div>
    <div class="book-search">
        <input type="hidden" name="range" value="@Model.Range" />
        <input name="q" value="@Model.Q" class="admin-input" placeholder="Tìm tên, SĐT, xe..." />
        <button type="submit" class="admin-btn admin-btn-secondary">Tìm</button>
    </div>
</form>

<div class="book-board">
    <partial name="Admin/KhachHang/BaoDuong/_BoardColumn" model='("Mới", "new", Model.NewItems, Model.Range, Model.Q)' />
    <partial name="Admin/KhachHang/BaoDuong/_BoardColumn" model='("Đã xác nhận", "confirmed", Model.ConfirmedItems, Model.Range, Model.Q)' />
    <partial name="Admin/KhachHang/BaoDuong/_BoardColumn" model='("Hoàn thành", "done", Model.CompletedItems, Model.Range, Model.Q)' />
    <partial name="Admin/KhachHang/BaoDuong/_BoardColumn" model='("Đã hủy", "cancel", Model.CancelledItems, Model.Range, Model.Q)' />
</div>
