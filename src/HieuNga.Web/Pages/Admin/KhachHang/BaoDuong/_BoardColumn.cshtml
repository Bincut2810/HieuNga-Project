@using HieuNga.Application.DTOs
@using HieuNga.Domain.Enums
@model (string Title, string Tone, IReadOnlyList<MaintenanceBookingDto> Items, string Range, string? Q)
@{
    string StatusLabel(BookingStatus s) => s switch
    {
        BookingStatus.Pending => "Mới",
        BookingStatus.Confirmed => "Đã xác nhận",
        BookingStatus.Completed => "Hoàn thành",
        BookingStatus.Cancelled => "Đã hủy",
        _ => s.ToString()
    };
}
<section class="book-col book-col-@Model.Tone">
    <header class="book-col-head">
        <h2>@Model.Title</h2>
        <span class="book-col-count">@Model.Items.Count</span>
    </header>
    <div class="book-col-body">
        @if (Model.Items.Count == 0)
        {
            <p class="book-empty">Không có lịch</p>
        }
        else
        {
            @foreach (var b in Model.Items)
            {
                <article class="book-card">
                    <div class="book-card-top">
                        <h3 class="book-card-name">@b.CustomerName</h3>
                        <span class="book-badge book-badge-@Model.Tone">@StatusLabel(b.Status)</span>
                    </div>
                    <a class="book-card-phone" href="tel:@b.Phone">@b.Phone</a>
                    <p class="book-card-line"><strong>Xe:</strong> @b.MotorcycleModel</p>
                    <p class="book-card-line"><strong>Dịch vụ:</strong> @b.ServiceType</p>
                    <p class="book-card-line">
                        <strong>Lịch:</strong>
                        @b.PreferredDate.ToString("dd/MM") · @b.PreferredTime
                    </p>
                    @if (!string.IsNullOrWhiteSpace(b.Notes))
                    {
                        <p class="book-card-note">@b.Notes</p>
                    }
                    <div class="book-card-actions">
                        <a class="book-action book-action-call" href="tel:@b.Phone">Gọi</a>
                        @if (b.Status == BookingStatus.Pending)
                        {
                            <form method="post" asp-page-handler="Confirm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@b.Id" />
                                <input type="hidden" name="range" value="@Model.Range" />
                                <input type="hidden" name="q" value="@Model.Q" />
                                <button type="submit" class="book-action book-action-confirm">Xác nhận</button>
                            </form>
                        }
                        @if (b.Status is BookingStatus.Pending or BookingStatus.Confirmed)
                        {
                            <form method="post" asp-page-handler="Complete">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@b.Id" />
                                <input type="hidden" name="range" value="@Model.Range" />
                                <input type="hidden" name="q" value="@Model.Q" />
                                <button type="submit" class="book-action book-action-done">Hoàn thành</button>
                            </form>
                            <form method="post" asp-page-handler="Cancel">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@b.Id" />
                                <input type="hidden" name="range" value="@Model.Range" />
                                <input type="hidden" name="q" value="@Model.Q" />
                                <button type="submit" class="book-action book-action-cancel"
                                        onclick="return confirm('Hủy lịch hẹn này?')">Hủy</button>
                            </form>
                        }
                    </div>
                </article>
            }
        }
    </div>
</section>
