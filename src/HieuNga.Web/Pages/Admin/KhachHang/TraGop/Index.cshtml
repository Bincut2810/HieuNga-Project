@page "/admin/khach-hang/tra-gop"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.KhachHang.TraGopLeadIndexModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Yêu cầu trả góp")' />

<form method="get" class="admin-toolbar">
    <div class="admin-toolbar-fields">
        <div class="admin-field">
            <label for="q" class="admin-label">Tìm kiếm</label>
            <input id="q" name="q" value="@Model.Q" placeholder="Tên, SĐT..." class="admin-input" />
        </div>
        <div class="admin-toolbar-actions">
            <button type="submit" class="admin-btn admin-btn-secondary">Lọc</button>
        </div>
    </div>
</form>

<div class="admin-card admin-table-wrap">
    <div class="admin-table-scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Giá xe</th>
                    <th>Xử lý</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <p class="admin-table-primary">@item.CustomerName</p>
                            <p class="admin-table-secondary">@item.Phone</p>
                        </td>
                        <td style="color: var(--admin-honda-red); font-weight: 600;">@item.VehiclePrice.ToVnd()</td>
                        <td>
                            @if (item.IsProcessed)
                            {
                                <span class="admin-badge admin-badge-success">Đã xử lý</span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-warning">Chờ</span>
                            }
                        </td>
                        <td class="text-right">
                            <a href="/admin/khach-hang/tra-gop/@item.Id" class="admin-action admin-action-edit">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
