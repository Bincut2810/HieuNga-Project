@page "/admin/khach-hang/tra-gop/{id:guid}"
@model HieuNga.Web.Pages.Admin.KhachHang.TraGopLeadDetailModel

<h1 class="text-2xl font-bold">Chi tiết yêu cầu trả góp</h1>
<p class="text-sm text-gray-500 mt-1"><a href="/admin/khach-hang/tra-gop" class="hover:text-honda-red">← Danh sách</a></p>

@if (Model.Lead is not null)
{
    var r = Model.Lead;
    <div class="mt-6 grid lg:grid-cols-2 gap-8">
        <div class="bg-white border rounded-2xl p-6 space-y-2 text-sm">
            <p><strong>@r.CustomerName</strong> · @r.Phone</p>
            <p>Xe: @(r.Motorcycle?.Name ?? "—")</p>
            <p>Giá xe: @r.VehiclePrice.ToVnd()</p>
            <p>Trả trước: @r.DownPayment.ToVnd() · @r.TermMonths tháng</p>
            <p>Trả hàng tháng: @(r.MonthlyPayment?.ToVnd() ?? "—")</p>
            <p>Ghi chú KH: @(r.Notes ?? "—")</p>
        </div>
        <form method="post" class="bg-white border rounded-2xl p-6">
            @Html.AntiForgeryToken()
            <label class="flex items-center gap-2 text-sm mb-4"><input asp-for="Input.IsProcessed" type="checkbox" /> Đã xử lý</label>
            <div><label asp-for="Input.AdminNotes" class="block text-sm font-medium mb-1">Ghi chú admin</label><textarea asp-for="Input.AdminNotes" rows="4" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea></div>
            <button type="submit" class="mt-4 bg-honda-red text-white px-4 py-2 rounded-lg font-semibold">Lưu</button>
        </form>
    </div>
}
