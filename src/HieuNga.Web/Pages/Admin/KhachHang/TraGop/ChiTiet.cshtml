@page "/admin/khach-hang/tra-gop/{id:guid}"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.KhachHang.TraGopLeadDetailModel

<header class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Chi tiết yêu cầu trả góp</h1>
        <p class="admin-page-subtitle"><a href="/admin/khach-hang/tra-gop" style="color: var(--admin-honda-red);">← Danh sách</a></p>
    </div>
</header>

@if (Model.Lead is not null)
{
    var r = Model.Lead;
    <div class="admin-grid-2">
        <div class="admin-card admin-card-padded admin-form-stack">
            <p><strong>@r.CustomerName</strong> · @r.Phone</p>
            <p>Xe: @(r.Motorcycle?.Name ?? "—")</p>
            <p>Giá xe: @r.VehiclePrice.ToVnd()</p>
            <p>Trả trước: @r.DownPayment.ToVnd() · @r.TermMonths tháng</p>
            <p>Trả hàng tháng: @(r.MonthlyPayment?.ToVnd() ?? "—")</p>
            <p>Ghi chú KH: @(r.Notes ?? "—")</p>
            @{
                var leadSrc = HieuNga.Application.LeadAttribution.ExtractSourceLabel(r.Notes);
            }
            @if (!string.IsNullOrWhiteSpace(leadSrc))
            {
                <p style="padding-top: 0.75rem; border-top: 1px solid var(--admin-border);">
                    <span class="admin-hint">Nguồn lead:</span>
                    <strong style="color: var(--admin-honda-red);">@leadSrc</strong>
                </p>
            }
        </div>
        <form method="post" class="admin-form-card">
            @Html.AntiForgeryToken()
            <div class="admin-form-stack">
                <label class="admin-check"><input asp-for="Input.IsProcessed" type="checkbox" /> Đã xử lý</label>
                <div>
                    <label asp-for="Input.AdminNotes" class="admin-label">Ghi chú admin</label>
                    <textarea asp-for="Input.AdminNotes" rows="4" class="admin-textarea"></textarea>
                </div>
            </div>
            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
            </div>
        </form>
    </div>
}
