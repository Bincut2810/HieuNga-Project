@page "/admin/xe"
@using HieuNga.Domain
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Xe.IndexModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "Motorcycles",
             "Quản lý danh sách xe, media và trạng thái trên website.",
             "/admin/xe/editor",
             "+ Thêm xe")' />

<div class="admin-stat-grid">
    <div class="admin-stat">
        <p class="admin-stat-label">Tổng số xe</p>
        <p class="admin-stat-value">@Model.TotalCount</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-label">Đang hiển thị</p>
        <p class="admin-stat-value admin-stat-value-accent">@Model.PublishedCount</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-label">Đang ẩn</p>
        <p class="admin-stat-value">@Model.HiddenCount</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-label">Loại xe</p>
        <p class="admin-stat-value">@Model.CategoryTypeCount</p>
    </div>
</div>

<form method="get" class="admin-toolbar">
    <div class="admin-toolbar-fields">
        <div class="admin-field">
            <label for="q" class="admin-label">Tìm kiếm</label>
            <input type="search" id="q" name="q" value="@Model.Q" placeholder="Tên xe, slug..."
                   class="admin-input" />
        </div>
        <div class="admin-field admin-field-sm">
            <label for="category" class="admin-label">Loại xe</label>
            <select id="category" name="category" asp-items="Model.CategoryOptions" class="admin-select">
                <option value="">Tất cả loại</option>
            </select>
        </div>
        <div class="admin-field admin-field-sm">
            <label for="status" class="admin-label">Trạng thái</label>
            <select id="status" name="status" class="admin-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Status) ? "selected" : null)">Tất cả</option>
                <option value="active" selected="@(Model.Status == "active" ? "selected" : null)">Đang hiển thị</option>
                <option value="inactive" selected="@(Model.Status == "inactive" ? "selected" : null)">Đang ẩn</option>
            </select>
        </div>
        <div class="admin-toolbar-actions">
            <button type="submit" class="admin-btn admin-btn-secondary">Lọc</button>
            @if (Model.HasActiveFilters)
            {
                <a href="/admin/xe" class="admin-btn admin-btn-ghost">Đặt lại</a>
            }
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <partial name="Admin/Shared/_AdminEmptyState"
             model='new AdminEmptyStateModel(
                 "Chưa có xe nào phù hợp",
                 Model.HasActiveFilters ? "Thử đổi bộ lọc hoặc xóa lọc để xem thêm." : "Thêm xe đầu tiên để hiển thị trên website.",
                 Model.HasActiveFilters ? "/admin/xe" : "/admin/xe/editor",
                 Model.HasActiveFilters ? "Đặt lại bộ lọc" : "+ Thêm xe")' />
}
else
{
    <div class="admin-inventory-list">
        @foreach (var item in Model.Items)
        {
            var mediaPct = item.MediaPercent;
            <article class="admin-moto-row">
                <div class="admin-moto-thumb">
                    @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                    {
                        <img src="@item.ThumbnailUrl" alt="" loading="lazy" width="72" height="72" />
                    }
                    else
                    {
                        <div class="admin-moto-thumb-empty">No img</div>
                    }
                </div>
                <div>
                    <h2 class="admin-moto-title">@item.Name</h2>
                    <p class="admin-moto-slug">/@item.Slug</p>
                    <p class="admin-price" style="margin:0.35rem 0 0;font-size:0.875rem;">@item.BasePrice.ToVnd()</p>
                </div>
                <div class="admin-moto-row-meta">
                    <span class="admin-badge admin-badge-category">@item.Category.ToDisplayName()</span>
                    @if (item.IsPublished)
                    {
                        <span class="admin-badge admin-badge-success">Hiển thị</span>
                    }
                    else
                    {
                        <span class="admin-badge admin-badge-muted">Ẩn</span>
                    }
                    <span class="admin-media-meter" title="Media completeness">
                        <span class="admin-media-meter-bar"><span class="admin-media-meter-fill" style="width:@mediaPct%"></span></span>
                        <span>Media @mediaPct%</span>
                    </span>
                    <span>Cập nhật @(item.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</span>
                </div>
                <div class="admin-moto-row-actions">
                    <a href="/admin/xe/editor/@item.Id" class="admin-btn admin-btn-primary">Edit</a>
                    <a href="/xe/@item.Slug" target="_blank" rel="noopener" class="admin-btn admin-btn-ghost">Xem</a>
                    <form method="post" asp-page-handler="TogglePublish" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="q" value="@Model.Q" />
                        <input type="hidden" name="category" value="@((int?)Model.Category)" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <button type="submit" class="admin-btn admin-btn-secondary"
                                onclick="return confirm('@(item.IsPublished ? "Ẩn xe này khỏi website?" : "Hiển thị lại xe này?")')">
                            @(item.IsPublished ? "Ẩn" : "Hiện")
                        </button>
                    </form>
                    <a href="/admin/xe/xoa/@item.Id" class="admin-btn admin-btn-danger">Xóa</a>
                </div>
            </article>
        }
    </div>
    <p class="admin-muted admin-section-gap">@Model.Items.Count xe</p>
}
