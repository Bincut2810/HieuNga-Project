@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Xe.EditorModel

@{
    var status = Model.PublishStatus ?? "draft";
    var badgeClass = status switch
    {
        "published" => "admin-badge admin-badge-success",
        "archived" => "admin-badge admin-badge-muted",
        _ => "admin-badge admin-badge-category"
    };
    var statusLabel = status switch
    {
        "published" => "Đang bán",
        "archived" => "Ngừng bán",
        _ => "Bản nháp"
    };
    var publicUrl = string.IsNullOrEmpty(Model.PublicSlug) ? null : $"/xe/{Model.PublicSlug}";
}

<form method="post" asp-page-handler="SavePublish" class="admin-form-card" style="max-width:44rem;" data-dirty-form id="moto-publish-form">
    @Html.AntiForgeryToken()
    @if (Model.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }
    <input type="hidden" name="Tab" value="publish" />

    <div class="mm-section-head">
        <h2 class="admin-form-section-title">Đăng bán</h2>
        @if (!Model.IsCreate)
        {
            <span class="@badgeClass">@statusLabel</span>
        }
    </div>

    @if (Model.IsCreate)
    {
        <p class="admin-hint">Tạo xe ở mục Thông tin trước.</p>
        <a href="/admin/xe/editor?tab=general" class="admin-btn-secondary">Về Thông tin</a>
    }
    else
    {
        <fieldset style="border:none;padding:0;margin:1rem 0 0;display:flex;flex-direction:column;gap:0.75rem;">
            <legend class="admin-label">Trạng thái bán</legend>
            <label class="admin-publish-option">
                <input type="radio" asp-for="PublishStatus" value="draft" />
                <span><strong>Bản nháp</strong><span class="admin-hint">Chưa đăng, chỉ bạn xem được trong trang quản trị.</span></span>
            </label>
            <label class="admin-publish-option">
                <input type="radio" asp-for="PublishStatus" value="published" />
                <span><strong>Đang bán</strong><span class="admin-hint">Hiển thị trên website cho khách xem.</span></span>
            </label>
            <label class="admin-publish-option">
                <input type="radio" asp-for="PublishStatus" value="archived" />
                <span><strong>Ngừng bán</strong><span class="admin-hint">Ẩn khỏi website và bỏ khỏi Xe nổi bật.</span></span>
            </label>
        </fieldset>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.25rem;">
            <div>
                <label asp-for="Input.SortOrder" class="admin-label">Thứ tự hiển thị</label>
                <input asp-for="Input.SortOrder" type="number" class="admin-input" />
                <p class="admin-hint" style="margin: 0.3rem 0 0;">Số nhỏ hiển thị trước.</p>
            </div>
            <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;padding-top:1.5rem;">
                <input asp-for="Input.IsFeatured" type="checkbox" style="accent-color:var(--admin-honda-red);" />
                Xe nổi bật
            </label>
        </div>

        @if (publicUrl is not null)
        {
            <div class="admin-card admin-card-padded" style="margin-top:1.25rem;">
                <p class="admin-label">Đường dẫn công khai</p>
                <p style="font-family:ui-monospace,monospace;font-size:0.85rem;margin:0.35rem 0;">@publicUrl</p>
                <a href="@publicUrl" target="_blank" rel="noopener" class="admin-btn-secondary">Mở trang công khai</a>
            </div>
        }

        <partial name="Admin/Xe/_EditorSaveBar" model='new EditorSaveBarModel(Model.PublicSlug, "Lưu thay đổi", null, true)' />
    }
</form>

@if (!Model.IsCreate)
{
    <form method="post" asp-page-handler="DuplicateMotorcycle" class="admin-form-card" style="max-width:44rem;margin-top:1rem;"
          data-confirm-form data-confirm-title="Nhân bản xe?" data-confirm-body="Tạo bản sao bản nháp kèm ảnh, màu và tính năng." data-confirm-ok="Nhân bản" data-confirm-cancel="Hủy">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <h2 class="admin-form-section-title">Nhân bản xe</h2>
        <p class="admin-hint" style="margin:0.5rem 0 1rem;">Tạo bản sao bản nháp (kèm ảnh, màu xe, tính năng).</p>
        <button type="submit" class="admin-btn-secondary">Nhân bản xe</button>
    </form>
}
