@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Xe.EditorModel

@if (Model.IsCreate)
{
    <partial name="Admin/Shared/_AdminEmptyState"
             model='new AdminEmptyStateModel("Lưu xe trước", "Lưu thông tin xe (Draft), rồi quay lại để thêm hình ảnh.", "/admin/xe/editor?tab=general", "Lưu Draft")' />
}
else
{
    <div class="admin-editor-panel">
        <div id="media-studio"
             class="ms-root"
             data-media-studio
             data-motorcycle-id="@Model.Id"
             data-api="/admin/api/xe/@Model.Id/media">
            <div class="ms-loading">Đang tải hình ảnh…</div>
        </div>
        <div class="admin-editor-savebar" data-editor-savebar>
            <div class="admin-editor-savebar-inner">
                <p class="admin-muted" style="margin:0;">Hình ảnh tự lưu khi bạn kéo vào — không cần bấm Lưu.</p>
                <div class="admin-editor-savebar-actions">
                    <a href="/admin/xe" class="admin-btn admin-btn-ghost">Quay lại</a>
                    @if (!string.IsNullOrEmpty(Model.PublicSlug))
                    {
                        <a href="/xe/@Model.PublicSlug" target="_blank" rel="noopener" class="admin-btn admin-btn-secondary">Xem trang bán</a>
                    }
                    <a href="/admin/xe/editor/@Model.Id?tab=publish" class="admin-btn admin-btn-primary">Đăng bán</a>
                </div>
            </div>
        </div>
    </div>
}
