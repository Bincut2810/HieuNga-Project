@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Xe.EditorModel

@if (Model.IsCreate)
{
    <partial name="Admin/Shared/_AdminEmptyState"
             model='new AdminEmptyStateModel("Lưu xe trước", "Media Studio mở sau khi tạo Draft.", "/admin/xe/editor?tab=general", "Quick Create")' />
}
else
{
    <div id="media-studio"
         class="ms-root"
         data-media-studio
         data-motorcycle-id="@Model.Id"
         data-api="/admin/api/xe/@Model.Id/media">
        <div class="ms-loading">Đang tải Media Studio…</div>
    </div>
}
