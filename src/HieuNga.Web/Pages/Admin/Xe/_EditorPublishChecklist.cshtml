@model HieuNga.Web.Pages.Admin.Xe.EditorModel
@using HieuNga.Domain
@{
    var hasThumb = !string.IsNullOrWhiteSpace(Model.Input.ThumbnailUrl);
    var hasColorImage = Model.Colors.Any(c => !string.IsNullOrWhiteSpace(c.ImageUrl));
    var filledAngles = Model.SpinFrames
        .Where(s => !string.IsNullOrWhiteSpace(s.ImageUrl))
        .Select(s => s.Angle)
        .Distinct()
        .Count();
    var hasSixAngles = filledAngles >= MotorcycleViewAngleCatalog.Count;
    var hasPrice = Model.Input.BasePrice > 0 || Model.Variants.Any(v => v.Price > 0);
    var ready = hasThumb && hasColorImage && hasPrice;
    string ItemClass(bool ok) => "admin-checklist-item" + (ok ? " is-done" : "");
}

<aside class="admin-checklist" aria-label="Kiểm tra trước khi đăng">
    <h2 class="admin-checklist-title">Trước khi đăng</h2>
    <ul class="admin-checklist-list">
        <li class="@ItemClass(hasThumb)"><span class="admin-checklist-dot"></span> Có ảnh đại diện</li>
        <li class="@ItemClass(hasColorImage)"><span class="admin-checklist-dot"></span> Có ít nhất 1 màu có ảnh</li>
        <li class="@ItemClass(hasSixAngles)"><span class="admin-checklist-dot"></span> 6 góc xe @(hasSixAngles ? "" : $"(tuỳ chọn · {filledAngles}/6)")</li>
        <li class="@ItemClass(hasPrice)"><span class="admin-checklist-dot"></span> Có giá bán</li>
    </ul>
    @if (ready)
    {
        <p class="admin-checklist-status is-ready">Sẵn sàng đăng</p>
    }
    else
    {
        <p class="admin-checklist-status is-warn">Còn thiếu thông tin / hình</p>
    }
</aside>
