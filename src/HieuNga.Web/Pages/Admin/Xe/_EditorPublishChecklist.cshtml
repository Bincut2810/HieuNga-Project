@model HieuNga.Web.Pages.Admin.Xe.EditorModel
@{
    var hasThumb = !string.IsNullOrWhiteSpace(Model.Input.ThumbnailUrl);
    var hasGallery = Model.Gallery.Count >= 1;
    var hasAngles = Model.SpinFrames.Count >= 2;
    var hasColors = Model.Colors.Count >= 1;
    var hasPrice = Model.Input.BasePrice > 0 || Model.Variants.Any(v => v.Price > 0);
    var hasSpecs = !string.IsNullOrWhiteSpace(Model.SpecsLines);
    var hasSeo = !string.IsNullOrWhiteSpace(Model.Input.MetaTitle)
        || !string.IsNullOrWhiteSpace(Model.Input.MetaDescription);
    var done = (hasThumb ? 1 : 0) + (hasGallery ? 1 : 0) + (hasAngles ? 1 : 0)
        + (hasColors ? 1 : 0) + (hasPrice ? 1 : 0) + (hasSpecs ? 1 : 0) + (hasSeo ? 1 : 0);
    var ready = done >= 7;
    string ItemClass(bool ok) => "admin-checklist-item" + (ok ? " is-done" : "");
}

<aside class="admin-checklist" aria-label="Publish checklist">
    <h2 class="admin-checklist-title">Publish checklist</h2>
    <ul class="admin-checklist-list">
        <li class="@ItemClass(hasThumb)"><span class="admin-checklist-dot"></span> Thumbnail</li>
        <li class="@ItemClass(hasGallery)"><span class="admin-checklist-dot"></span> Gallery</li>
        <li class="@ItemClass(hasAngles)"><span class="admin-checklist-dot"></span> Angles</li>
        <li class="@ItemClass(hasColors)"><span class="admin-checklist-dot"></span> Colors</li>
        <li class="@ItemClass(hasPrice)"><span class="admin-checklist-dot"></span> Price</li>
        <li class="@ItemClass(hasSpecs)"><span class="admin-checklist-dot"></span> Specs</li>
        <li class="@ItemClass(hasSeo)"><span class="admin-checklist-dot"></span> SEO</li>
    </ul>
    @if (ready)
    {
        <p class="admin-checklist-status is-ready">Ready to Publish</p>
    }
    else
    {
        <p class="admin-checklist-status is-warn">@done / 7 hoàn thành</p>
    }
</aside>
