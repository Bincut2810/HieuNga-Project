@model HieuNga.Web.Pages.Admin.Xe.MotorcycleInputModel
@{
    var categoryOptions = ViewData["CategoryOptions"] as SelectList;
    var supportsUpload = ViewData["SupportsImageUpload"] as bool? ?? false;
    var storageNote = ViewData["ImageStorageNote"] as string ?? string.Empty;
    var currentThumbnail = Model.ThumbnailUrl;
}

<div class="space-y-0">
    <section class="admin-form-section">
        <h2 class="admin-form-section-title">Thông tin cơ bản</h2>
        <div class="space-y-4" style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label asp-for="Name" class="admin-label">Tên xe <span class="admin-label-required">*</span></label>
                <input asp-for="Name" id="moto-name" class="admin-input" />
                <span asp-validation-for="Name" class="admin-validation"></span>
            </div>
            <div>
                <label asp-for="Slug" class="admin-label">Slug</label>
                <input asp-for="Slug" id="moto-slug" class="admin-input" placeholder="tu-dong-tao-tu-ten" />
                <p class="admin-hint">Để trống để tự tạo từ tên xe.</p>
                <span asp-validation-for="Slug" class="admin-validation"></span>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                <div>
                    <label asp-for="Category" class="admin-label">Loại xe <span class="admin-label-required">*</span></label>
                    <select asp-for="Category" asp-items="categoryOptions" class="admin-select">
                        <option value="">-- Chọn loại --</option>
                    </select>
                    <span asp-validation-for="Category" class="admin-validation"></span>
                </div>
                <div>
                    <label asp-for="BasePrice" class="admin-label">Giá niêm yết (VNĐ)</label>
                    <input asp-for="BasePrice" type="number" step="1000" class="admin-input" />
                </div>
            </div>
            <div>
                <label asp-for="ThumbnailUrl" class="admin-label">Thumbnail URL (tuỳ chọn)</label>
                <input asp-for="ThumbnailUrl" class="admin-input" placeholder="Để trống nếu đã tải file" />
                <p class="admin-hint">Ưu tiên tải file bên dưới. URL chỉ dùng khi cần.</p>
            </div>
            <partial name="Admin/Shared/_AdminUploadField"
                     model='new HieuNga.Web.Pages.Admin.Extensions.AdminUploadFieldModel(
                         "ThumbnailFile",
                         "Tải ảnh thumbnail",
                         Hint: storageNote,
                         PreviewUrl: string.IsNullOrWhiteSpace(currentThumbnail) ? null : currentThumbnail,
                         Enabled: supportsUpload,
                         DisabledMessage: storageNote)' />
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; align-items: end;">
                <div>
                    <label asp-for="SortOrder" class="admin-label">Thứ tự hiển thị</label>
                    <input asp-for="SortOrder" type="number" class="admin-input" />
                </div>
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; padding-bottom: 0.5rem;">
                    <input asp-for="IsPublished" type="checkbox" class="rounded" style="accent-color: var(--admin-honda-red);" />
                    Hiển thị trên website
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; padding-bottom: 0.5rem;">
                    <input asp-for="IsFeatured" type="checkbox" class="rounded" style="accent-color: var(--admin-honda-red);" />
                    Xe nổi bật
                </label>
            </div>
        </div>
    </section>

    <section class="admin-form-section">
        <h2 class="admin-form-section-title">Nội dung hiển thị</h2>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label asp-for="ShortDescription" class="admin-label">Mô tả ngắn</label>
                <textarea asp-for="ShortDescription" rows="2" class="admin-textarea"></textarea>
            </div>
            <div>
                <label asp-for="Description" class="admin-label">Mô tả chi tiết</label>
                <textarea asp-for="Description" rows="5" class="admin-textarea"></textarea>
            </div>
        </div>
    </section>

    <partial name="Admin/Shared/_SeoFields" model="Model" />
</div>
