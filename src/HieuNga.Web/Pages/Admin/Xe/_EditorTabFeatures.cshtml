@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Xe.EditorModel

@if (Model.IsCreate)
{
    <partial name="Admin/Shared/_AdminEmptyState"
             model='new AdminEmptyStateModel("Lưu xe trước", "Trình tạo tính năng &amp; công nghệ mở sau khi tạo xe.", "/admin/xe/editor?tab=general", "Tạo xe nhanh")' />
}
else
{
    <div class="admin-editor-panel" style="display:flex;flex-direction:column;gap:1.25rem;max-width:64rem;">
        <partial name="Admin/Xe/_ContentCardBuilder" model='new ContentCardBuilderModel(
            Model.Id!.Value,
            "feature",
            "Tính năng nổi bật",
            "Điểm nổi bật trên trang chi tiết — kéo để sắp xếp.",
            "AddFeature",
            "UpdateFeature",
            "DeleteFeature",
            "DuplicateFeature",
            "ReorderFeatures",
            Model.SupportsImageUpload,
            Model.Features.Select(f => new ContentCardItemModel(f.Id, f.Title, f.Description, f.ImageUrl, f.SortOrder)).ToList())' />

        <partial name="Admin/Xe/_ContentCardBuilder" model='new ContentCardBuilderModel(
            Model.Id!.Value,
            "tech",
            "Công nghệ",
            "Khối công nghệ xen kẽ ảnh/text trên trang chi tiết.",
            "AddTech",
            "UpdateTech",
            "DeleteTech",
            "DuplicateTech",
            "ReorderTech",
            Model.SupportsImageUpload,
            Model.Technologies.Select(t => new ContentCardItemModel(t.Id, t.Title, t.Description, t.ImageUrl, t.SortOrder)).ToList())' />

        <div class="admin-editor-savebar" data-editor-savebar>
            <div class="admin-editor-savebar-inner">
                <p class="admin-muted" style="margin:0;">Tính năng được lưu theo từng thẻ</p>
                <div class="admin-editor-savebar-actions">
                    <a href="/admin/xe" class="admin-btn admin-btn-ghost">Hủy</a>
                    @if (!string.IsNullOrEmpty(Model.PublicSlug))
                    {
                        <a href="/xe/@Model.PublicSlug" target="_blank" rel="noopener" class="admin-btn admin-btn-secondary">Xem trước</a>
                    }
                    <a href="/admin/xe/editor/@Model.Id?tab=publish" class="admin-btn admin-btn-primary">Đăng bán</a>
                </div>
            </div>
        </div>
    </div>
}
