@page "/admin/xe/xoa/{id:guid}"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Xe.XoaModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Xóa xe", "Xác nhận xóa xe khỏi danh sách quản trị.")' />

<div class="admin-card admin-card-padded" style="max-width: 32rem;">
    <p>Bạn có chắc muốn xóa xe <strong>@Model.Name</strong>? Hành động này có thể hoàn tác trong database.</p>
    <form method="post" class="admin-form-actions" style="border-top: none; margin-top: 1.25rem; padding-top: 0;">
        @Html.AntiForgeryToken()
        <button type="submit" class="admin-btn admin-btn-danger">Xác nhận xóa</button>
        <a href="/admin/xe/editor/@Model.Id" class="admin-btn admin-btn-secondary">Hủy</a>
    </form>
</div>
