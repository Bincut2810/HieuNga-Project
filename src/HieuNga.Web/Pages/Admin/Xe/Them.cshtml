@page "/admin/xe/them"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Xe.ThemModel

<partial name="Admin/Shared/_AdminBreadcrumb" model='new List<AdminBreadcrumbItem> {
    new("Admin", "/admin"),
    new("Xe máy", "/admin/xe"),
    new("Thêm")
}' />

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Thêm xe mới</h1>
        <p class="admin-page-subtitle">Nhập thông tin xe để hiển thị trên website showroom.</p>
    </div>
    <a href="/admin/xe" class="admin-btn-secondary">Quay lại danh sách</a>
</div>

<form method="post" enctype="multipart/form-data" id="moto-form" class="admin-form-card" style="max-width: 48rem;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="admin-validation-summary"></div>
    <partial name="Admin/Xe/_MotorcycleForm" model="Model.Input" />
    <div class="admin-form-actions admin-form-actions-sticky">
        <button type="submit" class="admin-btn-primary">Lưu xe</button>
        <a href="/admin/xe" class="admin-btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var nameInput = document.getElementById('moto-name');
            var slugInput = document.getElementById('moto-slug');
            var slugTouched = false;
            if (slugInput) slugInput.addEventListener('input', function () { slugTouched = true; });
            function toSlug(text) {
                return text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
                    .replace(/đ/g, 'd').replace(/[^a-z0-9\s-]/g, '').trim()
                    .replace(/\s+/g, '-').replace(/-+/g, '-');
            }
            if (nameInput && slugInput) {
                nameInput.addEventListener('input', function () {
                    if (!slugTouched) slugInput.value = toSlug(nameInput.value);
                });
            }
        })();
    </script>
}
