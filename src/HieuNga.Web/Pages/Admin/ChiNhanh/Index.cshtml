@page "/admin/chi-nhanh"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.ChiNhanh.IndexModel
@{
    ViewData["Title"] = "Chi nhánh";
}

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "Chi nhánh",
             "Địa điểm showroom và thông tin liên hệ.",
             "/admin/chi-nhanh/them",
             "+ Thêm chi nhánh")' />

@if (Model.Branches.Count == 0)
{
    <partial name="Admin/Shared/_AdminEmptyState"
             model='new AdminEmptyStateModel("Chưa có chi nhánh", "Thêm chi nhánh để hiển thị trên trang Liên hệ.", "/admin/chi-nhanh/them", "+ Thêm chi nhánh")' />
}
else
{
    <div class="admin-list">
        @foreach (var b in Model.Branches)
        {
            var eyebrow = b.IsHeadOffice
                ? (b.IsActive ? "Trụ sở" : "Trụ sở · Tạm ẩn")
                : (b.IsActive ? "Chi nhánh" : "Chi nhánh · Tạm ẩn");
            <partial name="Admin/Shared/_AdminListItem"
                     model='new AdminListItemModel(
                         b.Name,
                         eyebrow,
                         $"{b.Address} · {b.Hotline}",
                         $"/admin/chi-nhanh/sua/{b.Id}")' />
        }
    </div>
}
