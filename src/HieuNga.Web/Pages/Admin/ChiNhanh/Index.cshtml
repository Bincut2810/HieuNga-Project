@page "/admin/chi-nhanh"
@model HieuNga.Web.Pages.Admin.ChiNhanh.IndexModel

<div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold">Chi nhánh</h1>
    <a href="/admin/chi-nhanh/them" class="bg-honda-red text-white px-4 py-2 rounded-lg font-semibold text-sm">+ Thêm chi nhánh</a>
</div>
<div class="mt-8 grid gap-6">
    @foreach (var b in Model.Branches)
    {
        <div class="bg-white border rounded-xl p-6 flex flex-wrap justify-between gap-4 items-center">
            <div>
                <h3 class="font-bold">@b.Name</h3>
                <p class="text-gray-600 mt-2">@b.Address</p>
                <p class="text-honda-red font-medium mt-2">@b.Hotline</p>
            </div>
            <a href="/admin/chi-nhanh/sua/@b.Id" class="text-honda-red font-semibold text-sm">Sửa →</a>
        </div>
    }
</div>
