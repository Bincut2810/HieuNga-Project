@model IReadOnlyList<HieuNga.Web.ViewModels.Admin.BookingCenter.BookingCenterTimelineGroupVm>
@{
    var empty = ViewData["BcEmpty"] as string ?? "Không có lịch hẹn.";
}
@if (Model.Count == 0)
{
    <div class="bc-empty" role="status">
        <p class="bc-empty-title">@empty</p>
        <p class="bc-empty-hint">Thử đổi bộ lọc hoặc tìm kiếm khác.</p>
    </div>
}
else
{
    <div class="bc-timeline" aria-label="Lịch theo giờ">
        @foreach (var group in Model)
        {
            <section class="bc-timeline-slot" aria-labelledby="bc-slot-@group.TimeLabel.Replace(":", "")">
                <header class="bc-timeline-head" id="bc-slot-@group.TimeLabel.Replace(":", "")">
                    <span class="bc-timeline-time">@group.TimeLabel</span>
                    <span class="bc-timeline-count">@group.Items.Count</span>
                </header>
                <div class="bc-timeline-cards">
                    @foreach (var item in group.Items)
                    {
                        <partial name="Admin/Bookings/_BookingCard" model="item" />
                    }
                </div>
            </section>
        }
    </div>
}
