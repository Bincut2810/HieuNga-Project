@page "/admin/dich-vu/bang-gia"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.DichVu.BangGiaIndexModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "Dịch vụ",
             "Tải ảnh, viết tên — xuất bản lên trang dịch vụ.",
             "/admin/dich-vu/bang-gia/them",
             "+ Thêm dịch vụ")' />

<form method="get" class="admin-toolbar">
    <div class="admin-toolbar-fields">
        <div class="admin-field">
            <label for="search" class="admin-label">Tìm theo tên</label>
            <input type="search" id="search" name="search" value="@Model.Search"
                   placeholder="Nhập tên dịch vụ..." class="admin-input" />
        </div>
        <div class="admin-field admin-field-sm">
            <label for="status" class="admin-label">Trạng thái</label>
            <select id="status" name="status" class="admin-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Status) ? "selected" : null)">Tất cả</option>
                <option value="active" selected="@(Model.Status == "active" ? "selected" : null)">Đang hiển thị</option>
                <option value="inactive" selected="@(Model.Status == "inactive" ? "selected" : null)">Đang ẩn</option>
            </select>
        </div>
        <div class="admin-toolbar-actions">
            <button type="submit" class="admin-btn admin-btn-secondary">Lọc</button>
            @if (Model.HasActiveFilters)
            {
                <a href="/admin/dich-vu/bang-gia" class="admin-btn admin-btn-ghost">Đặt lại</a>
            }
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <partial name="Admin/Shared/_AdminEmptyState"
             model='new AdminEmptyStateModel(
                 "Chưa có dịch vụ",
                 Model.HasActiveFilters ? "Thử đổi bộ lọc." : "Thêm dịch vụ đầu tiên.",
                 "/admin/dich-vu/bang-gia/them",
                 "+ Thêm dịch vụ")' />
}
else
{
    <div class="admin-media-grid">
        @foreach (var item in Model.Items)
        {
            <div class="admin-media-card">
                <div class="admin-media-card-image">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" />
                    }
                    else
                    {
                        <div class="admin-media-card-placeholder">@item.Name.Substring(0, 1)</div>
                    }
                </div>
                <div class="admin-media-card-body">
                    <div>
                        <h3 class="admin-media-card-title">@item.Name</h3>
                        <p class="admin-media-card-meta">
                            @(item.IsActive ? "Đang hiển thị" : "Đang ẩn") · Thứ tự @item.DisplayOrder
                        </p>
                    </div>
                    <div class="admin-actions">
                        <a href="/admin/dich-vu/bang-gia/sua/@item.Id" class="admin-action admin-action-edit">Sửa</a>
                        <a href="/dich-vu/@item.Slug" target="_blank" rel="noopener" class="admin-action admin-action-view">Xem</a>
                        <form method="post" asp-page-handler="ToggleActive" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="search" value="@Model.Search" />
                            <input type="hidden" name="status" value="@Model.Status" />
                            <button type="submit" class="admin-action admin-action-muted"
                                    onclick="return confirm('@(item.IsActive ? "Ẩn dịch vụ này?" : "Xuất bản dịch vụ này?")')">
                                @(item.IsActive ? "Ẩn" : "Xuất bản")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
