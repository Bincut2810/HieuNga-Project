@page "/admin/dich-vu/bang-gia/them"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.DichVu.BangGiaThemModel

<partial name="Admin/Shared/_AdminBreadcrumb" model='new List<AdminBreadcrumbItem> {
    new("Admin", "/admin"),
    new("Dịch vụ"),
    new("Bảng giá", "/admin/dich-vu/bang-gia"),
    new("Thêm")
}' />

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Thêm dịch vụ mới</h1>
        <p class="admin-page-subtitle">Tạo dịch vụ bảo dưỡng/sửa chữa hiển thị trên trang bảo dưỡng.</p>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <a href="/admin/dich-vu/bang-gia" class="admin-btn-secondary">Quay lại danh sách</a>
        <button type="submit" form="service-form" name="submitAction" value="save" class="admin-btn-primary">Tạo dịch vụ</button>
    </div>
</div>

<form method="post" id="service-form" class="admin-form-card" style="max-width: 48rem;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="admin-validation-summary"></div>
    <partial name="Admin/DichVu/_ServiceItemForm" model="Model.Input" />
    <div class="admin-form-actions admin-form-actions-sticky">
        <button type="submit" name="submitAction" value="save" class="admin-btn-primary">Tạo dịch vụ</button>
        <button type="submit" name="submitAction" value="continue" class="admin-btn-secondary">Lưu và tiếp tục chỉnh sửa</button>
        <a href="/admin/dich-vu/bang-gia" class="admin-btn-ghost">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const nameInput = document.getElementById('service-name');
            const slugInput = document.getElementById('service-slug');
            let slugTouched = false;
            if (slugInput) slugInput.addEventListener('input', () => { slugTouched = true; });
            function toSlug(text) {
                return text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
                    .replace(/đ/g, 'd').replace(/[^a-z0-9\s-]/g, '').trim()
                    .replace(/\s+/g, '-').replace(/-+/g, '-');
            }
            if (nameInput && slugInput) {
                nameInput.addEventListener('input', () => {
                    if (!slugTouched) slugInput.value = toSlug(nameInput.value);
                    updatePreview();
                });
            }
            function updatePreview() {
                const cat = document.getElementById('service-category');
                const previewCat = document.getElementById('preview-category');
                const previewName = document.getElementById('preview-name');
                const previewShort = document.getElementById('preview-short');
                const previewPrice = document.getElementById('preview-price');
                const previewDuration = document.getElementById('preview-duration');
                const previewNote = document.getElementById('preview-note');
                const previewStatus = document.getElementById('preview-status');
                const shortDesc = document.getElementById('service-short-desc');
                const active = document.getElementById('service-active');
                if (previewCat && cat) {
                    const opt = cat.options[cat.selectedIndex];
                    previewCat.textContent = opt && opt.value ? opt.text : 'Danh mục';
                }
                if (previewName) previewName.textContent = nameInput?.value || 'Tên dịch vụ';
                if (previewShort && shortDesc) {
                    previewShort.textContent = shortDesc.value;
                    previewShort.classList.toggle('hidden', !shortDesc.value.trim());
                }
                const price = document.getElementById('service-price');
                if (previewPrice) previewPrice.textContent = price?.value || '—';
                const dur = document.getElementById('service-duration');
                if (previewDuration) previewDuration.textContent = dur?.value ? '⏱ ' + dur.value : '';
                const note = document.getElementById('service-price-note');
                if (previewNote && note) {
                    previewNote.textContent = note.value;
                    previewNote.classList.toggle('hidden', !note.value.trim());
                }
                if (previewStatus && active) previewStatus.classList.toggle('hidden', active.checked);
            }
            document.getElementById('service-item-form')?.addEventListener('input', updatePreview);
            document.getElementById('service-item-form')?.addEventListener('change', updatePreview);
            updatePreview();
        })();
    </script>
}
