@page "/admin/dich-vu/bang-gia/them"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.DichVu.BangGiaThemModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Thêm dịch vụ", "Nhập tên — bước tiếp theo là tải ảnh.")' />

<form method="post" class="admin-form-card" style="max-width: 36rem;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div>
    <div class="admin-form-stack">
        <div>
            <label asp-for="Input.Name" class="admin-label">Tên dịch vụ *</label>
            <input asp-for="Input.Name" class="admin-input" placeholder="Ví dụ: Bảo dưỡng định kỳ" />
            <span asp-validation-for="Input.Name" class="admin-validation"></span>
        </div>
        <div>
            <label asp-for="Input.ShortDescription" class="admin-label">Mô tả ngắn</label>
            <textarea asp-for="Input.ShortDescription" class="admin-input" rows="3"
                      placeholder="Một câu mô tả ngắn cho khách hàng"></textarea>
        </div>
    </div>
    <div class="admin-form-actions">
        <button type="submit" class="admin-btn admin-btn-primary">Tiếp tục — tải ảnh</button>
        <a href="/admin/dich-vu/bang-gia" class="admin-btn admin-btn-ghost">Hủy</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
