@page "/admin/dich-vu/bang-gia/sua/{id:guid}"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.DichVu.BangGiaSuaModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "Sửa dịch vụ",
             "Kéo ảnh vào khung — thứ tự ảnh = thứ tự trên trang dịch vụ.")' />

<div class="admin-form-card" style="max-width: 52rem;">
    <div id="service-cms"
         class="ms-root"
         data-service-cms
         data-api="/admin/api/dich-vu/@Model.ServiceId/media"
         data-upload-enabled="@Model.SupportsImageUpload.ToString().ToLowerInvariant()">
    </div>
</div>

<p class="mt-4">
    <a href="/admin/dich-vu/bang-gia" class="admin-btn admin-btn-ghost">← Danh sách dịch vụ</a>
</p>

@section Scripts {
    <script src="~/js/service-cms.js" asp-append-version="true"></script>
}
