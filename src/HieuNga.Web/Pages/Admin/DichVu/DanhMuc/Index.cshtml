@page "/admin/dich-vu/danh-muc"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.DichVu.DanhMucIndexModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Danh mục dịch vụ")' />

<div class="admin-grid-2">
    <div class="admin-card admin-card-padded">
        <h2 class="admin-form-section-title">@(Model.Input.Id.HasValue ? "Sửa danh mục" : "Thêm danh mục")</h2>
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Input.Id" />
            <div class="admin-form-stack">
                <div>
                    <label class="admin-label">Tên *</label>
                    <input asp-for="Input.Name" class="admin-input" />
                    <span asp-validation-for="Input.Name" class="admin-validation"></span>
                </div>
                <div>
                    <label class="admin-label">Slug</label>
                    <input asp-for="Input.Slug" class="admin-input" />
                    <span asp-validation-for="Input.Slug" class="admin-validation"></span>
                </div>
                <div>
                    <label class="admin-label">Mô tả</label>
                    <textarea asp-for="Input.Description" rows="2" class="admin-textarea"></textarea>
                </div>
                <div class="admin-grid-2">
                    <div>
                        <label class="admin-label">Thứ tự</label>
                        <input asp-for="Input.DisplayOrder" type="number" class="admin-input" />
                    </div>
                    <div style="display: flex; align-items: flex-end; padding-bottom: 0.25rem;">
                        <label class="admin-check"><input asp-for="Input.IsActive" type="checkbox" /> Kích hoạt</label>
                    </div>
                </div>
            </div>
            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
                @if (Model.Input.Id.HasValue)
                {
                    <a href="/admin/dich-vu/danh-muc" class="admin-btn admin-btn-ghost">Hủy sửa</a>
                }
            </div>
        </form>
    </div>

    <div class="admin-card admin-table-wrap">
        <div class="admin-table-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Slug</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td>
                                <p class="admin-table-primary">@c.Name @(!c.IsActive ? "(ẩn)" : "")</p>
                            </td>
                            <td>
                                <p class="admin-table-secondary">@c.Slug</p>
                            </td>
                            <td class="text-right">
                                <div class="admin-actions">
                                    <a href="/admin/dich-vu/danh-muc?editId=@c.Id" class="admin-action admin-action-edit">Sửa</a>
                                    <form method="post" asp-page-handler="Delete">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="admin-action admin-action-danger" onclick="return confirm('Xóa danh mục?')">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
