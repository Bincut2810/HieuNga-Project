@page "/admin/dich-vu/danh-muc"
@model HieuNga.Web.Pages.Admin.DichVu.DanhMucIndexModel

<h1 class="text-2xl font-bold">Danh mục dịch vụ</h1>

<div class="mt-8 grid lg:grid-cols-2 gap-8">
    <div class="bg-white border rounded-2xl p-6">
        <h2 class="font-semibold mb-4">@(Model.Input.Id.HasValue ? "Sửa danh mục" : "Thêm danh mục")</h2>
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Input.Id" />
            <div class="space-y-3">
                <div>
                    <label class="block text-sm font-medium mb-1">Tên *</label>
                    <input asp-for="Input.Name" class="w-full border rounded-lg px-3 py-2 text-sm" />
                    <span asp-validation-for="Input.Name" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Slug</label>
                    <input asp-for="Input.Slug" class="w-full border rounded-lg px-3 py-2 text-sm" />
                    <span asp-validation-for="Input.Slug" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Mô tả</label>
                    <textarea asp-for="Input.Description" rows="2" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium mb-1">Thứ tự</label>
                        <input asp-for="Input.DisplayOrder" type="number" class="w-full border rounded-lg px-3 py-2 text-sm" />
                    </div>
                    <div class="flex items-end pb-2">
                        <label class="flex items-center gap-2 text-sm"><input asp-for="Input.IsActive" type="checkbox" /> Kích hoạt</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="mt-4 bg-honda-red text-white px-4 py-2 rounded-lg font-semibold text-sm">Lưu</button>
            @if (Model.Input.Id.HasValue)
            {
                <a href="/admin/dich-vu/danh-muc" class="ml-2 text-sm text-gray-500">Hủy sửa</a>
            }
        </form>
    </div>

    <div class="bg-white border rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-500 text-left">
                <tr>
                    <th class="px-4 py-3">Tên</th>
                    <th class="px-4 py-3">Slug</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y">
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td class="px-4 py-3 font-medium">@c.Name @(!c.IsActive ? "(ẩn)" : "")</td>
                        <td class="px-4 py-3 text-gray-500">@c.Slug</td>
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                            <a href="/admin/dich-vu/danh-muc?editId=@c.Id" class="text-honda-red text-xs font-medium">Sửa</a>
                            <form method="post" asp-page-handler="Delete" class="inline ml-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="text-gray-400 text-xs" onclick="return confirm('Xóa danh mục?')">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
