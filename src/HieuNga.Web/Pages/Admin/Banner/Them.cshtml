@page "/admin/banner/them"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.BannerThemModel

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel("Thêm banner")' />

<form method="post" class="admin-form-card" style="max-width: 42rem;">
    @Html.AntiForgeryToken()
    <partial name="Admin/Shared/_BannerForm" model="Model.Input" />
    <div class="admin-form-actions">
        <button type="submit" class="admin-btn admin-btn-primary">Lưu</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
