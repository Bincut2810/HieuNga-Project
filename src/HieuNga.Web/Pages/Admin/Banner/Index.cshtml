@page "/admin/banner"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Banner.IndexModel
@{
    ViewData["Title"] = "Banner";
}

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "Banner",
             "Ảnh hero và CTA trên trang chủ.",
             "/admin/banner/them",
             "+ Thêm banner")' />

@if (Model.Items.Count == 0)
{
    <partial name="Admin/Shared/_AdminEmptyState"
             model='new AdminEmptyStateModel("Chưa có banner", "Thêm banner để hiển thị trên trang chủ.", "/admin/banner/them", "+ Thêm banner")' />
}
else
{
    <div class="admin-media-grid">
        @foreach (var b in Model.Items)
        {
            <div class="admin-media-card">
                <div class="admin-media-card-image">
                    <img src="@b.ImageUrl" alt="@b.Title" />
                </div>
                <div class="admin-media-card-body">
                    <div>
                        <h3 class="admin-media-card-title">@b.Title</h3>
                        @if (!string.IsNullOrEmpty(b.Subtitle))
                        {
                            <p class="admin-media-card-meta">@b.Subtitle</p>
                        }
                    </div>
                    <a href="/admin/banner/sua/@b.Id" class="admin-action admin-action-edit">Sửa</a>
                </div>
            </div>
        }
    </div>
}
