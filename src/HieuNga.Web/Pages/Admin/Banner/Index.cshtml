@page "/admin/banner"
@using HieuNga.Web.Pages.Admin.Extensions
@model HieuNga.Web.Pages.Admin.Banner.IndexModel
@{
    ViewData["Title"] = "Banner trang chủ";
}

<partial name="Admin/Shared/_AdminPageHeader"
         model='new AdminPageHeaderModel(
             "Banner trang chủ",
             "Kéo ảnh vào khung — thứ tự ảnh = thứ tự carousel. Lưu tiêu đề và bật xuất bản khi xong.")' />

<div class="admin-form-card" style="max-width: 52rem;">
    <div id="banner-cms"
         class="ms-root"
         data-banner-cms
         data-api="/admin/api/banner"
         data-upload-enabled="@Model.SupportsImageUpload.ToString().ToLowerInvariant()">
    </div>
</div>

@section Scripts {
    <script src="~/js/banner-cms.js" asp-append-version="true"></script>
}
