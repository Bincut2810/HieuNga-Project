@page "/tra-gop"
@model HieuNga.Web.Pages.TraGop.IndexModel
@using HieuNga.Web.Filters
@{
    var site = SiteSettingsViewData.Get(ViewData);
    ViewData["VehicleChangeUrl"] = "/xe?from=tra-gop";
    ViewData["VehicleFinanceUrl"] = "#inquiry";
    ViewData["CtaIntent"] = "tra-gop";
    ViewData["CtaXe"] = Model.SelectedMotorcycle?.Slug;
    ViewData["CtaSource"] = Model.LeadSource;
    ViewData["CtaShow"] = "consult,call,zalo";
    ViewData["CtaLayout"] = "row";
    ViewData["CtaConsultLabel"] = "Tư vấn trả góp";
}

<section class="lead-page">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 md:pt-10 pb-4">
        <nav class="text-sm text-gray-400 mb-4" aria-label="Breadcrumb">
            <a href="/" class="hover:text-honda-red transition focus-ring rounded">Trang chủ</a>
            <span class="mx-2" aria-hidden="true">/</span>
            <span class="text-honda-dark font-medium">Trả góp</span>
        </nav>
        <p class="section-eyebrow">Tài chính</p>
        <h1 class="section-title">Tính trả góp</h1>
        <p class="section-subtitle max-w-2xl">Ước tính khoản tháng — gửi yêu cầu tư vấn hồ sơ tại HEAD Đà Nẵng.</p>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
        <partial name="_UniversalCta" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
        @if (Model.InquirySuccess)
        {
            <partial name="_LeadSuccess" model='("Đã gửi yêu cầu trả góp!", "Chúng tôi đã nhận thông tin trả góp của bạn.", "Tư vấn viên sẽ gọi lại để chốt hồ sơ và ngân hàng phù hợp.")' />
        }
        else
        {
            @if (Model.SelectedMotorcycle is not null)
            {
                <div class="mb-8 max-w-3xl">
                    <partial name="_LeadVehicleCard" model="Model.SelectedMotorcycle" />
                </div>
            }

            <div class="grid lg:grid-cols-2 gap-10 items-start"
                 x-data="{
                    price: @Model.VehiclePrice,
                    down: @Model.DownPayment,
                    months: @Model.TermMonths
                 }">
                <div class="bg-white border border-gray-100 rounded-3xl p-6 md:p-8 shadow-sm space-y-8">
                    <div>
                        <div class="flex justify-between text-sm mb-2">
                            <label class="font-medium">Giá xe</label>
                            <span class="text-honda-red font-bold" x-text="new Intl.NumberFormat('vi-VN').format(price) + ' ₫'"></span>
                        </div>
                        <input type="range" x-model.number="price" min="20000000" max="150000000" step="1000000" class="w-full accent-[#E40521]" aria-label="Giá xe" />
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-2">
                            <label class="font-medium">Trả trước</label>
                            <span class="font-semibold" x-text="new Intl.NumberFormat('vi-VN').format(down) + ' ₫'"></span>
                        </div>
                        <input type="range" x-model.number="down" min="0" :max="price * 0.7" step="500000" class="w-full accent-[#E40521]" aria-label="Trả trước" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-3">Kỳ hạn</label>
                        <div class="flex flex-wrap gap-2" role="group" aria-label="Kỳ hạn">
                            <template x-for="t in [6,12,18,24,36]">
                                <button type="button" @@click="months = t"
                                        class="px-4 py-2 rounded-lg text-sm font-medium border transition"
                                        :class="months === t ? 'bg-honda-dark text-white border-honda-dark' : 'hover:border-honda-red'"
                                        x-text="t + ' tháng'"></button>
                            </template>
                        </div>
                    </div>
                    <form hx-post="/tra-gop?handler=Calculate" hx-target="#calc-result" hx-swap="innerHTML transition:true" hx-indicator="#calc-loading" class="space-y-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="VehiclePrice" :value="price" />
                        <input type="hidden" name="DownPayment" :value="down" />
                        <input type="hidden" name="TermMonths" :value="months" />
                        <button type="submit" class="btn-primary w-full touch-press justify-center">Tính khoản trả tháng</button>
                    </form>
                    <p class="text-xs text-gray-400">Kết quả mang tính tham khảo. Tư vấn viên báo chính xác tại showroom.</p>
                </div>

                <div class="relative min-h-[280px] space-y-6">
                    <div id="calc-loading" class="htmx-indicator absolute inset-0 z-10 flex items-center justify-center bg-white/70 backdrop-blur-sm rounded-3xl pointer-events-none">
                        <div class="w-10 h-10 border-2 border-gray-200 border-t-honda-red rounded-full animate-spin" aria-hidden="true"></div>
                    </div>
                    <div id="calc-result">
                        @if (Model.Result is not null)
                        {
                            <partial name="_CalculatorResult" model="Model.Result" />
                        }
                        else
                        {
                            <div class="bg-gray-50 border border-dashed border-gray-200 rounded-3xl p-12 text-center text-gray-400">
                                <p class="text-lg">Điều chỉnh thanh trượt và nhấn tính toán</p>
                                <p class="text-sm mt-2">Sau đó gửi yêu cầu tư vấn bên dưới</p>
                            </div>
                        }
                    </div>

                    <div id="inquiry" class="lead-form-card scroll-mt-24">
                        <h2 class="text-lg font-bold text-honda-dark">Gửi yêu cầu tư vấn trả góp</h2>
                        <p class="text-sm text-gray-500 mt-1">Để lại thông tin — nhận tư vấn hồ sơ &amp; ngân hàng</p>
                        <form method="post" asp-page-handler="Inquiry" class="mt-5 space-y-4">
                            <div asp-validation-summary="All" class="text-red-600 text-sm" role="alert"></div>
                            <input type="hidden" name="VehiclePrice" :value="price" />
                            <input type="hidden" name="DownPayment" :value="down" />
                            <input type="hidden" name="TermMonths" :value="months" />
                            <input type="hidden" asp-for="MotorcycleId" />
                            <input type="hidden" asp-for="SourceField" value="@Model.LeadSource" />
                            <input type="hidden" asp-for="XeSlugField" value="@(Model.SelectedMotorcycle?.Slug)" />

                            <div class="lead-confirm-card">
                                <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Tóm tắt ước tính</p>
                                <p class="mt-2 text-sm text-gray-600">
                                    Xe: <strong>@(Model.SelectedMotorcycle?.Name ?? "Theo mức giá bạn chọn")</strong><br />
                                    <span x-text="'Giá: ' + new Intl.NumberFormat('vi-VN').format(price) + ' ₫ · Trả trước: ' + new Intl.NumberFormat('vi-VN').format(down) + ' ₫ · ' + months + ' tháng'"></span>
                                </p>
                            </div>

                            <div class="grid sm:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="CustomerName" class="block text-sm font-medium mb-1">Họ tên *</label>
                                    <input asp-for="CustomerName" class="lead-input" required autocomplete="name" />
                                </div>
                                <div>
                                    <label asp-for="Phone" class="block text-sm font-medium mb-1">Số điện thoại *</label>
                                    <input asp-for="Phone" class="lead-input" required autocomplete="tel" inputmode="tel" />
                                </div>
                            </div>
                            <div>
                                <label asp-for="Email" class="block text-sm font-medium mb-1">Email</label>
                                <input asp-for="Email" type="email" class="lead-input" autocomplete="email" />
                            </div>
                            <div>
                                <label asp-for="InquiryNotes" class="block text-sm font-medium mb-1">Ghi chú</label>
                                <textarea asp-for="InquiryNotes" rows="3" class="lead-input" placeholder="VD: Muốn vay HD Bank, trả trước 30%…"></textarea>
                            </div>
                            <p class="text-xs text-gray-400">Thông tin bảo mật — chỉ dùng để tư vấn trả góp tại @site.SiteName.</p>
                            <button type="submit" class="btn-primary w-full touch-press justify-center">Gửi yêu cầu trả góp</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="mt-14 grid md:grid-cols-3 gap-6 text-center">
                <div class="p-6 rounded-2xl bg-white border border-gray-100"><p class="font-bold mt-1">Duyệt nhanh</p><p class="text-xs text-gray-500 mt-1">Trong ngày làm việc</p></div>
                <div class="p-6 rounded-2xl bg-white border border-gray-100"><p class="font-bold mt-1">Thủ tục gọn</p><p class="text-xs text-gray-500 mt-1">Hỗ trợ hồ sơ tại showroom</p></div>
                <div class="p-6 rounded-2xl bg-white border border-gray-100"><p class="font-bold mt-1">Đối tác uy tín</p><p class="text-xs text-gray-500 mt-1">Nhiều ngân hàng liên kết</p></div>
            </div>
        }
    </div>
</section>

@if (!Model.InquirySuccess)
{
    <partial name="_CtaBanner" />
}
