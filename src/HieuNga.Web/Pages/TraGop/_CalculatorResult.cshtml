@model InstallmentCalculationDto
@using HieuNga.Web.Filters
@{
    var site = SiteSettingsViewData.Get(ViewData);
    var telHref = SiteSettingsViewData.TelHref(site);
    var xe = ViewData["CtaXe"] as string;
    var consultUrl = string.IsNullOrWhiteSpace(xe)
        ? "/lien-he?intent=tra-gop&source=finance"
        : $"/lien-he?intent=tra-gop&xe={Uri.EscapeDataString(xe)}&source=finance";
}
<div class="bg-honda-dark text-white rounded-2xl p-8 calc-result-enter">
    <p class="text-gray-400 text-sm">Trả hàng tháng (ước tính)</p>
    <p class="text-4xl font-bold text-honda-red mt-2">@Model.MonthlyPayment.ToVnd()</p>
    <div class="grid grid-cols-2 gap-4 mt-6 text-sm">
        <div><span class="text-gray-400">Tổng thanh toán</span><p class="font-semibold mt-1">@Model.TotalPayment.ToVnd()</p></div>
        <div><span class="text-gray-400">Kỳ hạn</span><p class="font-semibold mt-1">@Model.TermMonths tháng</p></div>
    </div>
    <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="#inquiry" class="btn-primary inline-flex justify-center touch-press">Đăng ký tư vấn trả góp</a>
        <a href="@consultUrl" class="btn-secondary !border-white/30 !text-white hover:!bg-white hover:!text-honda-dark inline-flex justify-center touch-press">Form liên hệ</a>
        <a href="@telHref" hx-boost="false" class="inline-flex items-center justify-center px-4 py-3 text-sm font-semibold border border-white/25 rounded-lg hover:bg-white/10 transition">Gọi @site.Hotline</a>
    </div>
</div>
