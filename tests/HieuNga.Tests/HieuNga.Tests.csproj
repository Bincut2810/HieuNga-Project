<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HieuNga.Application\HieuNga.Application.csproj" />
    <ProjectReference Include="..\..\src\HieuNga.Domain\HieuNga.Domain.csproj" />
    <ProjectReference Include="..\..\src\HieuNga.Infrastructure\HieuNga.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\HieuNga.Web\HieuNga.Web.csproj" />
  </ItemGroup>

  <!--
    BindPropertyPrefixTests.cs references ASP.NET Core MVC internal types
    (Microsoft.AspNetCore.Mvc.Internal.IObjectModelValidator /
    DefaultObjectValidator) that were removed/relocated in .NET 8, so the
    file no longer compiles. The file is preserved on disk for reference /
    future restore; excluded from the build so it doesn't break the rest of
    the suite. The new behavior is covered by
    EditorModelStateIsolationTests.cs.
  -->
  <ItemGroup>
    <Compile Remove="BindPropertyPrefixTests.cs" />
  </ItemGroup>

</Project>
