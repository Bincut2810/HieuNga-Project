# Honda Hiếu Nga — environment template (copy to .env, never commit .env)
# ASP.NET Core: double underscore __ = nested config key

# ── Runtime ──────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
# Render injects PORT automatically — app binds 0.0.0.0:PORT

# ── Database ─────────────────────────────────────────────────────────────────
# Local Docker (docker compose postgres on port 5433):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=hieunga;Username=hieunga;Password=YOUR_LOCAL_DEV_PASSWORD
# Staging/Production (Render or Neon) — add SSL:
# ConnectionStrings__DefaultConnection=Host=YOUR_HOST;Port=5432;Database=hieunga;Username=hieunga;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# ── Site (SEO & contact) ─────────────────────────────────────────────────────
Site__Name=Xe Máy Hiếu Nga
Site__BaseUrl=http://localhost:5000
Site__Hotline=0236 384 9556
Site__ZaloUrl=https://zalo.me/02363849556
Site__DefaultSeoTitle=Xe Máy Hiếu Nga | Mua xe và dịch vụ xe máy
Site__DefaultSeoDescription=Mua xe máy, tư vấn trả góp và đặt lịch sửa chữa, bảo dưỡng tại Đà Nẵng.

# ── Admin seed (first deploy only) ───────────────────────────────────────────
# Development: defaults in appsettings.Development.json
# Staging/Production: set all three before first deploy, then disable AdminSeed after login works
SeedOptions__AdminSeedEnabled=false
SeedOptions__AdminEmail=admin@example.local
SeedOptions__AdminPassword=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
# Aliases (optional): AdminSeed__Enabled, AdminSeed__Email, AdminSeed__Password

# ── Image storage ────────────────────────────────────────────────────────────
# Local = wwwroot/uploads (dev only; lost on container restart)
# Cloudinary = persistent uploads on staging/production
ImageStorage__Provider=Local
ImageStorage__MaxFileSizeMb=5
ImageStorage__Cloudinary__CloudName=your_cloud_name
ImageStorage__Cloudinary__ApiKey=your_api_key
ImageStorage__Cloudinary__ApiSecret=your_api_secret
